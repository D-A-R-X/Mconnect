<?xml version="1.0" encoding="utf-8"?>
<!-- My Tasks filter chips: blue when selected, white when not — so the
     unselected pills stand out on the grey content sheet (like the design).
     Kept separate from chip_filter_bg so the Expenses page is unaffected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/category_labour" />
    <item android:color="#FFFFFF" />
</selector>
