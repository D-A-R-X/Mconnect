<?xml version="1.0" encoding="utf-8"?>
<!-- Clock-out badge. Figma node 420:52704 / 420:52618 — blue gradient
     #0b61ca → #02499d, top to bottom, 16dp corners. Used only by the
     two clock-out dialogs (confirm + success); the clock-in dialogs
     use their own badge drawable, so this stays blue per the
     attendance clock-out design. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0B61CA"
        android:endColor="#02499D"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#0B61CA" />
    <corners android:radius="16dp" />
</shape>
