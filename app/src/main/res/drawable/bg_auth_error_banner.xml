<?xml version="1.0" encoding="utf-8"?>
<!-- Soft red alert card for auth errors: tinted fill + hairline border so the
     message reads as a deliberate alert instead of loose red text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FEF3F2" />
    <stroke
        android:width="1dp"
        android:color="#FECDCA" />
    <corners android:radius="12dp" />
</shape>
