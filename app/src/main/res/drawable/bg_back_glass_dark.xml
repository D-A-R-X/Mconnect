<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass back chip for dark / coloured headers: translucent white
     fill with a brighter top-left highlight and a light glass rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#1FFFFFFF"
                android:startColor="#4DFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>
    <!-- soft specular highlight on the upper half -->
    <item android:bottom="14dp" android:left="5dp" android:right="5dp" android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
