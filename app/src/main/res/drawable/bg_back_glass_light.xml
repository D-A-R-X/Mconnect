<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass back chip for light screens: milky translucent fill tinted
     toward the brand blue, with a faint blue rim so it stays visible on white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#B3EAF0FF"
                android:startColor="#E6F7F9FF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#260B61CA" />
        </shape>
    </item>
    <item android:bottom="14dp" android:left="5dp" android:right="5dp" android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
