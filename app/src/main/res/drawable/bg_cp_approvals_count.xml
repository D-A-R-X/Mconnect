<?xml version="1.0" encoding="utf-8"?>
<!--
  Pending-count badge on the CP Approvals library row. Amber to match the
  approvals banner inside CP Visits and the row's own icon.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FEF0C7" />
    <stroke
        android:width="1dp"
        android:color="#FEC84B" />
    <corners android:radius="10dp" />
</shape>
