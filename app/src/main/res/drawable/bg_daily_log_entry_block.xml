<?xml version="1.0" encoding="utf-8"?>
<!--
  One daily-log entry inside a project card. Tinted a step off the card's white
  and rounded, so several entries in an expanded project read as distinct
  records instead of one continuous column of text.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F8F9FC" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#EEF0F4" />
</shape>
