<!--
  Rounded-square container for the wallet icon on each expense card.
  The reference uses a square with 12dp corner radius (not a perfect
  circle) so the icon visually pairs with the category color while
  staying distinct from avatar circles elsewhere in the app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2563EB" />
    <corners android:radius="12dp" />
</shape>
