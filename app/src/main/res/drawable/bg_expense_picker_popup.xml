<!--
  Dropdown popup background for the project picker. White card with a
  10dp corner radius and a subtle 1dp grey border so it reads as a
  surface lifted off the page without needing heavy elevation.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#E4E7EC" />
    <corners android:radius="10dp" />
</shape>
