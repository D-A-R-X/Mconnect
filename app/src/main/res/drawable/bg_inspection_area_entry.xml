<!-- Dashed-border card that wraps each added entry (e.g. School Name +
     Distance + delete button) on the Area tab. Matches the reference's
     blue dashed outline framing each entry group. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F4F8FE" />
    <stroke
        android:width="1dp"
        android:color="#0B61CA"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="10dp" />
</shape>
