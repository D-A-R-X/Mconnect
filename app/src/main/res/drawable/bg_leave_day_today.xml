<?xml version="1.0" encoding="utf-8"?>
<!-- Today marker in the leave calendar: an accent ring, so today reads as
     "here" without looking selected (selected is a solid fill). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="#0B61CA" />
</shape>
