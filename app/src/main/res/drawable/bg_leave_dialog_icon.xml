<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded blue badge that hosts the stacked-layers glyph at the top of
  the Submit Leave / Leave Submitted dialogs. Matches the design's deep
  royal-blue tile.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2563EB"
        android:endColor="#1D4ED8"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
