<?xml version="1.0" encoding="utf-8"?>
<!--
  Active filled Submit Now button — saturated brand purple gradient.
  The earlier #BCA6F7 → #A488F2 read as a disabled/inactive lavender;
  the new #7C5CFA → #5E3DEB gives a clearly tappable, active feel
  that matches the rest of the leave/permission flow chrome.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#7C5CFA"
        android:endColor="#5E3DEB" />
    <corners android:radius="20dp" />
</shape>
