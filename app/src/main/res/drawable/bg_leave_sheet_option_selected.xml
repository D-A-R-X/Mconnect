<?xml version="1.0" encoding="utf-8"?>
<!--
  Selected-row background in the Leave Category bottom sheet. Mirrors the
  design's tinted-blue highlight that signals which radio option is
  currently picked.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EAF1FE" />
    <stroke
        android:width="1dp"
        android:color="#1D4ED8" />
    <corners android:radius="12dp" />
</shape>
