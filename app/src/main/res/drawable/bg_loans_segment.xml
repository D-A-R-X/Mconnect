<?xml version="1.0" encoding="utf-8"?>
<!--
  Track / container behind the Loans / Advance segmented control.
  Matches the iOS reference: subtle warm-gray fill so the blue active
  pill reads as floating; sits inside the white card so the contrast
  is small but visible (about a 2% darkening of the card).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2F4F7" />
    <corners android:radius="10dp" />
</shape>
