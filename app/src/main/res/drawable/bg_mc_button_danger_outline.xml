<?xml version="1.0" encoding="utf-8"?>
<!-- Mconnect button component (danger outline). Pairs with @style/Widget.Mconnect.Button.Danger.Outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorErrorLight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/colorError" />
            <corners android:radius="@dimen/button_corner" />
        </shape>
    </item>
</ripple>
