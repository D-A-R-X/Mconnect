<?xml version="1.0" encoding="utf-8"?>
<!-- Mconnect button component (secondary, outline). Pairs with @style/Widget.Mconnect.Button.Secondary. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorBorderLight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/colorBorder" />
            <corners android:radius="@dimen/button_corner" />
        </shape>
    </item>
</ripple>
