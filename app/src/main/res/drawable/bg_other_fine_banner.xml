<?xml version="1.0" encoding="utf-8"?>
<!--
  Blue companion to bg_fines_banner.xml. Used by the Attendance History
  card to render HR-logged "Other Fine" rows (loss-of-property,
  indiscipline, etc.) below the red late-fine banner so the staff can
  tell a punctuality penalty apart from a manual HR deduction at a
  glance. Stroke + fill use the same blue tokens the loan-active pill
  + chat info bubbles already use across the app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke android:width="1dp" android:color="#0B61CA" />
    <solid android:color="#EFF6FF" />
    <corners android:radius="4dp" />
</shape>
