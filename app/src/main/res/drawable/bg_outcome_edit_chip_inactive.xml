<?xml version="1.0" encoding="utf-8"?>
<!--
  "Edit" pill — INACTIVE state. White fill with green outline.
  Default state after the client form is prefilled from a phone
  lookup: form fields are locked, and tapping this pill toggles
  the active state to unlock them for editing.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#2DAE12" />
    <corners android:radius="18dp" />
</shape>
