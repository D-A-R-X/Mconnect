<?xml version="1.0" encoding="utf-8"?>
<!-- Active segmented control button (e.g. "Own Vehicle" once picked) —
     brand-blue vertical gradient, fully rounded pill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0B61CA"
        android:endColor="#02499D"
        android:type="linear" />
    <corners android:radius="10dp" />
</shape>
