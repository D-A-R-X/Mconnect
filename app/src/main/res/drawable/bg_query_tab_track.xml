<!-- Outer segmented-control track for the Queries page tab row.
     White pill with a faint blue outline; the active segment renders
     a solid blue pill on top via bg_inspection_chip_active. Matches
     the reference design (366 × 36 hug, fully rounded). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#DBE3F1" />
    <corners android:radius="999dp" />
</shape>
