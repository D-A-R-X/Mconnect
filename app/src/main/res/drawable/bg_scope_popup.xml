<?xml version="1.0" encoding="utf-8"?>
<!--
  White rounded card for the scope dropdown popup. Border + tight radius
  matches the design's quiet card with light gray edge, and pairs with
  the PopupWindow's elevation in code to give a subtle drop shadow.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorBorder" />
    <corners android:radius="12dp" />
</shape>
