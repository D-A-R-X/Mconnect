<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact white card for the scope dropdown popup.
  Figma: white fill, 8dp radius, subtle drop shadow
  (applied via PopupWindow elevation in code).
  No border stroke — shadow alone provides the edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="8dp" />
</shape>
