<?xml version="1.0" encoding="utf-8"?>
<!--
  Subtle gradient divider between scope popup items.
  Figma: 1px height, white -> #A3A3A3 -> white with 15% opacity.
  Since Android doesn't support opacity on gradient stops easily,
  we use a light gray center that fades to transparent at the edges,
  achieving the same quiet separator effect.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#00A3A3A3"
        android:centerColor="#26A3A3A3"
        android:endColor="#00A3A3A3"
        android:angle="0" />
    <size android:height="1dp" />
</shape>
