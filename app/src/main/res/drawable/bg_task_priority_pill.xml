<?xml version="1.0" encoding="utf-8"?>
<!--
  Stadium "pill" shape for the task priority badges (High / Medium /
  Low / etc.). The previous bg_home_status_dot used <shape="oval"> which
  stretches into an ellipse for non-square text — making the badges
  look egg-shaped. This is a rectangle with a corner radius larger than
  any reasonable badge height, so both ends always render as
  semicircles regardless of label length.

  The colour is set via android:backgroundTint at the use site so the
  same drawable can serve red/orange/green priority variants.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="999dp" />
</shape>
