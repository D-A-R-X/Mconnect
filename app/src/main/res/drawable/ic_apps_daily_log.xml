<?xml version="1.0" encoding="utf-8"?>
<!-- Daily Log row icon for the Project Management card. Matches the
     Tasks/Issues/Expenses row family: light-green circle with a green
     stroked glyph (clipboard-check), instead of a dark tinted glyph. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <!-- Light green circle background -->
    <path
        android:fillColor="#E9F9EF"
        android:pathData="M20,0 A20,20 0 1,1 19.99,0 Z" />

    <!-- Clipboard-check glyph (24u grid, centred) -->
    <group
        android:translateX="8"
        android:translateY="8">
        <path
            android:strokeColor="#16A34A"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2H6a2 2 0 0 1 -2 -2V6a2 2 0 0 1 2 -2h2" />
        <path
            android:strokeColor="#16A34A"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M8 4a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2H8V4z" />
        <path
            android:strokeColor="#16A34A"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M9 14l2 2l4 -4" />
    </group>
</vector>
