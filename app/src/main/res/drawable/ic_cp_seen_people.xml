<?xml version="1.0" encoding="utf-8"?>
<!--
  Person silhouette + verification badge for the "Have you seen the
  client?" floating chip. Re-tuned so the badge actually reads at the
  size the chip ships at (~64dp container, ~40dp glyph):

   • Person head + shoulders fill the upper-left two thirds of the canvas
   • White verification badge sits at the bottom-right with a clear ring
     cut into the person silhouette (no-overlap look from the Pencil ref)
   • Brand-blue tick inside the badge, thicker stroke so it survives
     downscaling
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Carve a transparent "halo" out of the person silhouette where the
         badge will sit. Achieved with evenOdd fill — the outer rect path
         gets reversed by the inner circle, leaving the silhouette plus
         a transparent gap around the badge. -->

    <!-- Head -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,40 m-13,0 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0 Z" />

    <!-- Shoulders / torso (rounded trapezoid) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,80 C22,68 32,58 45,58 C58,58 68,68 68,80 L68,82 C68,84 66,86 64,86 L26,86 C24,86 22,84 22,82 Z" />

    <!-- Halo: cut a small darker ring behind the badge so the white
         badge stands out from the white silhouette. -->
    <path
        android:fillColor="#0B61CA"
        android:pathData="M74,74 m-15,0 a15,15 0 1,1 30,0 a15,15 0 1,1 -30,0 Z" />

    <!-- White verification badge -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M74,74 m-12,0 a12,12 0 1,1 24,0 a12,12 0 1,1 -24,0 Z" />

    <!-- Brand-blue tick -->
    <path
        android:strokeColor="#0B61CA"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M67.5,74.5 L72,79 L80,70.5" />
</vector>
