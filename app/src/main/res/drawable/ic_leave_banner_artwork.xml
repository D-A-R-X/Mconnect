<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained leave banner illustration. Replaces the
  `leavebannergroup` + `leave_banner_suitcase` PNG composite that was
  positioned with a hardcoded marginStart and consequently slid off-screen
  on narrow phones. Single vector means predictable rendering across all
  densities and screen widths.

  Composition (left → right):
    • Sparkles / stars on the left
    • Teal-blue trolley suitcase
    • Leave document card overlapping the suitcase (white with rainbow
      bar, three text-stub lines, and a green check)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp"
    android:height="120dp"
    android:viewportWidth="180"
    android:viewportHeight="120">

    <!-- Sparkle / star — top-left small -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M14,42 L16,46 L20,48 L16,50 L14,54 L12,50 L8,48 L12,46 z" />
    <!-- Sparkle / star — mid-left tiny -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.65"
        android:pathData="M30,72 L31,74 L33,75 L31,76 L30,78 L29,76 L27,75 L29,74 z" />
    <!-- Sparkle / star — top-mid -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.7"
        android:pathData="M48,26 L49.5,29 L52.5,30.5 L49.5,32 L48,35 L46.5,32 L43.5,30.5 L46.5,29 z" />

    <!-- Suitcase telescoping handle -->
    <path
        android:fillColor="#1E3A8A"
        android:pathData="M70,46 L70,38 Q70,34 74,34 L96,34 Q100,34 100,38 L100,46 L96,46 L96,40 L74,40 L74,46 z" />
    <!-- Suitcase top trim (lighter teal) -->
