    <path
        android:fillColor="#1E293B"
        android:pathData="M104,46 L138,46 L138,50 L104,50 z" />
    <!-- Document body lines -->
    <path
        android:fillColor="#CBD5E1"
        android:pathData="M104,58 L158,58 L158,61 L104,61 z" />
    <path
        android:fillColor="#CBD5E1"
        android:pathData="M104,66 L150,66 L150,69 L104,69 z" />
    <path
        android:fillColor="#CBD5E1"
        android:pathData="M104,74 L155,74 L155,77 L104,77 z" />
