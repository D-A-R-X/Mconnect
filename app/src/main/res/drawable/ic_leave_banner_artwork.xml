        android:pathData="M60,72 L110,72 L110,82 L60,82 z" />
    <!-- Suitcase corner highlight -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.18"
        android:pathData="M64,60 L70,60 L70,98 L64,98 z" />

    <!-- Leave document card — white background, sits on top of right
         half of the suitcase per the design composition -->
