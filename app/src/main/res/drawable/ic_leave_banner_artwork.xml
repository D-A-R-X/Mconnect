    <path
        android:fillColor="#3B82F6"
        android:pathData="M102,30 L120,30 L120,36 L102,36 z" />
    <path
        android:fillColor="#F59E0B"
        android:pathData="M120,30 L138,30 L138,36 L120,36 z" />
    <path
        android:fillColor="#EF4444"
        android:pathData="M138,30 L160,30 L160,34 Q160,36 158,36 L138,36 z" />
