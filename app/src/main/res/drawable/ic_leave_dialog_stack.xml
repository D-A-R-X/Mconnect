    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,17.5l-9,-4.5l2.25,-1.125l6.75,3.375l6.75,-3.375l2.25,1.125z" />
    <!-- Middle layer -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M12,14l-9,-4.5l2.25,-1.125l6.75,3.375l6.75,-3.375l2.25,1.125z" />
    <!-- Top layer -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,4l9,4.5l-9,4.5l-9,-4.5z" />
</vector>
