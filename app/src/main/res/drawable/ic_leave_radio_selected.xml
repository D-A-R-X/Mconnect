<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="16dp"
                android:height="16dp" />
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#7A5AF8" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="8dp"
        android:height="8dp">
        <shape android:shape="oval">
            <solid android:color="#7A5AF8" />
        </shape>
    </item>
</layer-list>
