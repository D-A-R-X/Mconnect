<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">
    
    <!-- Receipt Page Outline (Blue Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5.5,2 h9 c0.8,0 1.5,0.7 1.5,1.5 v13 l-1.5,-1 l-1.5,1 l-1.5,-1 l-1.5,1 l-1.5,-1 l-1.5,1 l-1.5,-1 l-1.5,1 v-13 c0,-0.8 0.7,-1.5 1.5,-1.5 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="2"
                android:endX="10"
                android:endY="17">
                <item android:offset="0.0" android:color="#0B61CA" />
                <item android:offset="1.0" android:color="#02499D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Two Horizontal Dashes (Green Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7,6.5 h6 M7,10 h6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="6.5"
                android:endX="10"
                android:endY="10">
                <item android:offset="0.0" android:color="#1BCA0B" />
                <item android:offset="1.0" android:color="#3D9D02" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
