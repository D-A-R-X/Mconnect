<?xml version="1.0" encoding="utf-8"?>
<!--
  Blue rounded square with two green horizontal bars inside.
  Used for document / interest type fields in loan / advance forms.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">
    <!-- Rounded Square Outline (Blue Gradient) -->
    <path
        android:pathData="M 7,3 H 13 C 15.2,3 17,4.8 17,7 V 13 C 17,15.2 15.2,17 13,17 H 7 C 4.8,17 3,15.2 3,13 V 7 C 3,4.8 4.8,3 7,3 Z"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="3"
                android:endX="10"
                android:endY="17">
                <item android:offset="0.0" android:color="#0B61CA" />
                <item android:offset="1.0" android:color="#02499D" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Equal Bars Inside (Green Gradient) -->
    <path
        android:pathData="M 7,8.5 H 13 M 7,11.5 H 13"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="8.5"
                android:endX="10"
                android:endY="11.5">
                <item android:offset="0.0" android:color="#1BCA0B" />
                <item android:offset="1.0" android:color="#3D9D02" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
