<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="20"
    android:viewportHeight="20">
    
    <!-- Card Base Outline (Blue Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3.5,4 h11 c1.1,0 2,0.9 2,2 v7 c0,1.1 -0.9,2 -2,2 h-11 c-1.1,0 -2,-0.9 -2,-2 v-7 c0,-1.1 0.9,-2 2,-2 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="9"
                android:startY="4"
                android:endX="9"
                android:endY="15">
                <item android:offset="0.0" android:color="#0B61CA" />
                <item android:offset="1.0" android:color="#02499D" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Magnetic Stripe (Blue Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M1.5,7 h15">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="9"
                android:startY="7"
                android:endX="9"
                android:endY="7">
                <item android:offset="0.0" android:color="#0B61CA" />
                <item android:offset="1.0" android:color="#02499D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White Solid Circle Mask (so card lines don't show through) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15.5,13.5 m-4.5,0 a4.5,4.5 0 1,1 9,0 a4.5,4.5 0 1,1 -9,0" />

    <!-- Green Circle Outline (Green Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M15.5,13.5 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="15.5"
                android:startY="10"
                android:endX="15.5"
                android:endY="17">
                <item android:offset="0.0" android:color="#1BCA0B" />
                <item android:offset="1.0" android:color="#3D9D02" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Green Checkmark (Green Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M14,13.5 l1,1 l2.2,-2.2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="15"
                android:startY="12"
                android:endX="15"
                android:endY="15">
                <item android:offset="0.0" android:color="#1BCA0B" />
                <item android:offset="1.0" android:color="#3D9D02" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
