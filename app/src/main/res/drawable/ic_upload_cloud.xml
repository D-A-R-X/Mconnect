<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    
    <!-- Photo Frame Outline (Blue Gradient) - aligned to fit the 24x24 viewport better -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5,7 h12 c1.1,0 2,0.9 2,2 v10 c0,1.1 -0.9,2 -2,2 h-12 c-1.1,0 -2,-0.9 -2,-2 v-10 c0,-1.1 0.9,-2 2,-2 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="11"
                android:startY="7"
                android:endX="11"
                android:endY="21">
                <item android:offset="0.0" android:color="#0B61CA" />
                <item android:offset="1.0" android:color="#02499D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Continuous Mountain Wave inside Frame (Blue Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,18 c2,-2 4,-3 6,-1 c2,2 4,2 6,-1 c1.5,-2.25 3,-2.25 4,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="11"
                android:startY="14"
                android:endX="11"
                android:endY="19">
                <item android:offset="0.0" android:color="#0B61CA" />
                <item android:offset="1.0" android:color="#02499D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sun - Green Circle (Green Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7,11 m-1.5,0 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="7"
                android:startY="9.5"
                android:endX="7"
                android:endY="12.5">
                <item android:offset="0.0" android:color="#1BCA0B" />
                <item android:offset="1.0" android:color="#3D9D02" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Up Arrow Shaft (Green Gradient) - overlapping top-right of the photo frame -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M18,9.5 v-6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="3.5"
                android:endX="18"
                android:endY="9.5">
                <item android:offset="0.0" android:color="#1BCA0B" />
                <item android:offset="1.0" android:color="#3D9D02" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Up Arrow Head (Green Gradient) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M15.5,6 l2.5,-2.5 l2.5,2.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="3.5"
                android:endX="18"
                android:endY="6">
                <item android:offset="0.0" android:color="#1BCA0B" />
                <item android:offset="1.0" android:color="#3D9D02" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
