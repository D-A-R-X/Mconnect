<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF" />

    <!-- Content area: fragment fills below status bar; tab bar overlays at bottom -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F1F3F8" />

        <!-- Fade/blur overlay behind bottom navigation bar -->
        <View
            android:id="@+id/bottomNavFadeOverlay"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_nav_fade_grey"
            android:clickable="false"
            android:focusable="false" />

        <!-- Floating pill bottom nav. Transparent background so the
             scrolling page content (the panel grey, or the cards
             themselves) shows through behind the pill's side / top
             margins. The pill itself carries its own white rounded
             background, so it still reads as floating. -->
        <FrameLayout
            android:id="@+id/tabBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/tabBarStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

        <!-- Wide, flat pending-tasks bar tucked BEHIND the nav pill so only the
             top peeks out (bottom edge hidden). Side margins land just inside
             the nav's rounded ends so the edges reach the curve. Count on the
             left + a small Complete chip that routes the newest task.
             Persistent — only hides when nothing is pending; not dismissable. -->
        <LinearLayout
            android:id="@+id/navTasksBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"
            android:layout_marginBottom="-26dp"
            android:background="@drawable/bg_nav_tasks_banner"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNavTasksCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:text="3 pending"
                android:textColor="#B42318"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnNavTasksComplete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_tasks_complete"
                android:fontFamily="@font/inter_bold"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="Complete"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_tab_bar"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- HOME tab -->
            <FrameLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Home" />

                    <View
                        android:id="@+id/tabHomeIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabHomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Home"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ATTENDANCE tab -->
            <FrameLayout
                android:id="@+id/tabHr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabHrIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Attendance" />

                    <View
                        android:id="@+id/tabHrIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabHrText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Attendance"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- CHAT tab -->
            <FrameLayout
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabChatIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Chat" />

                    <View
                        android:id="@+id/tabChatIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabChatText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Chat"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- APPS tab -->
            <FrameLayout
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabProfileIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Apps" />

                    <View
                        android:id="@+id/tabProfileIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabProfileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Apps"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
