<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEEF3"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FEFEFE" />

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#ECEEF3"
        android:layout_weight="1" />

    <!-- Bottom tab bar (pill style from design) -->
    <FrameLayout
        android:id="@+id/tabBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C2020"
        android:paddingHorizontal="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/bg_tab_bar"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="4dp">

            <!-- HOME tab -->
            <FrameLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Home" />

                    <View
                        android:id="@+id/tabHomeIndicator"
                        android:layout_width="12dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tab_indicator_active" />

                    <TextView
                        android:id="@+id/tabHomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.05"
                        android:text="HOME"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- HR tab -->
            <FrameLayout
                android:id="@+id/tabHr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabHrIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="HR" />

                    <View
                        android:id="@+id/tabHrIndicator"
                        android:layout_width="12dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tab_indicator_active" />

                    <TextView
                        android:id="@+id/tabHrText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.05"
                        android:text="HR"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabChatIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Chat" />

                    <View
                        android:id="@+id/tabChatIndicator"
                        android:layout_width="12dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tab_indicator_active" />

                    <TextView
                        android:id="@+id/tabChatText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.05"
                        android:text="CHAT"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- PROFILE tab -->
            <FrameLayout
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabProfileIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Profile" />

                    <View
                        android:id="@+id/tabProfileIndicator"
                        android:layout_width="12dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tab_indicator_active" />

                    <TextView
                        android:id="@+id/tabProfileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.05"
                        android:text="PROFILE"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
