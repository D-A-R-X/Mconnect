<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF" />

    <!-- Content area: fragment fills below status bar; tab bar overlays at bottom -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Hosts the root-tab fragments AND owns the horizontal swipe that
             pages between them. Same panel grey as mainRoot, so the strip
             revealed while the page is dragged is seamless. -->
        <com.manjugroups.m_connect.ui.custom.SwipePagerLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F1F3F8" />

        <!-- Fade/blur overlay behind bottom navigation bar -->
        <View
            android:id="@+id/bottomNavFadeOverlay"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_nav_fade_grey"
            android:clickable="false"
            android:focusable="false" />

        <!-- Solid fill behind the (transparent) system nav bar so scrolling
             page content — cards, tab icons — can't show through the gap under
             the nav buttons. Height is set to the nav-bar inset at runtime,
             mirroring statusBarBackground at the top. -->
        <View
            android:id="@+id/navBarBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="#F1F3F8"
            android:clickable="false"
            android:focusable="false" />

        <!-- Floating pill bottom nav. Transparent background so the
             scrolling page content (the panel grey, or the cards
             themselves) shows through behind the pill's side / top
             margins. The pill itself carries its own white rounded
             background, so it still reads as floating. -->
        <FrameLayout
            android:id="@+id/tabBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/tabBarStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

        <!-- Collapsed nudge: slim tab peeking from behind the nav pill while
             tasks are pending and the card overlay is closed. Tapping it
             reopens the task cards; only the top ~26dp is visible (the rest
             tucks behind the pill via the negative bottom margin). -->
        <LinearLayout
            android:id="@+id/navTasksPeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"
            android:layout_marginBottom="-26dp"
            android:background="@drawable/bg_task_nudge_peek"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivNavTasksPeekChevron"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Show pending tasks"
                android:rotation="90"
                android:src="@drawable/ic_calendar_chevron_left"
                android:tint="#B42318" />

            <TextView
                android:id="@+id/tvNavTasksPeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="3 pending"
                android:textColor="#B42318"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- iOS Liquid Glass BlurView wrapper for the pill. 
             Provides true backdrop blur. -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/tabBarBlurView"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="32dp"
            android:elevation="0dp">
            
            <com.manjugroups.m_connect.ui.custom.GlassNavBar
                android:id="@+id/tabBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- HOME tab -->
                <FrameLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/tabHomeIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Home" />

                        <View
                            android:id="@+id/tabHomeIndicator"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tabHomeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:includeFontPadding="false"
                            android:text="Home"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ATTENDANCE tab -->
                <FrameLayout
                    android:id="@+id/tabHr"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/tabHrIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Attendance" />

                        <View
                            android:id="@+id/tabHrIndicator"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tabHrText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:includeFontPadding="false"
                            android:text="Attendance"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- CHAT tab -->
                <FrameLayout
                    android:id="@+id/tabChat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/tabChatIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Chat" />

                        <View
                            android:id="@+id/tabChatIndicator"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tabChatText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:includeFontPadding="false"
                            android:text="Chat"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- APPS tab -->
                <FrameLayout
                    android:id="@+id/tabProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/tabProfileIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Apps" />

                        <View
                            android:id="@+id/tabProfileIndicator"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tabProfileText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:includeFontPadding="false"
                            android:text="Apps"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.manjugroups.m_connect.ui.custom.GlassNavBar>
        </eightbitlab.com.blurview.BlurView>
        </LinearLayout>
        </FrameLayout>


        <!-- Dummy views for old taskNudge logic to prevent crashes -->
        <FrameLayout
            android:id="@+id/taskNudgeOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/taskNudgeScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/taskNudgePager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>
