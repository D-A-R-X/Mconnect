<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF" />

    <!-- Content area: fragment fills below status bar; tab bar overlays at bottom -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F1F3F8" />

        <!-- Fade/blur overlay behind bottom navigation bar -->
        <View
            android:id="@+id/bottomNavFadeOverlay"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_nav_fade_grey"
            android:clickable="false"
            android:focusable="false" />

        <!-- Floating pill bottom nav. Transparent background so the
             scrolling page content (the panel grey, or the cards
             themselves) shows through behind the pill's side / top
             margins. The pill itself carries its own white rounded
             background, so it still reads as floating. -->
        <FrameLayout
            android:id="@+id/tabBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/tabBarStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

        <!-- Wide, flat pending-tasks bar tucked BEHIND the nav pill so only the
             top peeks out (bottom edge hidden). Side margins land just inside
             the nav's rounded ends so the edges reach the curve. Count on the
             left + a small Complete chip that routes the newest task.
             Persistent — only hides when nothing is pending; not dismissable. -->
        <FrameLayout
            android:id="@+id/floatingPeakContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="-18dp"
            android:visibility="gone"
            android:elevation="8dp">

            <!-- 1. PEEKING PILLS LAYOUT -->
            <RelativeLayout
                android:id="@+id/peekingPillsLayout"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="bottom"
                android:visibility="visible">

                <!-- Left Sparks -->
                <ImageView
                    android:id="@+id/sparksLeft"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sparks_left"
                    android:layout_alignParentBottom="true"
                    android:layout_toStartOf="@id/pillTasks"
                    android:layout_marginEnd="-12dp"
                    android:layout_marginBottom="35dp" />

                <!-- 1. Task Pending (Blue) -->
                <RelativeLayout
                    android:id="@+id/pillTasks"
                    android:layout_width="112dp"
                    android:layout_height="72dp"
                    android:layout_alignParentBottom="true"
                    android:layout_toStartOf="@id/centerAnchor"
                    android:layout_marginEnd="-22dp"
                    android:background="@drawable/bg_peak_pill_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task\nPending"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_bold"
                        android:lineSpacingMultiplier="0.9" />

                    <TextView
                        android:id="@+id/tvCountTasks"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_circle_blue_dark"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_semibold" />
                </RelativeLayout>

                <!-- Center Anchor for relative positioning -->
                <View
                    android:id="@+id/centerAnchor"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:layout_centerHorizontal="true" />

                <!-- 3. Follow-ups Pending (Teal) -->
                <RelativeLayout
                    android:id="@+id/pillFollowUps"
                    android:layout_width="112dp"
                    android:layout_height="72dp"
                    android:layout_alignParentBottom="true"
                    android:layout_toEndOf="@id/centerAnchor"
                    android:layout_marginStart="-22dp"
                    android:background="@drawable/bg_peak_pill_teal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Follow-ups\nPending"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_bold"
                        android:lineSpacingMultiplier="0.9" />

                    <TextView
                        android:id="@+id/tvCountFollowUps"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_circle_teal_dark"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_semibold" />
                </RelativeLayout>

                <!-- Right Sparks -->
                <ImageView
                    android:id="@+id/sparksRight"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sparks_right"
                    android:layout_alignParentBottom="true"
                    android:layout_toEndOf="@id/pillFollowUps"
                    android:layout_marginStart="-12dp"
                    android:layout_marginBottom="35dp" />

                <!-- 2. Visits Pending (Purple - Overlapping Middle) -->
                <RelativeLayout
                    android:id="@+id/pillVisits"
                    android:layout_width="116dp"
                    android:layout_height="78dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_peak_pill_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:elevation="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visits\nPending"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_bold"
                        android:lineSpacingMultiplier="0.9" />

                    <TextView
                        android:id="@+id/tvCountVisits"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_circle_purple_dark"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_semibold" />
                </RelativeLayout>
            </RelativeLayout>

            <!-- 2. EXPANDED CAROUSEL LAYOUT -->
            <LinearLayout
                android:id="@+id/expandedCarouselLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <!-- ViewPager2 for swipeable card stack -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpPendingCards"
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <!-- Dot Indicators -->
                <LinearLayout
                    android:id="@+id/carouselIndicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_tab_bar"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- HOME tab -->
            <FrameLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Home" />

                    <View
                        android:id="@+id/tabHomeIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabHomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Home"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ATTENDANCE tab -->
            <FrameLayout
                android:id="@+id/tabHr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabHrIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Attendance" />

                    <View
                        android:id="@+id/tabHrIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabHrText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Attendance"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- CHAT tab -->
            <FrameLayout
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabChatIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Chat" />

                    <View
                        android:id="@+id/tabChatIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabChatText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Chat"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- APPS tab -->
            <FrameLayout
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabProfileIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Apps" />

                    <View
                        android:id="@+id/tabProfileIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tabProfileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Apps"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
