<?xml version="1.0" encoding="utf-8"?>
<!-- Mandatory alert from web Settings → Mobile → Alert (MobileAlertActivity).
     Closable only after its minimum view time; the button counts down. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobileAlertRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svMobileAlert"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mobile_alert_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bell"
                    app:tint="#B42318" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Alert"
                    android:textColor="#B42318"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMobileAlertSentAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#667085"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMobileAlertTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_bold"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#101828"
                android:textSize="24sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMobileAlertImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#F2F4F7"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivMobileAlertImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Alert image"
                    android:maxHeight="360dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <WebView
                android:id="@+id/wvMobileAlertBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <ProgressBar
                android:id="@+id/pbMobileAlert"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvMobileAlertHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="Please read this alert. It closes only after you have viewed it."
            android:textColor="#667085"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMobileAlertClose"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#1BCA0B"
            android:enabled="false"
            android:fontFamily="@font/inter_bold"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="27dp" />
    </LinearLayout>
</LinearLayout>
