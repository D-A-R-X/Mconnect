<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgPhoneNumberBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth_phonenumber"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/otpSheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_sheet_otp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="85dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <!-- Title — Figma 45:5014 — Inter SemiBold 20sp #101828 centered -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/verify_title"
            android:textColor="#101828"
            android:textSize="20sp" />

        <!-- Subtitle — Figma 45:5016 — Inter Medium 13sp #475467, bold phone number -->
        <TextView
            android:id="@+id/tvOtpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#475467"
            android:textSize="13sp" />

        <!-- OTP boxes — Figma 45:5017 — 6 boxes, 50dp tall, space-between within 326dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otpBox1"
                style="@style/OtpBoxAuth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="0"
                android:textColorHint="#EAECF0" />

            <EditText
                android:id="@+id/otpBox2"
                style="@style/OtpBoxAuth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:hint="0"
                android:textColorHint="#EAECF0" />

            <EditText
                android:id="@+id/otpBox3"
                style="@style/OtpBoxAuth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:hint="0"
                android:textColorHint="#EAECF0" />

            <EditText
                android:id="@+id/otpBox4"
                style="@style/OtpBoxAuth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:hint="0"
                android:textColorHint="#EAECF0" />

            <EditText
                android:id="@+id/otpBox5"
                style="@style/OtpBoxAuth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:hint="0"
                android:textColorHint="#EAECF0" />

            <EditText
                android:id="@+id/otpBox6"
                style="@style/OtpBoxAuth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:hint="0"
                android:textColorHint="#EAECF0" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOtpError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:textColor="#FA7777"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Resend — Figma 45:5015 — Inter Medium 12sp, "Resend it." bold blue #0B61CA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/resend_code"
                android:textColor="#030407"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_bold"
                android:text="@string/resend_code_prompt"
                android:textColor="#0B61CA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Submit — Figma 45:5038 — green gradient, 48dp, 100dp radius -->
        <FrameLayout
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_auth_primary_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvVerify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.0071"
                android:text="@string/verify"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressVerify"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/phoneBadge"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_auth_phone_badge"
        android:elevation="6dp"
        android:translationY="-31dp"
        app:layout_constraintEnd_toEndOf="@id/otpSheet"
        app:layout_constraintStart_toStartOf="@id/otpSheet"
        app:layout_constraintTop_toTopOf="@id/otpSheet">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_auth_secure"
            android:contentDescription="@null" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
