<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <View
        android:id="@+id/topGradientShape"
        android:layout_width="0dp"
        android:layout_height="845dp"
        android:layout_marginStart="-95dp"
        android:layout_marginTop="-260dp"
        android:layout_marginEnd="-95dp"
        android:background="@drawable/bg_welcome_top_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="232dp"
        android:layout_height="211dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="203dp"
        android:alpha="0.45"
        android:background="@drawable/bg_auth_background_card"
        android:elevation="2dp"
        android:rotation="10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="232dp"
        android:layout_height="211dp"
        android:layout_marginStart="83dp"
        android:layout_marginTop="254dp"
        android:alpha="0.38"
        android:background="@drawable/bg_auth_background_card"
        android:elevation="2dp"
        android:rotation="10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="232dp"
        android:layout_height="211dp"
        android:layout_marginStart="113dp"
        android:layout_marginTop="305dp"
        android:alpha="0.32"
        android:background="@drawable/bg_auth_background_card"
        android:elevation="2dp"
        android:rotation="10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#101321DE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/otpSheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_sheet_otp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="31dp"
        android:paddingTop="85dp"
        android:paddingEnd="31dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@string/verify_title"
            android:textColor="#161B23"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvOtpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:textColor="#475467"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otpBox1"
                style="@style/OtpBoxAuth"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:hint="0"
                android:textColorHint="#D0D5DD" />

            <EditText
                android:id="@+id/otpBox2"
                style="@style/OtpBoxAuth"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="4dp"
                android:hint="0"
                android:textColorHint="#D0D5DD" />

            <EditText
                android:id="@+id/otpBox3"
                style="@style/OtpBoxAuth"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="4dp"
                android:hint="0"
                android:textColorHint="#D0D5DD" />

            <EditText
                android:id="@+id/otpBox4"
                style="@style/OtpBoxAuth"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="4dp"
                android:hint="0"
                android:textColorHint="#D0D5DD" />

            <EditText
                android:id="@+id/otpBox5"
                style="@style/OtpBoxAuth"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="4dp"
                android:hint="0"
                android:textColorHint="#D0D5DD" />

            <EditText
                android:id="@+id/otpBox6"
                style="@style/OtpBoxAuth"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="4dp"
                android:hint="0"
                android:textColorHint="#D0D5DD" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOtpError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:textColor="#FA7777"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/resend_code"
                android:textColor="#030407"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_regular"
                android:text="@string/resend_code_prompt"
                android:textColor="#6938EF"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_auth_primary_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvVerify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_medium"
                android:text="@string/verify"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressVerify"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvDifferentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="@string/different_method"
            android:textColor="#030407"
            android:textSize="12sp" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/phoneBadge"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_auth_phone_badge"
        android:elevation="6dp"
        android:translationY="-31dp"
        app:layout_constraintEnd_toEndOf="@id/otpSheet"
        app:layout_constraintStart_toStartOf="@id/otpSheet"
        app:layout_constraintTop_toTopOf="@id/otpSheet">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_auth_phone"
            app:tint="#FFFFFF" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
