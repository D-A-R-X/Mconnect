<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Sky gradient — full-bleed, internal blue→white fade, height covers Figma Rectangle 2 area -->
    <View
        android:id="@+id/viewSkyGradient"
        android:layout_width="match_parent"
        android:layout_height="540dp"
        android:background="@drawable/bg_onboard_sky_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Illustration: Onboard1 ── -->
    <include
        android:id="@+id/illOnboard1"
        layout="@layout/onboard_ill_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardOnboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Illustration: Onboard2 ── -->
    <include
        android:id="@+id/illOnboard2"
        layout="@layout/onboard_ill_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardOnboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Illustration: Onboard3 ── -->
    <include
        android:id="@+id/illOnboard3"
        layout="@layout/onboard_ill_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardOnboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Bottom white card ── -->
    <LinearLayout
        android:id="@+id/cardOnboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_onboard_card"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Title — Figma: #101828, 24sp -->
        <TextView
            android:id="@+id/tvOnboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Welcome to Manju Groups"
            android:textColor="#101828"
            android:textSize="24sp" />

        <!-- Subtitle — Figma: #475467, Inter Medium, 13sp, gap 12dp from title -->
        <TextView
            android:id="@+id/tvOnboardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="Manage Projects, engage customers, and streamline operations - all in one place."
            android:textColor="#475467"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <!-- Dots — Figma: 20x4 pill, active=green gradient, inactive=#D4F2FF -->
        <LinearLayout
            android:id="@+id/llDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dot1"
                android:layout_width="20dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_onboard_dot_active" />

            <View
                android:id="@+id/dot2"
                android:layout_width="20dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_onboard_dot_inactive" />

            <View
                android:id="@+id/dot3"
                android:layout_width="20dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_onboard_dot_inactive" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <!-- Next button — Figma: gradient #1BCA0B→#3D9D02, 48dp, full radius -->
        <FrameLayout
            android:id="@+id/btnOnboardNext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_onboard_btn_next"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvBtnNextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="Next"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:letterSpacing="0.006" />

        </FrameLayout>

        <!-- Skip — Figma prototype: outline border, green text -->
        <FrameLayout
            android:id="@+id/btnOnboardSkip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_onboard_btn_skip"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="Skip"
                android:textColor="#1BCA0B"
                android:textSize="14sp" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
