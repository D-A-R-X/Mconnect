<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D5DB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="Allocate Vehicle"
        android:textColor="#111827"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:text="Information about Vehicle and Driver"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <!-- Assign from: Internal (MFPL) vs External (Travel agency) — mirrors the
         web dialog's source toggle. Shown only when agencies are available. -->
    <TextView
        android:id="@+id/tvLabelAssignSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Assign from"
        android:textColor="#374151"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rowAssignSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pricing_toggle_container"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnSourceInternal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_my_trips_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Internal (MFPL)"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSourceExternal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="External agency"
            android:textColor="#475467"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Travel agency picker (external mode only). -->
    <TextView
        android:id="@+id/tvLabelAgency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Travel agency *"
        android:textColor="#374151"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/agencySelector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_vehicle_dropdown"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_custom_user"
            app:tint="#4B5563" />

        <TextView
            android:id="@+id/tvAgencyValue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_vertical"
            android:hint="Select agency"
            android:maxLines="1"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="#4B5563" />
    </FrameLayout>

    <!-- Vehicle Selector -->
    <TextView
        android:id="@+id/tvLabelVehicle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Vehicle *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/vehicleSelector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_vehicle_dropdown"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_custom_car" />

        <TextView
            android:id="@+id/tvVehicleValue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_vertical"
            android:hint="Select vehicle"
            android:maxLines="1"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="#4B5563" />
    </FrameLayout>

    <!-- Driver Name -->
    <TextView
        android:id="@+id/tvLabelDriverName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Driver Name *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etDriverName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_user"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Driver Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Driver Phone Number -->
    <TextView
        android:id="@+id/tvLabelDriverPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Driver Phone Number *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etDriverPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_phone"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Phone Number"
        android:inputType="phone"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Pickup Time -->
    <TextView
        android:id="@+id/tvLabelPickupTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Pickup Time *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etPickupTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:clickable="true"
        android:drawableStart="@drawable/ic_custom_clock"
        android:drawablePadding="10dp"
        android:focusable="false"
        android:fontFamily="@font/inter_regular"
        android:hint="Select Time (e.g. 02:30 AM)"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Allocate Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmitAllocate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_allocate_button_green"
        android:fontFamily="@font/inter_semibold"
        android:text="Allocate"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
