<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_apply_leave">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_chat_sheet_handle" />

        <!-- Title + subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Fill Permission Summary"
            android:textColor="#101828"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_medium"
            android:text="Information about Permission details"
            android:textColor="#667085"
            android:textSize="12sp" />

        <!-- Permission Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_medium"
            android:text="Permission Date"
            android:textColor="#344054"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/fieldPermissionDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_apply_leave_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Date"
                android:src="@drawable/ic_leave_duration_cal" />

            <TextView
                android:id="@+id/tvPermissionDateValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:text="Select Date"
                android:textColor="#101828"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_leave_chevron_down"
                app:tint="#667085" />
        </LinearLayout>

        <!-- Permission Duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_medium"
            android:text="Permission Duration"
            android:textColor="#344054"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/fieldPermissionDuration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_apply_leave_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Duration"
                android:src="@drawable/ic_clock_gradient_blue" />

            <TextView
                android:id="@+id/tvPermissionDurationValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:text="Select Duration"
                android:textColor="#101828"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_leave_chevron_down"
                app:tint="#667085" />
        </LinearLayout>

        <!-- Permission Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_medium"
            android:text="Permission Description"
            android:textColor="#344054"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etReason"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_apply_leave_field"
            android:fontFamily="@font/inter_regular"
            android:gravity="top|start"
            android:hint="Enter Leave Description"
            android:inputType="textMultiLine"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#101828"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <!-- Submit Button -->
        <FrameLayout
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_disabled_grey"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="Submit Now"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <View
                android:id="@+id/skeletonSubmit"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_skeleton_circle_inverse"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
