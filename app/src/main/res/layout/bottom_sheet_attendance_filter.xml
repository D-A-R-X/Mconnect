<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_leave_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:text="Filter Attendance"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:text="Pick a date range to view your attendance"
        android:textColor="?attr/colorForegroundSecondary"
        android:textSize="12sp" />

    <!-- Quick presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/presetThisMonth"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_leave_sheet_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="This Month"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/presetLastMonth"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_leave_sheet_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Last Month"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/presetLast7"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_leave_sheet_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Last 7 Days"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- From / To pickers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="From"
                android:textColor="?attr/colorForegroundSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnFromDate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_leave_form_field"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="To"
                android:textColor="?attr/colorForegroundSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnToDate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_leave_form_field"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnFilterClose"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_leave_sheet_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnFilterApply"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_leave_sheet_button_filled"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Apply"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
