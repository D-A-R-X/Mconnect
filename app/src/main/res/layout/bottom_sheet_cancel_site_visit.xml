<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_bold"
        android:text="Cancel site visit?"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:text="This closes the visit and cannot be undone. The lead will be reopened when no other active site visit exists."
        android:textColor="?attr/colorForegroundSecondary"
        android:textSize="14sp" />

    <TextView
        style="@style/OutcomeFieldLabel"
        android:layout_marginTop="20dp"
        android:text="Reason (optional)" />

    <EditText
        android:id="@+id/etCancelSvReason"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:fontFamily="@font/inter_regular"
        android:gravity="top"
        android:hint="Why is this visit being cancelled?"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="14dp"
        android:textColor="?attr/colorForegroundPrimary"
        android:textColorHint="?attr/colorForegroundSecondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCancelSvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKeepSiteVisit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Keep visit"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnConfirmCancelSv"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="Cancel visit"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
