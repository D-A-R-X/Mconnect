<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_sheet_top"
    android:orientation="vertical">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/btnCreateGroupClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_sheet_close_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Close"
                android:src="@drawable/ic_sheet_close"
                app:tint="#101828" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Create Group"
                android:textColor="#101828"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Start a conversation"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_chat_sheet_handle" />

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="In this you can add people and create group"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <!-- Group name input -->
        <EditText
            android:id="@+id/etGroupName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_create_group_input"
            android:fontFamily="@font/inter_regular"
            android:hint="Group name"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="#101828"
            android:textColorHint="#8E8E93"
            android:textCursorDrawable="@null"
            android:textSize="14sp" />

        <!-- Selected members header + chips -->
        <TextView
            android:id="@+id/tvSelectedMembersHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_regular"
            android:textColor="#475467"
            android:textSize="13sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/selectedMembersScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/selectedMembersContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Search input -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_sheet_search_field">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="14dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_chat_search"
                app:tint="#8E8E93" />

            <EditText
                android:id="@+id/etSearchGroupPeople"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_regular"
                android:hint="Search people"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="40dp"
                android:paddingEnd="14dp"
                android:textColor="#101828"
                android:textColorHint="#8E8E93"
                android:textCursorDrawable="@null"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- People list -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:fillViewport="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/groupPeopleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sheet_people_card"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/groupSkeletonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sheet_people_card"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include layout="@layout/skeleton_list_item" />
                    <include layout="@layout/skeleton_list_item" />
                    <include layout="@layout/skeleton_list_item" />
                    <include layout="@layout/skeleton_list_item" />
                    <include layout="@layout/skeleton_list_item" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGroupEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingVertical="48dp"
                    android:text=""
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Bottom CTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2F2F7"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="22dp">

        <FrameLayout
            android:id="@+id/btnCreateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet_start_button_disabled"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="52dp">

            <TextView
                android:id="@+id/tvCreateGroupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="Create"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
