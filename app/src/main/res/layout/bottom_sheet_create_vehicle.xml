<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_with_border"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D5DB" />

    <!-- Header Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnEditVehicle"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCreateVehicleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Create Vehicle"
                android:textColor="#111827"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Information about Vehicle"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditVehicle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_btn_edit_outline_green"
            android:fontFamily="@font/inter_semibold"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#22C55E"
            android:textSize="13sp"
            android:visibility="gone"
            android:drawableStart="@drawable/ic_edit_gradient"
            android:drawablePadding="6dp"
            android:paddingHorizontal="12dp" />
    </RelativeLayout>

    <!-- Vehicle Number -->
    <TextView
        android:id="@+id/tvLabelVehicleNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Vehicle Number *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etVehicleNumber"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_car"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Enter Vehicle Number"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Vehicle Type -->
    <TextView
        android:id="@+id/tvLabelVehicleType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Vehicle Type *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etVehicleType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_car"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Enter Vehicle Type"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Capacity -->
    <TextView
        android:id="@+id/tvLabelCapacity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Capacity *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etCapacity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_capacity"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Enter Capacity"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Name -->
    <TextView
        android:id="@+id/tvLabelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Name *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etDriverName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_user"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Enter Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Phone Number -->
    <TextView
        android:id="@+id/tvLabelPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Phone Number *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etDriverPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_phone"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Enter Phone Number"
        android:inputType="phone"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Agency -->
    <TextView
        android:id="@+id/tvLabelAgency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Agency *"
        android:textColor="#374151"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etAgency"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_custom_agency"
        android:drawablePadding="10dp"
        android:fontFamily="@font/inter_regular"
        android:hint="Enter Agency"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp" />

    <!-- Submit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmitCreate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_allocate_button_green"
        android:fontFamily="@font/inter_semibold"
        android:text="Submit"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Edit Buttons (Edit Mode) -->
    <LinearLayout
        android:id="@+id/layoutEditButtons"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeactivate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_deactivate_outline_red"
            android:fontFamily="@font/inter_semibold"
            android:text="Deactivate"
            android:textAllCaps="false"
            android:textColor="#EF4444"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_allocate_button_green"
            android:fontFamily="@font/inter_semibold"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
