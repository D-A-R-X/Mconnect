<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_action_sheet"
    android:orientation="vertical"
    android:layout_marginTop="36dp"
    android:paddingBottom="16dp">

    <!-- Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/btnCameraClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_sheet_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#101828" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCameraFlash"
            app:layout_constraintStart_toEndOf="@id/btnCameraClose"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvCameraSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Camera"
                android:textColor="#101828"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCameraSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Take a photo"
                android:textColor="#667085"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCameraFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:padding="6dp"
            android:text="⚡A"
            android:textColor="#101828"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Preview Card Section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Live Camera ViewFinder -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/viewFinder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scaleType="fillCenter" />



                <!-- Zoom Controls Overlay -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_camera_zoom_pill"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvZoom05"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="0.5"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvZoom1x"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_home_new_action_circle"
                        android:backgroundTint="#FFFFFF"
                        android:gravity="center"
                        android:textColor="#101828"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:text="1x"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvZoom2x"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="2"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- ─── Review overlay (shown after capture) ───────────────
                     Covers the live preview with the captured photo/video and
                     a Retake / Use bar. Only "Use" returns the media to the
                     caller; "Retake" discards it and resumes the camera. -->
                <FrameLayout
                    android:id="@+id/reviewOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgReviewPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <VideoView
                        android:id="@+id/videoReview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="40dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="28dp">

                        <!-- Retake -->
                        <LinearLayout
                            android:id="@+id/btnReviewRetake"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_home_new_action_circle"
                                android:backgroundTint="#52FFFFFF">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sheet_close"
                                    android:contentDescription="Retake"
                                    app:tint="#FFFFFF" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/inter_medium"
                                android:text="Retake"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Use (confirm/tick) -->
                        <LinearLayout
                            android:id="@+id/btnReviewConfirm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:background="@drawable/bg_attendance_camera_capture_outer"
                                android:backgroundTint="#38A612">
                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_white"
                                    android:contentDescription="Use"
                                    app:tint="#FFFFFF" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvReviewConfirm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="Use Photo"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Mode Selector Tabs (Photo/Video) -->
    <LinearLayout
        android:id="@+id/modeTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabPhotoMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="PHOTO"
                android:textColor="#38A612"
                android:textSize="13sp" />

            <View
                android:id="@+id/dotTabPhoto"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_loan_track_active"
                android:backgroundTint="#38A612" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabVideoMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="VIDEO"
                android:textColor="#667085"
                android:textSize="13sp" />

            <View
                android:id="@+id/dotTabVideo"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_loan_track_active"
                android:backgroundTint="#38A612"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="32dp">

        <!-- Gallery Option -->
        <LinearLayout
            android:id="@+id/btnCameraGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_new_action_circle"
                android:backgroundTint="#F2F4F7">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gallery"
                    app:tint="#475467" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_medium"
                android:text="Gallery"
                android:textColor="#475467"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Capture Button -->
        <FrameLayout
            android:id="@+id/btnCameraCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_attendance_camera_capture_outer"
            android:backgroundTint="#38A612"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Shutter Icon / Circle -->
            <ImageView
                android:id="@+id/imgCaptureShutter"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chat_camera"
                app:tint="#38A612" />
        </FrameLayout>

        <!-- Camera Switch Option -->
        <LinearLayout
            android:id="@+id/btnCameraSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_new_action_circle"
                android:backgroundTint="#F2F4F7">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera_switch"
                    app:tint="#475467" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_medium"
                android:text="Switch"
                android:textColor="#475467"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Tip Section -->
    <LinearLayout
        android:id="@+id/bottomTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_camera_tips_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_tip_bulb"
            app:tint="#38A612" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_medium"
            android:text="Tips: Ensure good lighting and clear visibility"
            android:textColor="#38A612"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
