<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_leave_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:text="Leave Category"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/inter_regular"
        android:text="Select Leave category"
        android:textColor="?attr/colorForegroundSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/leaveCategoryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCloseSheet"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_leave_sheet_button_outline"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Close Message"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSubmitSheet"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_leave_sheet_button_filled"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Submit Date"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
