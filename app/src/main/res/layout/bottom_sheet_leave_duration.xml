<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_leave_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:text="Leave Duration"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/inter_regular"
        android:text="Select Leave Duration"
        android:textColor="?attr/colorForegroundSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnPrevMonth"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Previous month"
            android:src="@drawable/ic_leave_chevron_left" />

        <TextView
            android:id="@+id/tvMonthLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btnNextMonth"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Next month"
            android:src="@drawable/ic_leave_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:background="#EEF0F5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sun"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mon"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tue"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Wed"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Thu"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Fri"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sat"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/calendarGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alignmentMode="alignMargins"
        android:columnCount="7"
        android:rowCount="6"
        android:useDefaultMargins="false" />

    <TextView
        android:id="@+id/btnDurationSubmit"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_leave_sheet_button_filled_dark"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Submit Date"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnDurationClose"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_leave_sheet_button_outline"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Close Message"
        android:textColor="?attr/colorAccentPrimary"
        android:textSize="12sp" />

</LinearLayout>
