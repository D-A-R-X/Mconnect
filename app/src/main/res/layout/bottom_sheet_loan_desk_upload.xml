<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_auth_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chat_sheet_handle" />

    <!-- Title + Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Submit Documents"
            android:textColor="#101828"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_medium"
            android:text="Please upload the 4 required files below to proceed"
            android:textColor="#667085"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. PAN Card Slot -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDocTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/inter_semibold"
                    android:text="PAN Card *"
                    android:textColor="#344054"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/btnCamera1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:paddingStart="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_header_camera_outline"
                        app:tint="#0B61CA"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Camera"
                        android:textColor="#0B61CA"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <!-- Unuploaded State (Dashed Box) -->
                <LinearLayout
                    android:id="@+id/layoutUnuploaded1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dash_upload"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_upload_cloud" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Upload PAN Card"
                        android:textColor="#344054"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="To avoid reject, ensure PAN Card size is max 2MB\n(Supports: JPG,PNG,PDF)"
                        android:textColor="#98A2B3"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Uploaded State (Solid Box with tick) -->
                <RelativeLayout
                    android:id="@+id/layoutUploaded1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_loan_input_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivDocIcon1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_loan_document"
                        app:tint="#667085"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvUploadedName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ivDocIcon1"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#101828"
                        android:textSize="13sp"
                        tools:text="pan_card_doc.pdf" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_leave_action_check"
                        app:tint="#1BCA0B"
                        android:importantForAccessibility="no" />
                </RelativeLayout>
            </FrameLayout>

            <!-- 2. Aadhaar Card Slot -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDocTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Aadhaar Card *"
                    android:textColor="#344054"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/btnCamera2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:paddingStart="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_header_camera_outline"
                        app:tint="#0B61CA"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Camera"
                        android:textColor="#0B61CA"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <!-- Unuploaded State (Dashed Box) -->
                <LinearLayout
                    android:id="@+id/layoutUnuploaded2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dash_upload"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_upload_cloud" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Upload Aadhaar Card"
                        android:textColor="#344054"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="To avoid reject, ensure Aadhaar photo size is max 2MB\n(Supports: JPG,PNG,PDF)"
                        android:textColor="#98A2B3"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Uploaded State (Solid Box with tick) -->
                <RelativeLayout
                    android:id="@+id/layoutUploaded2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_loan_input_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivDocIcon2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_loan_document"
                        app:tint="#667085"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvUploadedName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ivDocIcon2"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#101828"
                        android:textSize="13sp"
                        tools:text="aadhaar_card_doc.pdf" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_leave_action_check"
                        app:tint="#1BCA0B"
                        android:importantForAccessibility="no" />
                </RelativeLayout>
            </FrameLayout>

            <!-- 3. Bank Statement Slot -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDocTitle3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Bank Statement *"
                    android:textColor="#344054"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/btnCamera3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:paddingStart="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_header_camera_outline"
                        app:tint="#0B61CA"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Camera"
                        android:textColor="#0B61CA"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <!-- Unuploaded State (Dashed Box) -->
                <LinearLayout
                    android:id="@+id/layoutUnuploaded3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dash_upload"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_upload_cloud" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Upload Bank Statement"
                        android:textColor="#344054"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="To avoid reject, ensure Bank Statement size is max 2MB\n(Supports: JPG,PNG,PDF)"
                        android:textColor="#98A2B3"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Uploaded State (Solid Box with tick) -->
                <RelativeLayout
                    android:id="@+id/layoutUploaded3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_loan_input_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivDocIcon3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_loan_document"
                        app:tint="#667085"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvUploadedName3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ivDocIcon3"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#101828"
                        android:textSize="13sp"
                        tools:text="bank_statement.pdf" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_leave_action_check"
                        app:tint="#1BCA0B"
                        android:importantForAccessibility="no" />
                </RelativeLayout>
            </FrameLayout>

            <!-- 4. Income Tax / Pay Slip Slot -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvDocTitle4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Income Tax / Pay Slip *"
                    android:textColor="#344054"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/btnCamera4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:paddingStart="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_header_camera_outline"
                        app:tint="#0B61CA"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Camera"
                        android:textColor="#0B61CA"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp">

                <!-- Unuploaded State (Dashed Box) -->
                <LinearLayout
                    android:id="@+id/layoutUnuploaded4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dash_upload"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_upload_cloud" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Upload IT / Pay Slip"
                        android:textColor="#344054"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:text="To avoid reject, ensure file size is max 2MB\n(Supports: JPG,PNG,PDF)"
                        android:textColor="#98A2B3"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Uploaded State (Solid Box with tick) -->
                <RelativeLayout
                    android:id="@+id/layoutUploaded4"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_loan_input_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivDocIcon4"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_loan_document"
                        app:tint="#667085"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvUploadedName4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/ivDocIcon4"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#101828"
                        android:textSize="13sp"
                        tools:text="pay_slip.pdf" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_leave_action_check"
                        app:tint="#1BCA0B"
                        android:importantForAccessibility="no" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Submit Button -->
            <TextView
                android:id="@+id/btnSubmitUploads"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_leave_submit_button"
                android:clickable="true"
                android:focusable="true"
                android:enabled="false"
                android:alpha="0.5"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="Submit Now"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
