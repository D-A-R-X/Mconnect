<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_sheet"
    android:orientation="vertical">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chat_sheet_handle" />

    <!-- Title + Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvUploadSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Submit Documents"
            android:textColor="#101828"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvUploadSheetSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_medium"
            android:text="Please upload the 4 required files below to proceed"
            android:textColor="#667085"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dynamic doc rows — LoanDeskUploadBottomSheet inflates
                 one item_loan_upload_doc.xml per required document from
                 the case's documentsChecklist. -->
            <LinearLayout
                android:id="@+id/docsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D5DD" />

    <!-- Docked Submit Button Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/btnSubmitUploads"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_leave_submit_button"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false"
            android:alpha="0.5"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Submit Now"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </FrameLayout>

</LinearLayout>
