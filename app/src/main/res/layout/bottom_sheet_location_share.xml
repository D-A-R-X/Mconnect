<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chat_action_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="#EAECF0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/inter_bold"
        android:text="Location &amp; Telemetry Share"
        android:textColor="#101828"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:text="📡 Manju Groups PMS Live Tracking System"
        android:textColor="#475467"
        android:textSize="12sp" />

    <!-- Radar Scanner Container -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp">

        <!-- Concentric grid lines -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_radar_concentric" />

        <!-- Rotating radar sweep line -->
        <ImageView
            android:id="@+id/imgRadarSweep"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_location_compass" />

        <!-- Center locator pulsing dot -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <!-- Radar center pulse circle -->
            <ImageView
                android:id="@+id/imgRadarPulse"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/presence_online"
                app:tint="#38A612" />
        </FrameLayout>
    </FrameLayout>

    <!-- Telemetry Details Grid -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8F9FA">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:padding="16dp">

            <!-- Latitude -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LATITUDE"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_semibold" />
                <TextView
                    android:id="@+id/tvLocationLatitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fetching..."
                    android:textColor="#101828"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_mono" />
            </LinearLayout>

            <!-- Longitude -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LONGITUDE"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_semibold" />
                <TextView
                    android:id="@+id/tvLocationLongitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fetching..."
                    android:textColor="#101828"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_mono" />
            </LinearLayout>

            <!-- Battery Level -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATTERY STATUS"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_semibold" />
                <TextView
                    android:id="@+id/tvLocationBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#101828"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

            <!-- Speed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_semibold" />
                <TextView
                    android:id="@+id/tvLocationSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#101828"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

            <!-- Accuracy -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS ACCURACY"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_semibold" />
                <TextView
                    android:id="@+id/tvLocationAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculating..."
                    android:textColor="#101828"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

            <!-- GPS Status Indicator -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS STATE"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_semibold" />
                <TextView
                    android:id="@+id/tvLocationState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acquiring Lock..."
                    android:textColor="#FF9F0A"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>
        </GridLayout>
    </androidx.cardview.widget.CardView>

    <!-- Context / Label Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter_medium"
        android:text="Select Telemetry Context"
        android:textColor="#344054"
        android:textSize="12sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupLocationMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:singleSelection="true"
        app:checkedChip="@+id/chipModeInspection">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeInspection"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Site Inspection"
            app:chipBackgroundColor="@color/chat_filter_inactive"
            app:checkedIconEnabled="true"
            app:chipIconEnabled="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeDuty"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Punched Duty"
            app:chipBackgroundColor="@color/chat_filter_inactive"
            app:checkedIconEnabled="true"
            app:chipIconEnabled="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeMeeting"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client Meeting"
            app:chipBackgroundColor="@color/chat_filter_inactive"
            app:checkedIconEnabled="true"
            app:chipIconEnabled="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeRegular"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Location"
            app:chipBackgroundColor="@color/chat_filter_inactive"
            app:checkedIconEnabled="true"
            app:chipIconEnabled="false" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Share Button -->
    <Button
        android:id="@+id/btnLocationShareSend"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#38A612"
        android:fontFamily="@font/inter_bold"
        android:text="Share Location &amp; Telemetry"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="100dp" />

</LinearLayout>
