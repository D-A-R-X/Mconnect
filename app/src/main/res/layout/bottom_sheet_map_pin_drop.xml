<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable map pin-drop: address search with live suggestions (map
     microservice) + a pan-under-a-fixed-center-pin map + reverse-geocoded
     address + confirm. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Map fills the sheet; the search + confirm float over it. -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/pinMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="128dp" />

    <!-- Fixed center pin: the map pans underneath it. -->
    <ImageView
        android:id="@+id/pinCenterMarker"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:layout_marginTop="118dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_map_location_marker"
        android:translationY="-18dp" />

    <!-- My-location button. -->
    <FrameLayout
        android:id="@+id/btnPinMyLocation"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/bg_home_new_action_circle"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_map_location_marker" />
    </FrameLayout>

    <!-- Search header (title + grab handle + search field + suggestions). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pagination_size_pill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_outcome_field_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chat_search"
                app:tint="#667085" />

            <EditText
                android:id="@+id/etPinSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_medium"
                android:hint="Search a place or address"
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/pbPinSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="#0B61CA"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnPinSearchClear"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_outcome_close"
                android:visibility="gone"
                app:tint="#98A2B3" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPinSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="#B42318"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="No network. Check your connection and try again."
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Suggestions dropdown (below the search header). -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPinSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_chat_contact_card"
        android:elevation="8dp"
        android:maxHeight="280dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Confirm bar: resolved address + Use this location. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_map_location_marker" />

            <TextView
                android:id="@+id/tvPinAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="2"
                android:text="Move the map to set the location"
                android:textColor="#344054"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPinConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chat_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Use this location"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
