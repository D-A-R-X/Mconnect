<?xml version="1.0" encoding="utf-8"?>
<!--
  Multi-select staff picker bottom sheet used from chat group creation.
  Hosts a search field, a vertically scrollable people list, and a sticky
  done button that surfaces the selection count. See ChatListFragment.
  pickMultipleStaff for the view-binding contract:
  - tvSheetTitle
  - etSearchPeople
  - tvSelectedCount
  - peopleCard (the LinearLayout that gets populated with item_chat_sheet_person rows)
  - tvEmptyPeople
  - btnSheetClose
  - btnDone (FrameLayout, ripple host)
  - tvDoneLabel
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_sheet_top"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Handle pill -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chat_sheet_handle" />

    <!-- Header: title + close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="Select people"
            android:textColor="#1D2939"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/btnSheetClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_sheet_close_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_sheet_close"
                app:tint="#101828" />
        </FrameLayout>
    </LinearLayout>

    <!-- Search input -->
    <EditText
        android:id="@+id/etSearchPeople"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chat_search_pill"
        android:fontFamily="@font/inter_medium"
        android:hint="Search people"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="#1D2939"
        android:textColorHint="#98A2B3"
        android:textSize="14sp" />

    <!-- Selection count -->
    <TextView
        android:id="@+id/tvSelectedCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_medium"
        android:text="0 selected"
        android:textColor="#475467"
        android:textSize="12sp" />

    <!-- People list (scrollable) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/peopleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_action_card"
                android:orientation="vertical"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tvEmptyPeople"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:paddingVertical="32dp"
                android:text="No matching people"
                android:textColor="#98A2B3"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </ScrollView>

    <!-- Done button -->
    <FrameLayout
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_start_button_disabled"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/tvDoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
