<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:text="Site visit details"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvCounsellingLeadTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCounsellingSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="?attr/colorForegroundSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCounsellingVisitStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                style="@style/SiteVisitQrDetailLabel"
                android:layout_marginTop="20dp"
                android:text="CLIENT" />

            <TextView
                android:id="@+id/tvCounsellingClientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_bold"
                android:textColor="?attr/colorAccentPrimary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvCounsellingProject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="?attr/colorForegroundSecondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SiteVisitQrDetailLabel"
                        android:text="MOBILE NUMBER" />

                    <TextView
                        android:id="@+id/tvCounsellingMobile"
                        style="@style/SiteVisitQrDetailValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SiteVisitQrDetailLabel"
                        android:text="OCCUPATION" />

                    <TextView
                        android:id="@+id/tvCounsellingOccupation"
                        style="@style/SiteVisitQrDetailValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SiteVisitQrDetailLabel"
                        android:text="BDO" />

                    <TextView
                        android:id="@+id/tvCounsellingBdo"
                        style="@style/SiteVisitQrDetailValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SiteVisitQrDetailLabel"
                        android:text="SITE INCHARGE" />

                    <TextView
                        android:id="@+id/tvCounsellingIncharge"
                        style="@style/SiteVisitQrDetailValue" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SiteVisitQrDetailLabel"
                android:layout_marginTop="20dp"
                android:text="ADDITIONAL VISITORS" />

            <TextView
                android:id="@+id/tvCounsellingAdditionalVisitors"
                style="@style/SiteVisitQrDetailValue"
                android:lineSpacingExtra="3dp" />

            <TextView
                style="@style/SiteVisitQrDetailLabel"
                android:layout_marginTop="20dp"
                android:text="FOOD PREFERENCES" />

            <TextView
                android:id="@+id/tvCounsellingFoodPreferences"
                style="@style/SiteVisitQrDetailValue" />

            <LinearLayout
                android:id="@+id/counsellingOutcomeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_outcome_field_pill"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    style="@style/SiteVisitQrDetailLabel"
                    android:text="OUTCOME" />

                <TextView
                    android:id="@+id/tvCounsellingOutcome"
                    style="@style/SiteVisitQrDetailValue"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_semibold" />

                <TextView
                    android:id="@+id/tvCounsellingOutcomeNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="?attr/colorForegroundSecondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCounsellingAccessNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_outcome_field_pill"
                android:fontFamily="@font/inter_regular"
                android:padding="12dp"
                android:textColor="?attr/colorForegroundSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/counsellingActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelCounselling"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Close"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnStartCounselling"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="Start counselling"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
