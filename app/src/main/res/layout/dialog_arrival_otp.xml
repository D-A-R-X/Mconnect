<?xml version="1.0" encoding="utf-8"?>
<!--
  Wrapped in a NestedScrollView so that when the soft keyboard opens
  (the user is typing the OTP), the content can scroll within the
  bottom sheet — the verify button and OTP boxes stay reachable rather
  than getting clipped behind the keyboard. The dialog window itself is
  set to SOFT_INPUT_ADJUST_RESIZE in ArrivalOtpBottomSheet.onCreateDialog.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfacePrimary"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#E4E7EC" />

    <!-- Figma 314:10209 — title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="We have send an OTP to Client!"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvArrivalOtpSubtitle"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:text="Please confirm if you have seen or met the client at this location."
        android:textColor="#475467"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/arrivalOtpBox1"
            android:layout_width="@dimen/otp_box_width"
            android:layout_height="@dimen/otp_box_height"
            android:autofillHints="@null"
            android:background="@drawable/bg_auth_otp_box"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/arrivalOtpBox2"
            android:layout_width="@dimen/otp_box_width"
            android:layout_height="@dimen/otp_box_height"
            android:layout_marginStart="@dimen/otp_gap"
            android:autofillHints="@null"
            android:background="@drawable/bg_auth_otp_box"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/arrivalOtpBox3"
            android:layout_width="@dimen/otp_box_width"
            android:layout_height="@dimen/otp_box_height"
            android:layout_marginStart="@dimen/otp_gap"
            android:autofillHints="@null"
            android:background="@drawable/bg_auth_otp_box"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/arrivalOtpBox4"
            android:layout_width="@dimen/otp_box_width"
            android:layout_height="@dimen/otp_box_height"
            android:layout_marginStart="@dimen/otp_gap"
            android:autofillHints="@null"
            android:background="@drawable/bg_auth_otp_box"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvArrivalOtpError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Inline resend link, figma 314:10209 -->
    <TextView
        android:id="@+id/btnArrivalOtpCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:padding="6dp"
        android:text="Haven't received the verification code? Resend it."
        android:textColor="#0B61CA"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnArrivalOtpVerify"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_chat_primary_button"
        android:fontFamily="@font/inter_semibold"
        android:text="Submit"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp" />
</LinearLayout>

</androidx.core.widget.NestedScrollView>
