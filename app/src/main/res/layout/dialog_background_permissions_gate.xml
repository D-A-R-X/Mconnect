<?xml version="1.0" encoding="utf-8"?>
<!--
  Premium permissions gate Bottom Sheet — pixel-perfect match to the mockup:
    • Rounded top corners (32dp) bottom sheet card
    • Drag handle at the top
    • Large 3D hero checkmark shield illustration (upsized to 300x190dp)
    • "Before we get started" — bold title
    • "We need a few permissions to give you the best experience." — subtitle
    • 4 flat permission rows with 48dp colored circular icon bases, bold title, description,
      and custom right-aligned Toggle Switches (with custom track and white circular thumb)
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_permissions_bottom_sheet"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <!-- Scrollable content so every permission row stays reachable on short
         devices (the sheet height is capped in code; this scrolls inside it). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

    <!-- ── Top drag handle ────────────────────────────────────── -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- ── 3D Hero illustration — large, prominent ────────────── -->
    <ImageView
        android:id="@+id/ivGateShield"
        android:layout_width="150dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_gate_3d_hero" />

    <!-- ── Title ────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Before we get started"
        android:textColor="#101828"
        android:textSize="22sp" />

    <!-- ── Subtitle ─────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:text="We need a few permissions to give you the\nbest experience."
        android:textColor="#475467"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- ── Row 1: Location Access ──────────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_blue">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gate_vector_location" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Location Access"
                android:textColor="#101828"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Allow app to access your device location"
                android:textColor="#475467"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:track="@drawable/bg_switch_track"
            android:thumb="@drawable/bg_switch_thumb"
            android:splitTrack="false"
            app:switchMinWidth="44dp"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <!-- ── Row 2: Background Location ──────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowBgLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_orange">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gate_vector_target" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Background Location"
                android:textColor="#101828"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Allow app to access location in the background"
                android:textColor="#475467"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchBgLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:track="@drawable/bg_switch_track"
            android:thumb="@drawable/bg_switch_thumb"
            android:splitTrack="false"
            app:switchMinWidth="44dp"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <!-- ── Row 3: Physical Activity ────────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowActivityRecognition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_teal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gate_vector_activity" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Physical Activity"
                android:textColor="#101828"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Detect walking vs. stops for accurate journey and battery savings"
                android:textColor="#475467"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchActivityRecognition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:track="@drawable/bg_switch_track"
            android:thumb="@drawable/bg_switch_thumb"
            android:splitTrack="false"
            app:switchMinWidth="44dp"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <!-- ── Row 4: Battery Optimization ─────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowBatteryOpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_green">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gate_vector_battery" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Battery Optimization"
                android:textColor="#101828"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Disable battery optimization for reliable performance"
                android:textColor="#475467"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchBatteryOpt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:track="@drawable/bg_switch_track"
            android:thumb="@drawable/bg_switch_thumb"
            android:splitTrack="false"
            app:switchMinWidth="44dp"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <!-- ── Row 4: Auto Start ───────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowAutostart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_purple">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gate_vector_shield" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Auto Start"
                android:textColor="#101828"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvAutostartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Allow app to start automatically on device boot"
                android:textColor="#475467"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutostart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:track="@drawable/bg_switch_track"
            android:thumb="@drawable/bg_switch_thumb"
            android:splitTrack="false"
            app:switchMinWidth="44dp"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <!-- ── Row 5: Manage app if unused (hibernation / auto-revoke) ──
         Shown only when the OS restriction is currently ENABLED. Tapping it
         deep-links to the system setting to switch it off. Non-blocking, like
         Auto Start. -->
    <LinearLayout
        android:id="@+id/rowManageAppUnused"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_green">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gate_vector_battery" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Manage app if unused"
                android:textColor="#101828"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Turn OFF so the app isn't paused and its permissions removed when unused"
                android:textColor="#475467"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchManageAppUnused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:track="@drawable/bg_switch_track"
            android:thumb="@drawable/bg_switch_thumb"
            android:splitTrack="false"
            app:switchMinWidth="44dp"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <!-- Hidden status text + continue (used internally by Kotlin code) -->
    <TextView
        android:id="@+id/tvGateStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/btnGateContinue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
