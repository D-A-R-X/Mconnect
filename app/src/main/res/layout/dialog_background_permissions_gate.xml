<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact permissions gate dialog — short centered popup.
  No Continue button — auto-dismisses when all permissions granted.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gate_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="24dp"
    android:paddingEnd="18dp"
    android:paddingBottom="20dp">

    <!-- ── Shield icon ──────────────────────────────────────────── -->
    <ImageView
        android:id="@+id/ivGateShield"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/ic_gate_shield_check" />

    <!-- ── Title ────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Let's get you set up!"
        android:textColor="#101828"
        android:textSize="18sp" />

    <!-- ── Subtitle ─────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:text="Enable these permissions to ensure a smooth and accurate experience."
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <!-- ── Row 1: Location Access ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowDeviceLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_gate_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_gate_icon_teal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin"
                android:tint="#10B981" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Location Access"
                android:textColor="#101828"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Helps us verify your location."
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFixDeviceLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gate_btn_enable"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Enable"
            android:textColor="#10B981"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_apps_chevron" />
    </LinearLayout>

    <!-- ── Row 2: Background Location ────────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowBgLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_gate_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_gate_icon_purple">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin"
                android:tint="#7C3AED" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Background Location"
                android:textColor="#101828"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Allows tracking when app is closed."
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFixBgLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gate_btn_enable"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Enable"
            android:textColor="#10B981"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_apps_chevron" />
    </LinearLayout>

    <!-- ── Row 3: Battery Optimization ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/rowBatteryOpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_gate_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_gate_icon_orange">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin"
                android:tint="#F97316" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Battery Optimization"
                android:textColor="#101828"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Keeps the app running smoothly."
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFixBatteryOpt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gate_btn_enable"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Enable"
            android:textColor="#10B981"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_apps_chevron" />
    </LinearLayout>

    <!-- ── Row 4: Auto Start (OEM-specific, hidden by default) ──── -->
    <LinearLayout
        android:id="@+id/rowAutostart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_gate_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_gate_icon_blue">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin"
                android:tint="#2563EB" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Auto Start"
                android:textColor="#101828"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvAutostartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Starts automatically when needed."
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFixAutostart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gate_btn_enable"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Enable"
            android:textColor="#10B981"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_apps_chevron" />
    </LinearLayout>

    <!-- Hidden status text (used by Kotlin for Toast messages) -->
    <TextView
        android:id="@+id/tvGateStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Hidden continue button (auto-dismiss handles closing) -->
    <View
        android:id="@+id/btnGateContinue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
