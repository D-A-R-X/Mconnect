<?xml version="1.0" encoding="utf-8"?>
<!--
  Clockout Successful sheet. Same component shape as
  "Have you seen the client?" (dialog_cp_client_seen): clip-free root,
  white 20dp-rounded card, floating blue clock badge with elevation.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_cp_seen_sheet"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="50dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Clockout Successful!"
            android:textColor="#101828"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="You’ve officially clocked out for the day. Thank you for your hard work! Time to relax and enjoy your break."
            android:textColor="#475467"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCloseClockOutSuccess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_attendance_btn_primary"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.007"
            android:text="Close Message"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_attendance_badge"
        android:elevation="8dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_clock_bold" />
    </FrameLayout>

</FrameLayout>
