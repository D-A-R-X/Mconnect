<?xml version="1.0" encoding="utf-8"?>
<!--
  CP/SV "Rejection Case" reason sheet — opened from the locked SV-cum-CP
  bottom sheet when the field staff taps Reject It. Captures a free-text
  reason that is shipped as `notes` on the existing setCpVisitOutcome
  (outcome=not_interested) call. Visual parity with the main CP outcome
  sheet: same 4-tab tablet at the top (Booking / Site visit / Postpone /
  Not Interested) with Site visit pre-selected, since SV-cum-CP rejection
  is anchored to the SV path.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Title block -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text="Rejection Case"
            android:textColor="#101828"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:text="Rejection Scenario Will Happen"
            android:textColor="#667085"
            android:textSize="13sp" />

        <!-- 4-tab tablet: Booking · Site visit · Postpone · Not Interested.
             Decorative only — taps don't route anywhere because this sheet
             is itself a sub-flow inside the Site-visit path. Site visit is
             the active tab and shows the indicator bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Booking (inactive) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_inactive">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_booking" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Booking"
                    android:textColor="#6A6D78"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:background="#F3F3F5" />

            <!-- Site visit (active) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_active">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_site_visit" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Site visit"
                    android:textColor="#0B61CA"
                    android:textSize="11sp" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_outcome_tab_indicator" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:background="#F3F3F5" />

            <!-- Postpone (inactive) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_inactive">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_postpone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Postpone"
                    android:textColor="#6A6D78"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:background="#F3F3F5" />

            <!-- Not Interested (inactive) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_inactive">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_not_interested" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Not Interested"
                    android:textColor="#6A6D78"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rejection Reason label + textarea -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="Rejection Reason"
            android:textColor="#344054"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRejectReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_outcome_field_pill"
            android:fontFamily="@font/inter_regular"
            android:gravity="top|start"
            android:hint="Tell Valid Reason For Rejection"
            android:includeFontPadding="false"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <!-- Inline error surface (hidden unless populated). -->
        <TextView
            android:id="@+id/tvRejectError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:textColor="#B42318"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Submit Now CTA — green pill matching the confirm action on
             the main outcome sheet. -->
        <LinearLayout
            android:id="@+id/btnRejectSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_home_trip_action_ready"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRejectSubmitLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="Submit Now"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
