<?xml version="1.0" encoding="utf-8"?>
<!--
  Outcome Information sheet — full Booking flow.

  TOP TAB BAR (Pencil "Tabs" SVG ref):
    Booking · Site visit · Postpone · Not Interested
    36dp gradient-blue circle for the active outcome, white-ish circle
    for inactive. Tab labels use the same gradient when active. A 2dp
    rounded underline sits below the active label, and 1dp vertical
    dividers separate the four cells.

  BOOKING SUB-TABS (horizontally scrollable):
    Client · Professional · Office · Booking · Charges · Payment · Staff
    Green-gradient pill for the active sub-tab.

  BODY (only one visible at a time):
    bodyBookingFindClient      — Frame 2 (find client mobile)
    bodyBookingClientForm      — Frame 3 (personal details)
    bodyBookingProfessional    — Profession / Designation / Income
    bodyBookingOffice          — Office Name / Email / Mobile / Phone / Address
    bodyBookingBooking         — Booking Ref / Type / Source / CEF / etc.
    bodyBookingCharges         — Booking Cost / Guideline / SC / Promotional
    bodyBookingPayment         — Reg. Charges / GST / Schedule
    bodyBookingStaff           — AVP / GM / Senior Manager / References / Save as
    bodyComingSoon             — fallback for non-Booking outcomes
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfacePrimary"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!--
          Drag-handle row. The grey bar is the standard bottom-sheet
          handle; making the row itself clickable gives the user a
          large enough tap target to dismiss the sheet from the top
          (drag-to-dismiss stays disabled because nested form scrolls
          used to accidentally trigger it).
        -->
        <FrameLayout
            android:id="@+id/outcomeDragHandleRow"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="#E4E7EC" />
        </FrameLayout>

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Outcome Information"
                    android:textColor="#101828"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvOutcomeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:text="Information about Client Details"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Top tab bar (4 outcomes) with vertical dividers + active underline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/outcomeTopBooking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleOutcomeTopBooking"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_active">

                    <ImageView
                        android:id="@+id/ivOutcomeTopBooking"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_booking" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvOutcomeTopBooking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Booking"
                    android:textColor="#0B61CA"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indicatorOutcomeTopBooking"
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_outcome_tab_indicator" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:background="#F3F3F5" />

            <LinearLayout
                android:id="@+id/outcomeTopSiteVisit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleOutcomeTopSiteVisit"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_inactive">

                    <ImageView
                        android:id="@+id/ivOutcomeTopSiteVisit"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_site_visit" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvOutcomeTopSiteVisit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Site visit"
                    android:textColor="#6A6D78"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indicatorOutcomeTopSiteVisit"
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_outcome_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:background="#F3F3F5" />

            <LinearLayout
                android:id="@+id/outcomeTopPostpone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleOutcomeTopPostpone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_inactive">

                    <ImageView
                        android:id="@+id/ivOutcomeTopPostpone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_postpone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvOutcomeTopPostpone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Postpone"
                    android:textColor="#6A6D78"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indicatorOutcomeTopPostpone"
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_outcome_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:background="#F3F3F5" />

            <LinearLayout
                android:id="@+id/outcomeTopNotInterested"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleOutcomeTopNotInterested"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_outcome_tab_inactive">

                    <ImageView
                        android:id="@+id/ivOutcomeTopNotInterested"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outcome_not_interested" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvOutcomeTopNotInterested"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Not Interested"
                    android:textColor="#6A6D78"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indicatorOutcomeTopNotInterested"
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_outcome_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Booking sub-tabs — horizontally scrollable so all 7 are reachable -->
        <HorizontalScrollView
            android:id="@+id/bookingSubTabsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bookingSubTabsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/subTabClientDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_outcome_subtab_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:text="Client Details"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/subTabProfessionalDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_outcome_subtab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:text="Professional Details"
                    android:textColor="#475467"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/subTabOfficeDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_outcome_subtab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:text="Office Details"
                    android:textColor="#475467"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/subTabBookingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_outcome_subtab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:text="Booking Details"
                    android:textColor="#475467"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/subTabChargesDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_outcome_subtab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:text="Charges Details"
                    android:textColor="#475467"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/subTabPaymentDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_outcome_subtab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:text="Payment Details"
                    android:textColor="#475467"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/subTabStaffDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_outcome_subtab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:text="Staff Details"
                    android:textColor="#475467"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/outcomeBodyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="20dp">

            <!-- Each included layout already has its own root @id (bodyComingSoon,
                 bodyBookingFindClient, etc.) — DO NOT set android:id on the
                 <include> tags or it overrides those inner ids and the
                 Kotlin findViewById() calls return null (which is exactly
                 what made Site visit silently keep showing the Find Client
                 body). -->
            <include layout="@layout/outcome_body_coming_soon" />
            <include layout="@layout/outcome_body_booking_find_client" />
            <include layout="@layout/outcome_body_booking_client_form" />
            <include layout="@layout/outcome_body_booking_professional" />
            <include layout="@layout/outcome_body_booking_office" />
            <include layout="@layout/outcome_body_booking_booking" />
            <include layout="@layout/outcome_body_booking_charges" />
            <include layout="@layout/outcome_body_booking_payment" />
            <include layout="@layout/outcome_body_booking_staff" />
            <include layout="@layout/outcome_body_site_visit" />
            <include layout="@layout/outcome_body_postpone" />
            <include layout="@layout/outcome_body_not_interested" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnCpSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_outcome_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!--
          SV-via-CP locked mode footer: shown only when the CP visit
          carries a `proposedSiteVisit` payload (telecaller pre-fixed
          the SV). Replaces the single Save button with a Reject / Confirm
          pair so the field staff confirms or rejects the telecaller's
          plan without re-entering anything.
        -->
        <LinearLayout
            android:id="@+id/cpLockedFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnCpLockedReject"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outcome_segment_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Reject It"
                android:textColor="#D92D20"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnCpLockedConfirm"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outcome_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Confirm It"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCpError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#D92D20"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
