<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfacePrimary"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="#E4E7EC" />

        <!-- Figma 365:28263 — header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Outcome Information"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_regular"
            android:text="Information about Client Details"
            android:textColor="#667085"
            android:textSize="12sp" />

        <!-- Outcome tab strip (existing horizontal chip row, restyled) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/outcomeChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ── Site Visit details (existing) ───────────────────────────── -->
        <LinearLayout
            android:id="@+id/siteVisitDetailsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Site visit details"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Schedule"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitProject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Select project"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCpSiteVisitDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCpSiteVisitTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="Pick time"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Pickup"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitTravelMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Client travel: Cab required"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etCpSiteVisitPickupAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Pickup address if different"
                android:minLines="2"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitBdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="BDO: keep original"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Sales ownership"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitIncharge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Select SiteIncharge"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitHod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Select HOD"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitAvp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Select AVP"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitGm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Select GM"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCpSiteVisitSeniorManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Select Senior Manager"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Visitors"
                android:textColor="#667085"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etCpSiteVisitVisitorCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="No. of visitors"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/visitorRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/etCpSiteVisitFoodPreference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Food preferences"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Postpone details (figma 414:19622) ──────────────────────── -->
        <LinearLayout
            android:id="@+id/postponeDetailsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Postpone Reasons"
                android:textColor="#475467"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:id="@+id/postponeReasonScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/postponeReasonRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvPostponeReasonsLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Please specify the budget concern"
                android:textColor="#475467"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCpPostponeBudgetConcern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Type here..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:text="What's the timing?"
                android:textColor="#475467"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCpPostponeTiming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Type here..."
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Tell the Project Details"
                android:textColor="#475467"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCpPostponeProjectDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Type here..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Tell Other Details"
                android:textColor="#475467"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCpPostponeOtherDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Type here..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Not Interested details (figma 372:41265) ────────────────── -->
        <LinearLayout
            android:id="@+id/notInterestedDetailsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Why is the client not interested?"
                android:textColor="#475467"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCpNotInterestedNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Type here..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Wait / Interested details ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/waitDetailsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Add notes"
                android:textColor="#475467"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCpWaitNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:fontFamily="@font/inter_medium"
                android:hint="Type here..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorForegroundPrimary"
                android:textColorHint="#98A2B3"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCpError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCpSubmit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_chip_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Submit"
            android:textColor="?attr/colorForegroundInverse"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
