<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Create CP Visit"
            android:textColor="#111827"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etCpClientPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_medium"
            android:hint="Client phone"
            android:inputType="phone"
            android:maxLength="10"
            android:paddingHorizontal="14dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCpClientName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_medium"
            android:hint="Client name"
            android:paddingHorizontal="14dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCpVisitDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_medium"
            android:hint="YYYY-MM-DD"
            android:paddingHorizontal="14dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCpVisitTime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_medium"
            android:hint="Time (optional)"
            android:paddingHorizontal="14dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCpVisitAddress"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_medium"
            android:gravity="top"
            android:hint="Client address"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCpMapsLink"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_medium"
            android:hint="Google Maps link (optional - skip if none)"
            android:paddingHorizontal="14dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCpNotes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_medium"
            android:gravity="top"
            android:hint="Notes (optional)"
            android:padding="14dp"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelCpCreate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="#475467"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSubmitCpCreate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_trip_action_ready"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Create"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
