<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_leave_sheet"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#D3D3D3" />

        <!-- Header Row (Text left, blue car illustration right) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/ivHeaderIllustration"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCompletedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Trip Completed!"
                    android:textColor="#1D2939"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvCompletedSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Great job, Tonald! You've completed this trip."
                    android:textColor="#667085"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivHeaderIllustration"
                android:layout_width="80dp"
                android:layout_height="78dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_driver_trip_completed_car" />
        </RelativeLayout>

        <!-- Main Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_driver_trip_completed_card"
            android:orientation="horizontal"
            android:paddingVertical="18dp"
            android:paddingHorizontal="16dp">

            <!-- START TRIP COLUMN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Start Trip Title Header (Green Circle + Label) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_sheet_blue_circle"
                        android:backgroundTint="#169B2F">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trip_play_white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="START TRIP"
                        android:textColor="#169B2F"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Date & Time -->
                <TextView
                    android:id="@+id/tvStartTripTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="09:30 AM • 09 May 2024"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <!-- KM Reading Rounded box -->
                <LinearLayout
                    android:id="@+id/layoutStartKm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_driver_trip_completed_km_badge"
                    android:backgroundTint="#E8F8EE"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="KM READING"
                            android:textColor="#667085"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvStartKmBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_bold"
                            android:text="12540 Km"
                            android:textColor="#169B2F"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_speedometer_green" />
                </LinearLayout>

                <!-- Dashboard Photo section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="DASHBOARD PHOTO"
                    android:textColor="#667085"
                    android:textSize="9sp" />

                <FrameLayout
                    android:id="@+id/cardStartPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Rounded Photo Corner shape -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivStartPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#F2F4F7"
                            android:scaleType="center"
                            android:src="@drawable/ic_image_outline"
                            app:tint="#98A2B3" />
                    </androidx.cardview.widget.CardView>

                    <!-- Expand icon button at bottom right -->
                    <ImageView
                        android:id="@+id/btnExpandStartPhoto"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:elevation="2dp"
                        android:visibility="gone"
                        android:src="@drawable/ic_expand_arrows" />
                </FrameLayout>
            </LinearLayout>

            <!-- CENTER SEPARATOR WITH BOLT ICON -->
            <RelativeLayout
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_gravity="fill_vertical">

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_centerHorizontal="true"
                    android:background="#E4E7EC" />

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_driver_trip_completed_bolt_circle">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bolt" />
                </FrameLayout>
            </RelativeLayout>

            <!-- END TRIP COLUMN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- End Trip Title Header (Blue Circle + Label) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_sheet_blue_circle"
                        android:backgroundTint="#0B61CA">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trip_stop_white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="END TRIP"
                        android:textColor="#0B61CA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Date & Time -->
                <TextView
                    android:id="@+id/tvEndTripTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="11:45 AM • 09 May 2024"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <!-- KM Reading Rounded box -->
                <LinearLayout
                    android:id="@+id/layoutEndKm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_driver_trip_completed_km_badge"
                    android:backgroundTint="#E1F0FF"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="KM READING"
                            android:textColor="#667085"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvEndKmBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_bold"
                            android:text="12552 Km"
                            android:textColor="#0B61CA"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_speedometer_blue" />
                </LinearLayout>

                <!-- Dashboard Photo section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="DASHBOARD PHOTO"
                    android:textColor="#667085"
                    android:textSize="9sp" />

                <FrameLayout
                    android:id="@+id/cardEndPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Rounded Photo Corner shape -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivEndPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#F2F4F7"
                            android:scaleType="center"
                            android:src="@drawable/ic_image_outline"
                            app:tint="#98A2B3" />
                    </androidx.cardview.widget.CardView>

                    <!-- Expand icon button at bottom right -->
                    <ImageView
                        android:id="@+id/btnExpandEndPhoto"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:elevation="2dp"
                        android:visibility="gone"
                        android:src="@drawable/ic_expand_arrows" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Dynamic Total Distance Display Block -->
        <LinearLayout
            android:id="@+id/layoutDistanceFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_session_card"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_stat_distance"
                app:tint="#0B61CA" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Total Distance"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Calculated difference between odometer values"
                    android:textColor="#667085"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="12.0 Km"
                android:textColor="#0B61CA"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Submit/Close action button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="#0B61CA"
            android:fontFamily="@font/inter_semibold"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
