<?xml version="1.0" encoding="utf-8"?>
<!-- Center-modal popup that fires when the staff taps Clock-In while
     inside their home geofence. White rounded card, close button, the
     "You are at Home!" illustration, a short explainer, and a single
     "Got It" CTA that dismisses. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_fence_dialog_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnHomeFenceClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:background="@drawable/bg_home_fence_close_btn"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_dialog_close" />
        </FrameLayout>

        <!-- Illustration. Vector fallback is at
             res/drawable/img_at_home_warning.xml; drop the final
             3D-rendered PNG into res/drawable-nodpi/ with the same
             filename and Android will prefer it automatically. -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:src="@drawable/img_at_home_warning" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="You are at Home!"
            android:textColor="#101828"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.3"
            android:text="You can’t clock in while at home.\nPlease try clocking in at your workplace."
            android:textColor="#475467"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHomeFenceGotIt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_home_fence_got_it_btn"
            android:fontFamily="@font/inter_semibold"
            android:text="Got It"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
