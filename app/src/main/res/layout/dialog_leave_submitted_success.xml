<?xml version="1.0" encoding="utf-8"?>
<!--
  Success modal shown after a leave is created. Same blue stacked-layers
  badge as the confirm dialog (matches the new design where both modals
  share the icon). Body copy and CTA wording follow the design verbatim
  — including the design's "View Leave Approves" label.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_apply_leave_sheet"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="70dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Leave Submitted!"
            android:textColor="#101828"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="Your leave request has been sent for review!\nWait for HR to review your request."
            android:textColor="#667085"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnViewLeaveApproved"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_apply_leave_btn_enabled"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="View Leave Approved"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Blue layer chip centered overlapping top border by exactly 50% -->
    <ImageView
        android:layout_width="106dp"
        android:layout_height="130dp"
        android:layout_gravity="center_horizontal|top"
        android:contentDescription="@null"
        android:src="@drawable/ic_leave_confirm_layer" />
</FrameLayout>
