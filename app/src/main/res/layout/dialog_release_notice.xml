<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_release_notice_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <FrameLayout
            android:layout_width="162dp"
            android:layout_height="94dp"
            android:background="@drawable/bg_release_notice_logo_plate">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:contentDescription="@string/release_notice_logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/manju_groups_lockup" />
        </FrameLayout>

        <ImageView
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/release_notice_illustration_description"
            android:scaleType="fitCenter"
            android:src="@drawable/release_notice_apology" />

        <TextView
            android:id="@+id/tvReleaseNoticeLabel"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_release_notice_badge"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:textColor="?attr/colorInfo"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvReleaseNoticeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/tvReleaseNoticeTamilTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorInfo"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvReleaseNoticeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/releaseNoticeHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvReleaseNoticeAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnReleaseNoticeContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_home_trip_action_ready"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/release_notice_continue"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
