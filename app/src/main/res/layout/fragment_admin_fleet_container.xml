<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Fragment Host Container -->
    <FrameLayout
        android:id="@+id/adminFleetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F3F8" />

    <!-- Fade/blur overlay behind bottom navigation bar -->
    <View
        android:id="@+id/bottomNavFadeOverlay"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_fade_grey"
        android:clickable="false"
        android:focusable="false" />

    <!-- Floating bottom navigation bar matching MainActivity styling but lifted -->
    <FrameLayout
        android:id="@+id/tabBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_tab_bar"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- TRIPS tab -->
            <FrameLayout
                android:id="@+id/tabTrips"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabTripsIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Trips"
                        android:src="@drawable/ic_admin_tab_trips" />

                    <TextView
                        android:id="@+id/tabTripsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Trips"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- VEHICLES tab -->
            <FrameLayout
                android:id="@+id/tabVehicles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabVehiclesIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Vehicles"
                        android:src="@drawable/ic_admin_tab_vehicles" />

                    <TextView
                        android:id="@+id/tabVehiclesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Vehicles"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- DRIVER tab -->
            <FrameLayout
                android:id="@+id/tabDriver"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabDriverIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Driver"
                        android:src="@drawable/ic_admin_tab_driver" />

                    <TextView
                        android:id="@+id/tabDriverText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Driver"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- SETTINGS tab -->
            <FrameLayout
                android:id="@+id/tabStaff"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabStaffIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Staff"
                        android:src="@drawable/ic_chat_users" />

                    <TextView
                        android:id="@+id/tabStaffText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Staff"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- SETTINGS tab -->
            <FrameLayout
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tabSettingsIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Settings"
                        android:src="@drawable/ic_admin_tab_settings" />

                    <TextView
                        android:id="@+id/tabSettingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Settings"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
