<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollAdminTrips"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Reusable Header Component -->
        <com.manjugroups.m_connect.ui.custom.HomeHeaderView
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Content area: "Todays Trips" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Todays Trips"
                android:textColor="#111827"
                android:textSize="18sp" />

            <!-- Toggle selector tabs: Pending / Assigned / Completed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_admin_trips_tabs_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnTabPending"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_my_trips_tab_active"
                    android:backgroundTint="#0B61CA"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="Pending"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnTabAssigned"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="Assigned"
                    android:textColor="#475467"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnTabCompleted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="Completed"
                    android:textColor="#475467"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Trips RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminTrips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
