<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfacePrimary"
    android:orientation="vertical">

    <!-- Header (Relative layout so title and date are centered) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfacePrimary"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/frame_21472"
            android:src="@drawable/ic_back_blue"
            android:scaleType="centerInside"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_toEndOf="@id/btnBack"
            android:layout_toStartOf="@id/btnAttendanceFilter"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:maxLines="1"
                android:singleLine="true"
                android:text="My Attendance"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#0B61CA"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAttendanceSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_toStartOf="@id/btnAttendanceFilter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:background="@drawable/frame_21472"
            android:src="@drawable/ic_attendance_search"
            android:scaleType="centerInside"
            android:contentDescription="Search"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnAttendanceFilter"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/frame_21472"
            android:src="@drawable/ic_filter_blue"
            android:scaleType="centerInside"
            android:contentDescription="Filter"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Search bar (Expandable/Toggleable) -->
    <FrameLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_bar"
            android:drawablePadding="10dp"
            android:fontFamily="@font/inter_regular"
            android:hint="Search team members..."
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorForegroundPrimary"
            android:textColorHint="?attr/colorForegroundMuted"
            android:textCursorDrawable="@null"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Summary stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <!-- Top Row: Icon + Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock_gradient_blue"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Present"
                    android:textColor="#0B61CA"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bottom Row: Count -->
            <TextView
                android:id="@+id/tvTotalDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_bold"
                android:text="0"
                android:textColor="#1BCA0B"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <!-- Top Row: Icon + Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock_gradient_blue"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Total Hours"
                    android:textColor="#0B61CA"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bottom Row: Count -->
            <TextView
                android:id="@+id/tvTotalHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_bold"
                android:text="00:00 Hrs"
                android:textColor="#1BCA0B"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Scrollable Tabs -->
    <com.manjugroups.m_connect.ui.common.HorizontalTabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Sub-tabs for Approvals/HR Review (Attendance vs Request) -->
    <LinearLayout
        android:id="@+id/layoutSubTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_review_tab_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/subTabAttendance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_review_tab_active"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Attendance"
                android:textColor="#0B61CA"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/subTabRequest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Request"
                android:textColor="#667085"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Attendance list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/attendanceRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/attendanceScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/attendanceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="40dp" />
            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.manjugroups.m_connect.ui.common.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            android:visibility="gone"
            app:es_image="@drawable/ic_leave_empty"
            app:es_title="No records found"
            app:es_description="Check back later for new updates." />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_nav_fade_white"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/skeletonContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfacePrimary"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:visibility="gone">

            <include layout="@layout/skeleton_attendance_card" />
            <include layout="@layout/skeleton_attendance_card" />
            <include layout="@layout/skeleton_attendance_card" />
            <include layout="@layout/skeleton_attendance_card" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
