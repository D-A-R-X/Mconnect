<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_home_new_action_circle"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back_chevron"
                    app:tint="#004EEB" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/headerAvatarContainer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chat_avatar_circle"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                
                <ImageView
                    android:id="@+id/ivHeaderAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvHeaderAvatarInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="?attr/colorAccentPrimary"
                    android:textSize="12sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/titleGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintStart_toEndOf="@id/headerAvatarContainer"
                app:layout_constraintEnd_toStartOf="@id/btnPhone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#101828"
                    android:textSize="17sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Team Design" />

                <TextView
                    android:id="@+id/tvChatSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="#667085"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    tools:text="Last seen Today 11:30AM" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnChatHeaderMenu"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/btnPhone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_home_new_action_circle"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toStartOf="@id/btnSearch"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone_outline"
                    app:tint="#004EEB" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_home_new_action_circle"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat_search"
                    app:tint="#004EEB" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/inlineSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btnInlineSearchClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Close search"
                    android:src="@drawable/ic_back_chevron"
                    app:tint="#101828" />
            </FrameLayout>

            <EditText
                android:id="@+id/etInlineSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_regular"
                android:hint="Search in this chat"
                android:importantForAutofill="no"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvInlineSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#667085"
                android:textSize="12sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnInlineSearchPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Previous match"
                    android:rotation="90"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="#101828" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnInlineSearchNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Next match"
                    android:rotation="-90"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="#101828" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectionToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B61CA"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btnSelectionCancel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cancel"
                    android:src="@drawable/ic_back_chevron"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:text="1 selected"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <FrameLayout
                android:id="@+id/btnSelectionReply"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Reply"
                    android:src="@drawable/ic_chat_reply"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSelectionStar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Star"
                    android:src="@drawable/ic_chat_star"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSelectionInfo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Info"
                    android:src="@drawable/ic_chat_info"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSelectionDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Delete"
                    android:src="@drawable/ic_chat_delete"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSelectionForward"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Forward"
                    android:src="@drawable/ic_chat_forward"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAECF0" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_pattern">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="0dp" />

            <!-- Legacy attach menu hooks kept hidden for binding compatibility -->
            <View
                android:id="@+id/attachmentMenu"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/menuAttachFile"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/menuAttachMedia"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <View
                android:id="@+id/menuAttachCamera"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        <LinearLayout
            android:id="@+id/skeletonContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="end"
            android:orientation="vertical"
            android:background="#F1F3F8"
            android:visibility="gone">

            <include layout="@layout/skeleton_message_sent"/>
            <include layout="@layout/skeleton_message_received"/>
            <include layout="@layout/skeleton_message_sent"/>
            <include layout="@layout/skeleton_message_received"/>
            <include layout="@layout/skeleton_message_sent"/>
            <include layout="@layout/skeleton_message_received"/>
        </LinearLayout>
        </FrameLayout>

        <!-- Mentions Popup -->
        <androidx.cardview.widget.CardView
            android:id="@+id/mentionsCard"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Mention a person"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMentions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <HorizontalScrollView
            android:id="@+id/selectedAttachmentsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/selectedAttachmentsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Reply Preview -->
        <androidx.cardview.widget.CardView
            android:id="@+id/replyPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#0B61CA" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvReplyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#0B61CA"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvReplyBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#667085"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/btnCancelReply"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sheet_close"
                    app:tint="#667085" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom toolbar container -->
        <FrameLayout
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:id="@+id/btnAttach"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_home_new_action_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivAttachIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat_plus"
                        app:tint="#475467" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_input_pill">

                    <EditText
                        android:id="@+id/etMessage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Message ..."
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="4"
                        android:paddingStart="16dp"
                        android:paddingEnd="76dp"
                        android:textColor="#101828"
                        android:textColorHint="#98A2B3"
                        android:textCursorDrawable="@null"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnInputCamera"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Camera"
                            android:src="@drawable/ic_header_camera_outline"
                            app:tint="#98A2B3"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                        <ImageView
                            android:id="@+id/btnEmoji"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Emoji"
                            android:src="@drawable/ic_chat_emoji"
                            app:tint="#98A2B3"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnSend"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chat_send_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivSendIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat_mic"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <!-- Recording overlay -->
            <RelativeLayout
                android:id="@+id/recordingOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Recording Status (Dot + Timer) Container -->
                <LinearLayout
                    android:id="@+id/recordingStatusContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Red blinking dot / recording indicator -->
                    <ImageView
                        android:id="@+id/ivRecordingDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/bg_loan_track_active"
                        app:tint="#F04438" />

                    <!-- Recording Timer -->
                    <TextView
                        android:id="@+id/tvRecordingTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#F04438"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="00:00" />
                </LinearLayout>

                <!-- Slide to cancel text container -->
                <LinearLayout
                    android:id="@+id/slideCancelContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSlideCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#98A2B3"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:text="◀  Slide to cancel" />
                </LinearLayout>

                <!-- Trash Can Container on the left -->
                <FrameLayout
                    android:id="@+id/trashCanContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:alpha="0">

                    <ImageView
                        android:id="@+id/ivTrash"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_trash"
                        app:tint="#98A2B3" />
                </FrameLayout>

                <!-- Animating Mic that moves to the left -->
                <FrameLayout
                    android:id="@+id/animatingMicContainer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/bg_chat_send_circle"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivAnimatingMic"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat_mic"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </RelativeLayout>

        </FrameLayout>

        <!-- WhatsApp-style attach panel: occupies the keyboard slot so the
             chat input stays anchored in place and the grid simply replaces
             the IME — no floating card, no extra margins. -->
        <FrameLayout
            android:id="@+id/attachPanel"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <include layout="@layout/bottom_sheet_attach_grid" />
        </FrameLayout>

        <!-- Emoji Panel (below input section, like WhatsApp keyboard slot) -->
        <FrameLayout
            android:id="@+id/emojiPanel"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/emojiPickerContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/btnCloseEmojiPanel"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
