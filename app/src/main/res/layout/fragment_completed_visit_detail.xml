<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:orientation="vertical">

    <!-- TOP BAR -->
    <FrameLayout
        android:id="@+id/cvdTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btnCvdBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="#0B61CA" />

        <TextView
            android:id="@+id/tvCvdTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="Visit Details"
            android:textColor="#101828"
            android:textSize="17sp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEF0F5" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cvdScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- ── Status banner ────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cvdStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_trip_status_ready"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_trip_status_dot" />

                    <TextView
                        android:id="@+id/tvCvdStatusLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="Completed"
                        android:textColor="#169B2F"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCvdStatusSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Visit completed"
                    android:textColor="#101828"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCvdStatusSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:text="Outcome captured for this client visit"
                    android:textColor="#667085"
                    android:textSize="12sp" />

                <!--
                  "Record Outcome" CTA — appears only when the visit
                  completed without an outcome being recorded (sheet
                  dismissed, app crash, OS kill). Tap reopens the
                  CompleteCpVisitBottomSheet so the staff can finish
                  the outcome flow. Hidden by default; the fragment
                  toggles visibility based on the loaded data.
                -->
                <TextView
                    android:id="@+id/btnCvdRecordOutcome"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_home_trip_action_ready"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Record Outcome"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Client / Place identity ────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cvdClientCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Client"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCvdClientInitial"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_home_trip_avatar"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="C"
                        android:textColor="#475467"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCvdClientName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="Client name"
                            android:textColor="#101828"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCvdClientPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="?attr/selectableItemBackground"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="#667085"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Lead extras (city + preferred area) — surfaced when the
                     enriched lead/client doc carries them. -->
                <LinearLayout
                    android:id="@+id/cvdLeadExtrasRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="City"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdLeadCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="Preferred area"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdLeadPreferredArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/cvdClientDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#F2F4F7" />

                <TextView
                    android:id="@+id/tvCvdAddressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Address"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCvdAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="—"
                    android:textColor="#101828"
                    android:textSize="13sp" />

                <!-- "Open lead in dialer →" — only visible when the lead has a
                     phone we can dial. -->
                <TextView
                    android:id="@+id/tvCvdOpenInDialer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Open lead in dialer →"
                    android:textColor="#0B61CA"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Schedule + trip type grid ─────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Visit"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="Date"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="Time"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="Trip type"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdTripType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="Location"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Origin (e.g. "Telecaller", "Walk-in", "Campaign") — added when
                     the enriched detail carries it. -->
                <LinearLayout
                    android:id="@+id/cvdOriginRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:text="Origin"
                        android:textColor="#667085"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvCvdOrigin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="#101828"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Client met section ────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cvdClientMetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Meeting"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCvdClientMetIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cpv_action_completed" />

                    <TextView
                        android:id="@+id/tvCvdClientMetLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="Client met"
                        android:textColor="#101828"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCvdClientMetNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="32dp"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="—"
                    android:textColor="#475467"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Outcome section ───────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cvdOutcomeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Outcome"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCvdOutcomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_completed_outcome_pill"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="—"
                    android:textColor="#0369A1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCvdPostponeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="Postpone reasons"
                    android:textColor="#667085"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/cvdPostponeChipScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/cvdPostponeChipRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ── Arrival proof (photo + OTP + GPS) ──────────────────── -->
            <LinearLayout
                android:id="@+id/cvdArrivalProofCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:text="Arrival proof"
                        android:textColor="#667085"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvCvdArrivalCapturedPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_trip_status_ready"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="Captured"
                        android:textColor="#169B2F"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="Captured by the field staff app via the existing fieldVisit workflow — photo + OTP timestamp + GPS."
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivCvdArrivalPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp"
                    android:adjustViewBounds="true"
                    android:background="#F2F4F7"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <!-- Description / notes attached to the arrival proof.
                     Hidden unless the visit has clientNoShowReason or
                     general notes — the salesperson's free-text context
                     for what happened at the gate. -->
                <TextView
                    android:id="@+id/tvCvdArrivalDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_outcome_field_readonly"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text=""
                    android:textColor="#344054"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="OTP verified"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdOtpVerifiedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="OTP requested"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdOtpRequestedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="GPS"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdGpsCoords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false"
                            android:text="Distance from place"
                            android:textColor="#667085"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCvdGpsDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="#101828"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── People (Field staff + Telecaller) ─────────────────── -->
            <LinearLayout
                android:id="@+id/cvdPeopleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="People"
                    android:textColor="#667085"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/cvdFieldStaffRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:text="Field staff"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCvdFieldStaffName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="#101828"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cvdTelecallerRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:text="Telecaller"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCvdTelecallerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="#101828"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Timeline ──────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cvdTimelineCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_completed_section_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Timeline"
                    android:textColor="#101828"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/cvdTimelineRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvCvdTimelineEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="No timeline events recorded."
                    android:textColor="#667085"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
