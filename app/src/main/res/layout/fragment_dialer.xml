<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfacePrimary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnDialerBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/colorForegroundPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:singleLine="true"
            android:text="Dialer"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDialerConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:padding="6dp"
            android:text="Connecting"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Modern Dialer identity and availability controls. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_task_inner_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDialerAgent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Modern Dialer"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDialerStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_regular"
            android:text="Checking your dialer access..."
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_attendance_segment_container"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnDialerAvailable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_attendance_segment_active"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Available"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnDialerBreak"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="Break"
                android:textColor="?attr/colorForegroundMuted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Modern Dialer live call controls, driven by the same embed events as web. -->
    <LinearLayout
        android:id="@+id/dialerCallPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_task_inner_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDialerCallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDialerCallPeer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/geist_mono_semibold"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/dialerPrimaryControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDialerPickup"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dialer_call"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Accept"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnDialerHangup"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_error"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Hang up"
                android:textColor="?attr/colorError"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dialerSecondaryControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDialerMute"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_task_inner_card"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="Mute"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDialerHold"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_task_inner_card"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="Hold"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dialerAudioRoutes"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_attendance_segment_container"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnDialerPhoneAudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_attendance_segment_active"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="Phone"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnDialerSpeakerAudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="Speaker"
                android:textColor="?attr/colorForegroundMuted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnDialerBluetoothAudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="Bluetooth"
                android:textColor="?attr/colorForegroundMuted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phone display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDialerNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:fontFamily="@font/geist_mono_semibold"
            android:gravity="center"
            android:hint="Enter number"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/colorForegroundPrimary"
            android:textColorHint="?attr/colorForegroundMuted"
            android:textSize="32sp" />

        <ImageView
            android:id="@+id/btnDialerBackspace"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Backspace"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_left"
            android:visibility="invisible"
            app:tint="?attr/colorForegroundMuted" />
    </LinearLayout>

    <!-- Dialpad — 4 rows × 3 cols of LinearLayouts; rows + cells filled at runtime -->
    <LinearLayout
        android:id="@+id/dialpadGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="22dp"
        android:orientation="vertical" />

    <!-- Call button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="20dp"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/btnDialerCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialer_call"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDialerCallIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Call"
                android:src="@drawable/ic_phone_outline"
                app:tint="@android:color/white" />

            <View
                android:id="@+id/dialerCallingSkeleton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_skeleton_circle_inverse"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Recent calls"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDialerHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_regular"
            android:text="No recent calls"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/dialerHistoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
