<?xml version="1.0" encoding="utf-8"?>
<!--
  GM Handoffs queue (KOS-XX). Drives `GET /api/marketing/clientPlaceVisits/
  gm-handoffs` — the signed-in user is treated as the gmHandlerStaffId.
  Immediate-pickup rows are pinned to the top server-side; rendered with
  a red "Urgent" pill on the row.

  Tap a row → CompletedVisitDetailFragment with the visit's CP id. The
  triage banner there carries the 3 actions (Confirm SV / Reject —
  financial / Shift to project).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfacePrimary"
    android:orientation="vertical">

    <!-- Top bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfacePrimary">

        <ImageView
            android:id="@+id/btnGmHandoffsBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/colorForegroundPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="GM Handoffs"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvGmHandoffsUrgentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0 urgent"
            android:textColor="?attr/colorError"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorBorder" />

    <!-- Skeleton while loading -->
    <LinearLayout
        android:id="@+id/gmHandoffsSkeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_leave_skeleton_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_leave_skeleton_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_leave_skeleton_block" />
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/gmHandoffsEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Inbox zero"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="No telecaller handoffs waiting on you right now."
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- List -->
    <ScrollView
        android:id="@+id/gmHandoffsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/gmHandoffsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>
</LinearLayout>
