<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8">

    <!-- Header + scroll panel OVERLAP inside a touch-routing container. The
         header (drawn first = behind) stays pinned; the full-height scroll
         panel (drawn second = in front) slides its white content up over the
         blue. HomeTouchRouterLayout sends touches on the visible header to
         the header, and touches where the content has scrolled over it to the
         scroll panel — so the header buttons AND the scrolled-over tabs both
         work. -->
    <com.manjugroups.m_connect.ui.custom.HomeTouchRouterLayout
        android:id="@+id/homeStickyColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

            <!-- REUSABLE BLUE HEADER SECTION (pinned, behind the scroll panel) -->
            <com.manjugroups.m_connect.ui.custom.HomeHeaderView
                android:id="@+id/homeHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top" />


    <!-- Refreshable scrolling content area — sits BELOW the sticky blue
         header but overlaps it by -20dp so the panel's rounded top
         corners curve up cleanly into the blue (matches the Inspection
         page pattern). The white panel background + rounded top corners
         are applied at runtime in setupHomeScrollAnimation(), so when
         the panel translates up on scroll the WHOLE blue header is
         covered by white. clipToOutline=true bounds inner content to
         the rounded shape. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/homeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.manjugroups.m_connect.ui.custom.HomeScrollView
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="blocksDescendants"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="120dp">

            <LinearLayout
                android:id="@+id/homeScrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

            <!-- Transparent spacer sized to the header at runtime, so the white
                 Overview panel starts just below the pinned header at rest and
                 scrolls up over it. -->
            <View
                android:id="@+id/homeHeaderSpacer"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <!-- Section container — sits on the panel's white surface
                 (the panel itself now carries the white bg + rounded
                 top corners, applied at runtime, overlapping the blue
                 header by -20dp). paddingTop pushes the "Today's Trip"
                 title clear of the rounded-corner curve at the top. -->
            <LinearLayout
                android:id="@+id/whiteContentArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <include
                    android:id="@+id/homeOverviewInclude"
                    layout="@layout/layout_home_overview" />

                <LinearLayout
                    android:id="@+id/cardTodayVisit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <!-- Sticky trip header (title + tabs). Solid page-grey bg +
                         a runtime elevation so the trip cards scroll UNDER it
                         once the drawer reaches its limit — the profile/notify
                         header above stays visible instead of being covered. -->
                    <LinearLayout
                        android:id="@+id/tripHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F1F3F8"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tvVisitSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="Today's Trip"
                            android:textColor="#101828"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/ivVisitTitleGlobe"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="9dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_today_trip_globe" />

                        <TextView
                            android:id="@+id/tvVisitCountBadge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_home_today_visit_count_badge"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textColor="#7A5AF8"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- VP dashboard date filter — visible only in the
                             KPI-dashboard branch; tapping opens a date picker
                             and every tile re-fetches for that day. -->
                        <LinearLayout
                            android:id="@+id/btnDashDateFilter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pagination_size_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="6dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="Pick dashboard date"
                                android:src="@drawable/ic_calendar_days"
                                android:tint="#475467" />

                            <TextView
                                android:id="@+id/tvDashDateFilter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="Today"
                                android:textColor="#344054"
                                android:textSize="12.5sp" />

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@null"
                                android:rotation="270"
                                android:src="@drawable/ic_calendar_chevron_left"
                                android:tint="#667085" />
                        </LinearLayout>

                        <!--
                          Role dropdown removed — Driver vs Executive view
                          is now derived from the logged-in staff's
                          designation (see SessionManager.isDriverMode +
                          HomeFragment.setupRoleAdaptiveView). Mirrors the
                          web's hasDriverDesignation check; no manual
                          override surface.
                        -->
                    </LinearLayout>

                    <!-- Trip filter. Transport drivers get All / Upcoming /
                         Completed over their own trips; fleet administrators
                         get Pending / Assigned / Completed over the whole
                         allocation queue (relabelled + restyled at runtime as
                         the segmented control used on the fleet screen). -->
                    <LinearLayout
                        android:id="@+id/layoutDriverTabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tabAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_cpv_filter_pill_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="All"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tabUpcoming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_cpv_filter_pill_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="Upcoming"
                            android:textColor="#344054"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tabCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_cpv_filter_pill_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="Completed"
                            android:textColor="#344054"
                            android:textSize="12sp" />
                    </LinearLayout>
                    </LinearLayout><!-- /tripHeader -->

                    <!-- Scrollable trip cards — slide up UNDER tripHeader once
                         the drawer is pinned below the profile row. -->
                    <LinearLayout
                        android:id="@+id/tripCardsArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false">

                    <LinearLayout
                        android:id="@+id/visitEmptyContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_home_trip_card"
                        android:orientation="vertical"
                        android:padding="0dp"
                        android:visibility="gone">

                        <!-- The "Today Trip / Your schedule for the day" header
                             was removed here: it duplicated the "Today's Trip"
                             section title just above the card. -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="20dp">

                            <ImageView
                                android:id="@+id/ivVisitEmptyState"
                                android:layout_width="152dp"
                                android:layout_height="142dp"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_home_empty_trips" />

                            <TextView
                                android:id="@+id/tvVisitEmptyTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:lineHeight="24dp"
                                android:text="No Trips Available"
                                android:textColor="#161B23"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvVisitEmptySubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter_regular"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:lineSpacingMultiplier="1.3"
                                android:text="It looks like you don't have any meetings scheduled at the moment.\nThis space will be updated as new meetings are added!"
                                android:textColor="#777F8C"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/visitListContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/visitSkeletonContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="86dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_home_today_visit_item"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <View
                                android:layout_width="170dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />

                            <View
                                android:layout_width="110dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />

                            <View
                                android:layout_width="74dp"
                                android:layout_height="10dp"
                                android:layout_gravity="end"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout><!-- /tripCardsArea -->
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.manjugroups.m_connect.ui.custom.HomeScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.manjugroups.m_connect.ui.custom.HomeTouchRouterLayout>

    <LinearLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F3F8"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Blue header band — same height as the real Home header. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_home_blue_header" />

        <!-- Content: "Today's Trip" heading + a trip-card placeholder, so
             the skeleton mirrors the actual Home layout instead of the old
             generic avatar/lines block. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp">

            <View
                android:layout_width="130dp"
                android:layout_height="18dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <include layout="@layout/skeleton_trip_card" />
        </LinearLayout>
    </LinearLayout>

    <!-- First-time Tour Dim Backdrop -->
    <View
        android:id="@+id/edgeQrTourDimBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:elevation="14dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- First-time Tooltip -->
    <LinearLayout
        android:id="@+id/edgeQrTooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_tooltip_bubble"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:elevation="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:text="Swipe left or tap to open QR Scanner"
            android:textColor="#1E293B"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btnDismissTooltip"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_close_pill"
            app:tint="#64748B"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Edge Drag QR Handle and Panel -->
    <!-- Handle (thin vertical tab on the right edge) -->
    <FrameLayout
        android:id="@+id/edgeDragHandle"
        android:layout_width="24dp"
        android:layout_height="80dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_edge_handle"
        android:clickable="true"
        android:focusable="true"
        android:elevation="15dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_chevron_left"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Overlay Panel (Full Screen, initially hidden) -->
    <FrameLayout
        android:id="@+id/edgeQrPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp">

        <!-- Blur/Dim background overlay -->
        <View
            android:id="@+id/panelBlurBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60F172A" />

        <!-- Content Container -->
        <FrameLayout
            android:id="@+id/panelContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Rounded QR Button in the middle -->
            <LinearLayout
                android:id="@+id/btnOverlayQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_glass_qr_button"
                android:paddingHorizontal="40dp"
                android:paddingVertical="32dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_apps_qr_scanner"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Scan QR Code"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Tap to open Front Desk Scanner"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>
            
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
