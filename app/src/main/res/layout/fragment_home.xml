<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/homeHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_blue_header"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/homeProfileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/btnHomeProfile"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_home_header_avatar"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvAvatarInitial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvHeaderName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_semibold"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="0.01"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="8dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_verified_badge" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvHeaderRole"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="@font/inter_medium"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.04"
                                android:textColor="#CFDBEC"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnHomeBell"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_home_header_bell"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home_bell_exact"
                            android:tint="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvBellBadge"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tab_active"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="8sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/cardWorkSummary"
                    android:layout_width="match_parent"
                    android:layout_height="144dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <TextView
                        android:id="@+id/tvSummaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="-0.02"
                        android:text="Plan, Visit &amp; Achieve"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvSummarySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="44dp"
                        android:fontFamily="@font/inter_medium"
                        android:letterSpacing="-0.01"
                        android:lineSpacingExtra="2dp"
                        android:text="Track your tasks, visits and\nattendance in one place."
                        android:textColor="#EDEAFF"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="42dp"
                        android:layout_marginEnd="86dp"
                        android:contentDescription="@null"
                        android:rotation="30"
                        android:src="@drawable/ic_home_summary_star" />

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="55dp"
                        android:contentDescription="@null"
                        android:rotation="-19"
                        android:src="@drawable/ic_home_summary_star" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="76dp"
                        android:layout_marginEnd="66dp"
                        android:contentDescription="@null"
                        android:rotation="18"
                        android:src="@drawable/ic_home_summary_star" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="38dp"
                        android:contentDescription="@null"
                        android:rotation="-9"
                        android:src="@drawable/ic_home_summary_star" />

                    <ImageView
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="36dp"
                        android:layout_marginEnd="74dp"
                        android:contentDescription="@null"
                        android:rotation="-20"
                        android:src="@drawable/ic_home_summary_star" />

                    <ImageView
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="82dp"
                        android:layout_marginEnd="46dp"
                        android:contentDescription="@null"
                        android:rotation="-20"
                        android:src="@drawable/ic_home_summary_star" />

                    <ImageView
                        android:id="@+id/ivBannerAnimation"
                        android:layout_width="118dp"
                        android:layout_height="100dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cameraiconhomebanner" />

                    <FrameLayout
                        android:id="@+id/btnViewSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_home_view_summary_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.01"
                            android:text="View My Summary"
                            android:textColor="#0B61CA"
                            android:textSize="11sp" />
                    </FrameLayout>
                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/whiteContentArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F1F3F8"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/cardTodayVisit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tvVisitSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="Today&#39;s Trip"
                            android:textColor="#101828"
                            android:textSize="20sp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="9dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_today_trip_globe" />

                        <TextView
                            android:id="@+id/tvVisitCountBadge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_home_today_visit_count_badge"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textColor="#7A5AF8"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvVisitSectionSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:visibility="gone"
                        android:text="Your schedule for the day"
                        android:textColor="#475467"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/visitEmptyContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_home_trip_card"
                        android:orientation="vertical"
                        android:padding="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:lineHeight="20dp"
                                android:text="Today&#39;s Trip"
                                android:textColor="#101828"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false"
                                android:text="Your schedule for the day"
                                android:textColor="#667085"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="20dp">

                            <ImageView
                                android:id="@+id/ivVisitEmptyState"
                                android:layout_width="152dp"
                                android:layout_height="142dp"
                                android:alpha="0.56"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_home_empty_trips" />

                            <TextView
                                android:id="@+id/tvVisitEmptyTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:lineHeight="24dp"
                                android:textColor="#161B23"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvVisitEmptySubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter_regular"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:lineSpacingMultiplier="1.3"
                                android:textColor="#777F8C"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/visitListContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/visitSkeletonContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="86dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_home_today_visit_item"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <View
                                android:layout_width="170dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />

                            <View
                                android:layout_width="110dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />

                            <View
                                android:layout_width="74dp"
                                android:layout_height="10dp"
                                android:layout_gravity="end"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="86dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_home_today_visit_item"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <View
                                android:layout_width="140dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />

                            <View
                                android:layout_width="74dp"
                                android:layout_height="10dp"
                                android:layout_gravity="end"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F3F8"
        android:orientation="vertical"
        android:visibility="gone">

        <include layout="@layout/skeleton_profile_item" />

        <include layout="@layout/skeleton_detail_item" />

        <include layout="@layout/skeleton_detail_item" />

        <include layout="@layout/skeleton_list_item" />

        <include layout="@layout/skeleton_list_item" />

        <include layout="@layout/skeleton_list_item" />
    </LinearLayout>
</FrameLayout>
