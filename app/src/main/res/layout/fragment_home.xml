<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEEF3">

    <ProgressBar
        android:id="@+id/homeLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminateTint="#6C61F7" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/homeHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FEFEFE"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/btnHomeProfile"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_home_new_avatar_circle"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvAvatarInitial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="#4C566E"
                                android:textSize="15sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvHeaderName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:letterSpacing="0.01"
                                    android:textColor="#2D2D2D"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="8dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_verified_badge" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvHeaderRole"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="@font/inter_medium"
                                android:letterSpacing="-0.04"
                                android:textColor="#6E62FF"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnHomeBell"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_home_new_action_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home_bell_exact" />

                        <TextView
                            android:id="@+id/tvBellBadge"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tab_active"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="8sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="18dp">

            <FrameLayout
                android:id="@+id/cardWorkSummary"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_home_new_summary_card"
                android:clipChildren="true"
                android:clipToPadding="true">

                <TextView
                    android:id="@+id/tvSummaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="28dp"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="-0.02"
                    android:text="My Work Summary"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSummarySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="50dp"
                    android:fontFamily="@font/inter_medium"
                    android:letterSpacing="-0.01"
                    android:textColor="#EDEAFF"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="47dp"
                    android:layout_marginEnd="76dp"
                    android:contentDescription="@null"
                    android:rotation="30"
                    android:src="@drawable/ic_home_summary_star" />

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="49dp"
                    android:contentDescription="@null"
                    android:rotation="-19"
                    android:src="@drawable/ic_home_summary_star" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="73dp"
                    android:layout_marginEnd="60dp"
                    android:contentDescription="@null"
                    android:rotation="18"
                    android:src="@drawable/ic_home_summary_star" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="17dp"
                    android:layout_marginEnd="33dp"
                    android:contentDescription="@null"
                    android:rotation="-9"
                    android:src="@drawable/ic_home_summary_star" />

                <ImageView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="36dp"
                    android:layout_marginEnd="66dp"
                    android:contentDescription="@null"
                    android:rotation="-20"
                    android:src="@drawable/ic_home_summary_star" />

                <ImageView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="72dp"
                    android:layout_marginEnd="39dp"
                    android:contentDescription="@null"
                    android:rotation="-20"
                    android:src="@drawable/ic_home_summary_star" />

                <ImageView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="29dp"
                    android:layout_marginEnd="44dp"
                    android:contentDescription="@null"
                    android:rotation="-20"
                    android:src="@drawable/ic_home_summary_star" />

                <ImageView
                    android:layout_width="101dp"
                    android:layout_height="85dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="13dp"
                    android:layout_marginEnd="-20dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cameraiconhomebanner" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/cardTodayVisit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_home_new_visit_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvVisitSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="Today Visits"
                        android:textColor="#101828"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvVisitCountBadge"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_home_today_visit_count_badge"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="#7A5AF8"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVisitSectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:text="Your schedule for the day"
                    android:textColor="#475467"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/visitEmptyContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/ivVisitEmptyState"
                        android:layout_width="126dp"
                        android:layout_height="86dp"
                        android:background="@drawable/bg_home_visit_empty_image_box"
                        android:padding="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_home_visit_empty_cell">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_visit_empty_user" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_home_visit_empty_cell">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_visit_empty_user" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_home_visit_empty_cell">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_visit_empty_user" />
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_home_visit_empty_cell">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_visit_empty_user" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_home_visit_empty_cell">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_visit_empty_user" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_home_visit_empty_cell">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_home_visit_empty_user" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvVisitEmptyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.72"
                        android:textColor="#161B23"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvVisitEmptySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.3"
                        android:maxLines="2"
                        android:textColor="#777F8C"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/visitListContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/visitSkeletonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_home_today_visit_item"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <View
                            android:layout_width="170dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_attendance_skeleton_block" />

                        <View
                            android:layout_width="110dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_attendance_skeleton_block" />

                        <View
                            android:layout_width="74dp"
                            android:layout_height="10dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_attendance_skeleton_block" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="86dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_home_today_visit_item"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_attendance_skeleton_block" />

                        <View
                            android:layout_width="90dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_attendance_skeleton_block" />

                        <View
                            android:layout_width="74dp"
                            android:layout_height="10dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_attendance_skeleton_block" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
