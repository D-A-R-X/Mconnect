<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8">

    <!-- content area -->
    <LinearLayout
        android:id="@+id/hrContentWrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header (Static Blue) -->
        <LinearLayout
            android:id="@+id/hrHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B61CA"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btnHrProfile"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_home_new_avatar_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvHrAvatarInitial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="#0B61CA"
                            android:textSize="15sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="Attendance"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tvHrHeaderSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_medium"
                            android:includeFontPadding="false"
                            android:text="Work logs &amp; Presence"
                            android:textColor="#B3D4FF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnHrBell"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_home_banner_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_home_bell_exact"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <!-- Animated Banner Content (Initially height 0, invisible) -->
            <LinearLayout
                android:id="@+id/hrBannerExpandable"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                android:visibility="invisible"
                tools:layout_height="100dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Let’s Clock-In!"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Don’t miss your clock in schedule. Track your logs here."
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:lineHeight="20dp"
                        android:fontFamily="@font/inter_medium"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_attendance_header_illustration"
                    android:contentDescription="@null"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/hrScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0B61CA"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_content_card"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <LinearLayout
                    android:id="@+id/hrMainContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="24dp">

                    <!-- Summary card is always present, avoids buttons glitching -->
                    <LinearLayout
                        android:id="@+id/cardAttendanceSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_attendance_summary_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Total Working Hour"
                            android:textColor="#101828"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPayPeriodLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Period —"
                            android:textColor="#475467"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attendance_metric_box"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingTop="11dp"
                                android:paddingEnd="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Today"
                                    android:textColor="#475467"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvTodayHours"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:text="00:00 Hrs"
                                    android:textColor="#161B23"
                                    android:textSize="22sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attendance_metric_box"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingTop="11dp"
                                android:paddingEnd="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="This Pay Period"
                                    android:textColor="#475467"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvPayPeriodHours"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:text="00:00 Hrs"
                                    android:textColor="#161B23"
                                    android:textSize="22sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Buttons stay here, always visible but enabled only when loaded -->
                        <LinearLayout
                            android:id="@+id/clockInButtonGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnClockInNow"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_attendance_btn_primary"
                                android:fontFamily="@font/inter_medium"
                                android:text="Clock In Now"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/clockedInButtonGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnTakeBreak"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attendance_btn_secondary"
                                android:fontFamily="@font/inter_medium"
                                android:text="Take A Break"
                                android:textAllCaps="false"
                                android:textColor="#6938EF"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnClockOut"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attendance_btn_dark"
                                android:fontFamily="@font/inter_medium"
                                android:text="Clock Out"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Latest history placeholder -->
                    <LinearLayout
                        android:id="@+id/cardHistory1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_attendance_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_tab_calendar_pencil"
                                app:tint="#101828" />

                            <TextView
                                android:id="@+id/tvHistoryDate1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="-- September --"
                                android:textColor="#101828"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_attendance_history_inner"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Total Hours"
                                    android:textColor="#475467"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvLatestTotalHours"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="--:--:-- hrs"
                                    android:textColor="#344054"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="Clock in &amp; Out"
                                    android:textColor="#475467"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvLatestRange"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/inter_medium"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="-- - --"
                                    android:textColor="#344054"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/historyListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/attendanceSkeletonContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_attendance_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <View
                                android:layout_width="120dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_attendance_skeleton_block" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/hrLoadingOverlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
