<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfacePrimary"
    android:orientation="vertical">

    <!-- Header: back + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            app:tint="?attr/colorForegroundPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Staff"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="18sp" />

            <!-- Active / Inactive / Total roll-up from getStaffCount. Hidden
                 until the API responds so a "0 active" string doesn't flash. -->
            <TextView
                android:id="@+id/tvStaffCountSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textColor="?attr/colorForegroundSecondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Search bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_bar"
            android:drawablePadding="10dp"
            android:fontFamily="@font/inter_regular"
            android:hint="Search staff..."
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorForegroundPrimary"
            android:textColorHint="?attr/colorForegroundMuted"
            android:textCursorDrawable="@null"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Staff list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/staffList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="40dp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_nav_fade_white"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/skeletonContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfacePrimary"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/skeleton_list_item" />
            <include layout="@layout/skeleton_list_item" />
            <include layout="@layout/skeleton_list_item" />
            <include layout="@layout/skeleton_list_item" />
            <include layout="@layout/skeleton_list_item" />
            <include layout="@layout/skeleton_list_item" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
