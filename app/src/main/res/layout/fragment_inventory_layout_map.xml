<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfacePrimary"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnLayoutMapBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/colorForegroundPrimary" />

        <TextView
            android:id="@+id/tvLayoutMapTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="18sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLayoutMapCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/layoutMapLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:indeterminateTint="?attr/colorAccentPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLayoutMapEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.manjugroups.m_connect.ui.marketing.inventory.UnitMapView
            android:id="@+id/layoutMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="12dp"
            android:background="@drawable/bg_attendance_history_inner" />

        <LinearLayout
            android:id="@+id/skeletonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:visibility="gone">

            <include layout="@layout/skeleton_detail_item" />
            <include layout="@layout/skeleton_detail_item" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
