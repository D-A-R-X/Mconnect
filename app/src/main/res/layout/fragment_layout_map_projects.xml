<?xml version="1.0" encoding="utf-8"?>
<!-- 3D Layout Maps picker: blue header, search, and the projects that have a
     map configured. Tapping one opens LayoutMapFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutMapsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B61CA"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <com.manjugroups.m_connect.ui.common.BackButton
            android:id="@+id/btnLayoutMapsBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:text="3D Layout Maps"
            android:textColor="@android:color/white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="Pick a project to explore its plots"
            android:textColor="#D9D6FE"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etLayoutMapsSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_attendance_search_pill"
            android:fontFamily="@font/inter_medium"
            android:hint="Search project or location"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#101828"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/layoutMapsRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layoutMapsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="32dp" />

                <!-- Loading / empty / error. One message, with Retry on error. -->
                <LinearLayout
                    android:id="@+id/layoutMapsState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:paddingTop="72dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/layoutMapsProgress"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="#0B61CA" />

                    <TextView
                        android:id="@+id/tvLayoutMapsState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnLayoutMapsRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_layout_map_icon"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:text="Try again"
                        android:textColor="#0B61CA"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
