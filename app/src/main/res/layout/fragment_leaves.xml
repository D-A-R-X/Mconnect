<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceSecondary">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/leavesRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnApplyLeave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:background="@drawable/bg_attendance_header_gradient"
                android:paddingStart="24dp"
                android:paddingTop="20dp">

                <!-- 3D Banner Illustration aligned to the right -->
                <ImageView
                    android:id="@+id/ivLeaveBanner"
                    android:layout_width="120dp"
                    android:layout_height="92dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_leave_3d_banner"
                    android:contentDescription="Leave banner" />

                <!-- Left Content: Title & Subtitle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:clickable="true"
                        android:contentDescription="Back"
                        android:focusable="true"
                        android:src="@drawable/ic_arrow_left"
                        android:visibility="gone"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="Leave Summary"
                        android:textColor="@android:color/white"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Submit Leave"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/topContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-58dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/balanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="0dp"
                    android:background="@drawable/bg_leave_balance_card"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBalanceTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="Total Leave"
                                android:textColor="?attr/colorForegroundPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:textColor="?attr/colorForegroundMuted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Dropdown Chip Selector -->
                        <LinearLayout
                            android:id="@+id/dropdownScopeSelector"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_scope_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvSelectedScope"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:text="My Leaves"
                                android:textColor="?attr/colorForegroundPrimary"
                                android:textSize="12sp" />

                            <View
                                android:id="@+id/dotScopeBadge"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_scope_dot_red"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/ivScopeChevron"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_leave_chevron_down"
                                app:tint="?attr/colorForegroundPrimary" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Available Metric Box -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_leave_metric_box"
                            android:orientation="vertical"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_leave_status_dot_success" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:text="Available"
                                    android:textColor="?attr/colorForegroundSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvLeaveAvailable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_bold"
                                android:text="0"
                                android:textColor="?attr/colorForegroundPrimary"
                                android:textSize="32sp" />
                        </LinearLayout>

                        <!-- Leave Used Metric Box -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_leave_metric_box"
                            android:orientation="vertical"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_leave_status_dot_blue" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:text="Leave Used"
                                    android:textColor="?attr/colorForegroundSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvLeaveUsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_bold"
                                android:text="0"
                                android:textColor="?attr/colorForegroundPrimary"
                                android:textSize="32sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.manjugroups.m_connect.ui.common.SegmentedControlView
                    android:id="@+id/filterRow"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_leave_filter_container"
                    android:padding="3dp"
                    app:scv_active_background="@drawable/bg_leave_filter_active"
                    app:scv_text_color_selected="@android:color/white"
                    app:scv_text_color_unselected="?attr/colorForegroundSecondary"
                    app:scv_text_size="11sp"
                    app:scv_font_family="@font/inter_semibold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="12dp">



                <LinearLayout
                    android:id="@+id/skeletonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_leave_skeleton_block" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_leave_skeleton_block" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="120dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_leave_skeleton_block" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_leave_skeleton_block" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/leaveList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.manjugroups.m_connect.ui.common.EmptyStateView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    app:es_image="@drawable/leave_banner_suitcase"
                    app:es_title="No Leave Submitted!"
                    app:es_description="Ready to catch some fresh air? Click “Submit Leave” and take that well-deserved break!" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/btnApplyLeave"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_leave_submit_button"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvApplyLeave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Submit Leave"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
