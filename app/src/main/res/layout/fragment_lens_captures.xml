<?xml version="1.0" encoding="utf-8"?>
<!--
  HR > Lens Enrollment > a staff member's saved photos: retake or delete each
  pose, Send to Lens, Retake all, Delete all.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceSecondary"
    android:orientation="vertical">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/lensCapturesHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfacePrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <com.manjugroups.m_connect.ui.common.BackButton
            android:id="@+id/btnLensCapBack"
            android:layout_width="32dp"
            android:layout_height="32dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLensCapName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvLensCapMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:textColor="?attr/colorForegroundSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal">

                <TextView
                    android:id="@+id/tvLensCapStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="?attr/colorForegroundSecondary"
                    android:textSize="13sp" />

                <GridLayout
                    android:id="@+id/lensCapGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/lens_captures_note"
                    android:textColor="?attr/colorForegroundMuted"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Skeleton: opaque and clickable so nothing shows or reacts through it. -->
        <ScrollView
            android:id="@+id/lensCapSkeletonScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceSecondary"
            android:clickable="true"
            android:focusable="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/lensCapSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal" />
        </ScrollView>
    </FrameLayout>

    <!-- ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfacePrimary"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLensCapSend"
            style="@style/Widget.Mconnect.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLensCapRetakeAll"
                style="@style/Widget.Mconnect.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lens_captures_retake_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLensCapDeleteAll"
                style="@style/Widget.Mconnect.Button.Danger.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/lens_captures_delete_all"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
