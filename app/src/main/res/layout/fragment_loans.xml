<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/loansEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F3F8"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/loansEmptyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FEFEFE"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <FrameLayout
                android:id="@+id/btnLoansEmptyBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_home_new_action_circle"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="#0B61CA" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:text="Loans"
                android:textColor="#101828"
                android:textSize="18sp" />
        </LinearLayout>

        <com.manjugroups.m_connect.ui.common.EmptyStateView
            android:id="@+id/loansEmptyContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="80dp"
            app:es_image="@drawable/img_loans_empty"
            app:es_title="No Loans Yet"
            app:es_description="When your finance team disburses a loan, you'll see it grouped here with EMI dates and a full repayment history." />
    </LinearLayout>

    <!-- Populated state: scroll the whole thing as one unit.
         Starts gone so we don't flash the populated header before the API
         call decides whether to swap to the empty state's separate header. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/loansContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/loansHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_blue_header"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="58dp">

                <ImageView
                    android:id="@+id/ivLoansHeaderArt"
                    android:layout_width="150dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="-8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitEnd"
                    android:src="@drawable/wgzzx_loan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="140dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnLoansBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_home_header_avatar"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_left"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLoansTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="-0.02"
                        android:text="My Loans"
                        android:textColor="#FEFEFE"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvLoansSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:letterSpacing="0.01"
                        android:text="Manage Loans and Advances"
                        android:textColor="#D9D6FE"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- White card that overlaps the blue header by 44dp and
                 wraps every card below it (hero, tab segment, empty
                 state, history list). Before this wrapper existed,
                 hiding the heroActiveCard left the tabs floating on
                 the gray bg with no rounded-corner shoulder — empty
                 state read as ungrouped. Now the wrapper carries the
                 30dp top corners + the -44dp pull-up, and the hero
                 inside it just contributes its own card visual when
                 a loan exists. -->
            <LinearLayout
                android:id="@+id/loansWhiteWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-44dp"
                android:background="@drawable/bg_loan_hero_card"
                android:orientation="vertical"
                android:paddingBottom="16dp">

            <!-- Hero active loan card — inherits the wrapper's white
                 floor; its own background keeps it visually distinct
                 when a loan is present. -->
            <LinearLayout
                android:id="@+id/heroActiveCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_loan_hero_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/heroIconTile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_loan_icon_circle_blue">

                        <ImageView
                            android:id="@+id/ivHeroLoanIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_loan_home" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHeroLoanTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            tools:text="Home Loan" />

                        <TextView
                            android:id="@+id/tvHeroLoanId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#667085"
                            android:textSize="13sp"
                            tools:text="LN00123" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnUserDropdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_loan_filter_pill"
                        android:drawableEnd="@drawable/ic_chevron_down"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/inter_medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="User"
                        android:textColor="#344054"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tvHeroBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_loan_active_pill"
                            android:fontFamily="@font/inter_medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="Active Loan"
                            android:textColor="#0B61CA"
                            android:textSize="12sp" />

                        <!-- Delete affordance — matches the per-row
                             delete on My Permissions (FrameLayout with
                             the same rounded-rect bg + trash icon).
                             Visible on the user's own active and
                             pending rows; click opens the same
                             cancel-leave confirm dialog used elsewhere. -->
                        <FrameLayout
                            android:id="@+id/btnCancelLoan"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_leave_delete_icon"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_leave_trash_red" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_line_dashed"
                    android:layerType="software" />

                <LinearLayout
                    android:id="@+id/heroActiveDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHeroOutstandingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Outstanding Amount"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvHeroOutstanding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="#111827"
                            android:textSize="20sp"
                            tools:text="₹6,25,000" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="#E4E7EC"
                        android:layout_marginHorizontal="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="4dp">

                        <TextView
                            android:id="@+id/tvHeroNextEmiLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Next EMI Due"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar_days"
                                app:tint="#0B61CA" />

                            <TextView
                                android:id="@+id/tvHeroNextEmi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="#0B61CA"
                                android:textSize="15sp"
                                tools:text="05 May 2024" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/heroPendingTracker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/loanTrackerLine"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginHorizontal="30dp"
                        android:background="#EAECF0" />

                    <View
                        android:id="@+id/advanceTrackerLine"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginHorizontal="45dp"
                        android:background="@drawable/bg_line_dashed_green"
                        android:layerType="software"
                        android:visibility="gone" />

                    <!-- Dynamic approval chain — one step per configured
                         workflow step (Settings → Workflows). Populated and
                         shown by LoansFragment when the loan/advance is
                         workflow-routed; the fixed nominee/GM/AVP/HR/Accounts
                         rows below stay hidden in that case. -->
                    <HorizontalScrollView
                        android:id="@+id/workflowTrackerScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/workflowTrackerContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:paddingHorizontal="4dp" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/layoutLoanTracker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Item 1: Nominee 1 -->
                        <LinearLayout
                            android:id="@+id/trackStepNominee1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                            <FrameLayout
                                android:id="@+id/trackFrameNominee1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_loan_icon_tile">
                                <ImageView
                                    android:id="@+id/trackIconNominee1"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_track_shield" />
                            </FrameLayout>
                            <TextView
                                android:id="@+id/trackTextNominee1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="NOMINEE 1"
                                android:textColor="#98A2B3"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Item 2: Nominee 2 -->
                        <LinearLayout
                            android:id="@+id/trackStepNominee2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                            <FrameLayout
                                android:id="@+id/trackFrameNominee2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_loan_icon_tile">
                                <ImageView
                                    android:id="@+id/trackIconNominee2"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_track_shield" />
                            </FrameLayout>
                            <TextView
                                android:id="@+id/trackTextNominee2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="NOMINEE 2"
                                android:textColor="#98A2B3"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Item 3: GM -->
                        <LinearLayout
                            android:id="@+id/trackStepGm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                            <FrameLayout
                                android:id="@+id/trackFrameGm"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_loan_icon_tile">
                                <ImageView
                                    android:id="@+id/trackIconGm"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_track_gm" />
                            </FrameLayout>
                            <TextView
                                android:id="@+id/trackTextGm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="GM"
                                android:textColor="#98A2B3"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Item 4: AVP -->
                        <LinearLayout
                            android:id="@+id/trackStepAvp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                            <FrameLayout
                                android:id="@+id/trackFrameAvp"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_loan_icon_tile">
                                <ImageView
                                    android:id="@+id/trackIconAvp"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_track_avp" />
                            </FrameLayout>
                            <TextView
                                android:id="@+id/trackTextAvp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="AVP"
                                android:textColor="#98A2B3"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Item 5: HR -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                            <FrameLayout
                                android:id="@+id/trackFrameHr"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_loan_icon_tile">
                                <ImageView
                                    android:id="@+id/trackIconHr"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_track_hr" />
                            </FrameLayout>
                            <TextView
                                android:id="@+id/trackTextHr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="HR"
                                android:textColor="#98A2B3"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Item 6: ACC'S -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                            <FrameLayout
                                android:id="@+id/trackFrameAccs"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_loan_icon_tile">
                                <ImageView
                                    android:id="@+id/trackIconAccs"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_track_accs" />
                            </FrameLayout>
                            <TextView
                                android:id="@+id/trackTextAccs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="ACC'S"
                                android:textColor="#98A2B3"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Advance Salary Tracker -->
                    <LinearLayout
                        android:id="@+id/layoutAdvanceTracker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="32dp"
                        android:visibility="gone">

                        <!-- Step 1: HR -->
                        <LinearLayout
                            android:id="@+id/advanceStepHr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_advance_step_pending"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/advanceIconHr"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_track_hr" />

                            <TextView
                                android:id="@+id/advanceTextHr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="HR"
                                android:textColor="#98A2B3"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Spacer/Weight to push them apart, since the line is behind them -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Step 2: ACC'S -->
                        <LinearLayout
                            android:id="@+id/advanceStepAccs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_advance_step_pending"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/advanceIconAccs"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_track_accs" />

                            <TextView
                                android:id="@+id/advanceTextAccs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/inter_semibold"
                                android:text="Acc's"
                                android:textColor="#98A2B3"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_loans_segment"
                    android:padding="3dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabLoans"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_loans_segment_active"
                        android:gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Loans"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabSalary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center"
                        android:fontFamily="@font/inter_medium"
                        android:text="Salary"
                        android:textColor="#475467"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCreateLoanOrAdvance"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add_plus"
                        app:tint="#101828"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRequestedLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvRequestedLoansTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Requested Loans"
                    android:textColor="#111827"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRequestedLoans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingBottom="32dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPreviousLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/previousLoansHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvPreviousLoansLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Previous Loans"
                    android:textColor="#111827"
                    android:textSize="18sp" />

                <!-- View All affordance removed — the Previous Advances list
                     scrolls all rows top-to-bottom now, no truncation. -->
                <TextView
                    android:id="@+id/tvPreviousLoansViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:padding="4dp"
                    android:text="View All"
                    android:textColor="#0B61CA"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLoans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="32dp" />
            </LinearLayout>

            <!--
              Inline empty state — sits BELOW the previous-loans block so
              the operator can still tap "Loans" / "Advance" and the +
              button to apply for a new loan / advance even when no loans
              exist yet. render() toggles this VISIBLE (and hides the hero
              + previous-loans header + rvLoans) when the active+previous
              lists are both empty; otherwise it stays GONE. Keeps the
              darx layoutPreviousLoans wrapper above intact.
            -->
            <com.manjugroups.m_connect.ui.common.EmptyStateView
                android:id="@+id/inlineLoansEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="48dp"
                android:paddingBottom="40dp"
                android:visibility="gone"
                app:es_image="@drawable/img_loans_empty"
                app:es_title="No Loans Yet"
                app:es_description="Stay organized by creating or joining teams. Groups help you manage tasks, track progress, and collaborate with your team in one place." />
            </LinearLayout> <!-- /loansWhiteWrapper -->
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_fade_grey"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
