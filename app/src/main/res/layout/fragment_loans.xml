<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/loansEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F3F8"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/loansEmptyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FEFEFE"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <FrameLayout
                android:id="@+id/btnLoansEmptyBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_home_new_action_circle"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="#0B61CA" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:text="Loans"
                android:textColor="#101828"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="80dp">

            <ImageView
                android:layout_width="182dp"
                android:layout_height="142dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/j3kagn" />

            <TextView
                android:id="@+id/tvLoansEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/inter_semibold"
                android:text="No Loans Yet"
                android:textColor="#161B23"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvLoansEmptyDesc"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="When your finance team disburses a loan, you'll see it grouped here with EMI dates and a full repayment history."
                android:textColor="#777F8C"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Populated state: scroll the whole thing as one unit.
         Starts gone so we don't flash the populated header before the API
         call decides whether to swap to the empty state's separate header. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/loansContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/loansHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_blue_header"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="58dp">

                <ImageView
                    android:id="@+id/ivLoansHeaderArt"
                    android:layout_width="150dp"
                    android:layout_height="110dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="-8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitEnd"
                    android:src="@drawable/wgzzx_loan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="140dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnLoansBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_home_header_avatar"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_left"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLoansTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="36dp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="-0.02"
                        android:text="My Loans"
                        android:textColor="#FEFEFE"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:letterSpacing="0.01"
                        android:text="Manage Loans and Salary Advance"
                        android:textColor="#D9D6FE"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Hero active loan card overlapping the header -->
            <LinearLayout
                android:id="@+id/heroActiveCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-44dp"
                android:background="@drawable/bg_loan_hero_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/heroIconTile"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_loan_icon_circle_blue">

                        <ImageView
                            android:id="@+id/ivHeroLoanIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_loan_home" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHeroLoanTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            tools:text="Home Loan" />

                        <TextView
                            android:id="@+id/tvHeroLoanId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#667085"
                            android:textSize="13sp"
                            tools:text="LN00123" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_loan_active_pill"
                        android:fontFamily="@font/inter_medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Active Loan"
                        android:textColor="#0B61CA"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_line_dashed"
                    android:layerType="software" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHeroOutstandingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Outstanding Amount"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvHeroOutstanding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="#111827"
                            android:textSize="20sp"
                            tools:text="₹6,25,000" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="#E4E7EC"
                        android:layout_marginHorizontal="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="4dp">

                        <TextView
                            android:id="@+id/tvHeroNextEmiLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Next EMI Due"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar_days"
                                app:tint="#0B61CA" />

                            <TextView
                                android:id="@+id/tvHeroNextEmi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="#0B61CA"
                                android:textSize="15sp"
                                tools:text="05 May 2024" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_loans_segment"
                    android:padding="3dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabLoans"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_loans_segment_active"
                        android:gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Loans"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabSalary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center"
                        android:fontFamily="@font/inter_medium"
                        android:text="Salary"
                        android:textColor="#475467"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCreateLoanOrAdvance"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add_plus"
                        app:tint="#101828"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/previousLoansHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvPreviousLoansLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Previous Loans"
                    android:textColor="#111827"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvPreviousLoansViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_semibold"
                    android:padding="4dp"
                    android:text="View All"
                    android:textColor="#0B61CA"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:paddingBottom="32dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
