<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceSecondary">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/permissionsRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnApplyPermission"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <com.manjugroups.m_connect.ui.common.SummaryHeaderView
                    android:id="@+id/summaryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sh_title="Permission Summary"
                    app:sh_subtitle="Submit Permission"
                    app:sh_banner_image="@drawable/img_permission_3d_banner" />

                <LinearLayout
                    android:id="@+id/topContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-58dp"
                    android:orientation="vertical">

                    <!-- Balance Card -->
                    <LinearLayout
                        android:id="@+id/balanceCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="0dp"
                        android:background="@drawable/bg_leave_balance_card"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTotalPermTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="Total Permission"
                                    android:textColor="?attr/colorForegroundPrimary"
                                    android:textSize="18sp"
                                    android:letterSpacing="-0.02" />

                                <TextView
                                    android:id="@+id/tvYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:textColor="?attr/colorForegroundMuted"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Dropdown Chip Selector -->
                            <FrameLayout
                                android:id="@+id/dropdownScopeSelector"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_scope_chip"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_margin="2dp"
                                    android:background="@drawable/bg_scope_chip_inner"
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="10dp">

                                    <TextView
                                        android:id="@+id/tvScopeLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_regular"
                                        android:text="My Permission"
                                        android:textColor="#061D3D"
                                        android:textSize="12sp"
                                        android:letterSpacing="-0.02"
                                        android:maxLines="1"
                                        android:singleLine="true" />

                                    <TextView
                                        android:id="@+id/dotScopeBadge"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginStart="5dp"
                                        android:background="@drawable/bg_red_dot"
                                        android:gravity="center"
                                        android:fontFamily="@font/inter_regular"
                                        android:textColor="@android:color/white"
                                        android:textSize="9sp"
                                        android:includeFontPadding="false"
                                        android:visibility="gone" />

                                    <ImageView
                                        android:id="@+id/ivScopeChevron"
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:layout_marginStart="5dp"
                                        android:src="@drawable/ic_leave_chevron_down"
                                        app:tint="#061D3D" />
                                </LinearLayout>
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Metric Boxes -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_leave_metric_box"
                                android:orientation="vertical"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="12dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical">

                                    <View
                                        android:layout_width="8dp"
                                        android:layout_height="8dp"
                                        android:background="@drawable/bg_leave_status_dot_success" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="@font/inter_semibold"
                                        android:text="Available Permission"
                                        android:textColor="?attr/colorForegroundSecondary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvPermAvailable"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="0 hrs"
                                    android:textColor="?attr/colorForegroundPrimary"
                                    android:textSize="32sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_leave_metric_box"
                                android:orientation="vertical"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="12dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical">

                                    <View
                                        android:layout_width="8dp"
                                        android:layout_height="8dp"
                                        android:background="@drawable/bg_leave_status_dot_blue" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="@font/inter_semibold"
                                        android:text="Used Permission"
                                        android:textColor="?attr/colorForegroundSecondary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvPermUsed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="0 hrs"
                                    android:textColor="?attr/colorForegroundPrimary"
                                    android:textSize="32sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Filter Tabs -->
                    <com.manjugroups.m_connect.ui.common.SegmentedControlView
                        android:id="@+id/filterRow"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_leave_filter_container"
                        android:padding="3dp"
                        app:scv_active_background="@drawable/bg_leave_filter_active"
                        app:scv_font_family="@font/inter_semibold"
                        app:scv_text_color_selected="@android:color/white"
                        app:scv_text_color_unselected="?attr/colorForegroundSecondary"
                        app:scv_text_size="11sp" />

                </LinearLayout>

                <!-- History Card -->
                <LinearLayout
                    android:id="@+id/historyCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/skeletonContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <View
                                android:layout_width="140dp"
                                android:layout_height="16dp"
                                android:background="@drawable/bg_leave_skeleton_block" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_leave_skeleton_block" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <View
                                android:layout_width="120dp"
                                android:layout_height="16dp"
                                android:background="@drawable/bg_leave_skeleton_block" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_leave_skeleton_block" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/permissionList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <com.manjugroups.m_connect.ui.common.EmptyStateView
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone"
                        app:es_image="@drawable/ic_leave_empty_js1pm"
                        app:es_title="No Permissions Yet!"
                        app:es_description="Need a short break? Tap 'Apply Permission' and we'll handle the rest!" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/btnApplyPermission"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_leave_submit_button"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvApplyPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Apply Permission"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- Full-screen blur backdrop for scope dropdown -->
    <View
        android:id="@+id/scopeBackdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99363636"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
