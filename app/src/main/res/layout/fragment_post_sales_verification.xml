<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:orientation="vertical">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_home_new_action_circle"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_chevron"
                app:tint="#0B61CA" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter_semibold"
            android:text="Post Sales Verification"
            android:textColor="#101828"
            android:textSize="18sp" />

        <FrameLayout
            android:id="@+id/btnVerificationCalendar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_home_new_action_circle"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calendar_days"
                app:tint="#0B61CA"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Scrollable Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/postSalesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Search Bar -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp">

                    <EditText
                        android:id="@+id/etSearchCollections"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_collections_search_bar"
                        android:fontFamily="@font/inter_medium"
                        android:hint="Search Sales Verification"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"
                        android:textColor="#101828"
                        android:textColorHint="#98A2B3"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chat_search"
                        app:tint="#101828" />
                </FrameLayout>

                <!-- Filter Tab Pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/bg_collections_segment"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:fontFamily="@font/inter_semibold"
                        android:text="All"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_collections_segment_active"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabSelfFinance"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:fontFamily="@font/inter_medium"
                        android:text="Self Finance"
                        android:textSize="13sp"
                        android:textColor="#667085"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabBankLoan"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:fontFamily="@font/inter_medium"
                        android:text="Bank Loan"
                        android:textSize="13sp"
                        android:textColor="#667085"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Summary Banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/bg_collections_summary_banner"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_home_new_action_circle"
                        android:backgroundTint="#26FFFFFF">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_apps_collections"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSummaryCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:text="0 Pending Verification" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Total Amount"
                            android:textColor="#D9D6FE"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvSummaryTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:text="₹0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Skeleton placeholders while the queue loads -->
                <LinearLayout
                    android:id="@+id/skeletonCollections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone" />

                <!-- Collections List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCollections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_collection" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Fade Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_nav_fade_grey"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

</LinearLayout>
