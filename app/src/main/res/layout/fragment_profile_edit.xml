<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceSecondary"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorSurfacePrimary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnEditBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_arrow_left"
                app:tint="?attr/colorForegroundPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:text="Personal &amp; Family"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="18sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/editScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <TextView
                    style="@style/EditFormSection"
                    android:text="Personal Details" />

                <include
                    android:id="@+id/fldName"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldDob"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldGender"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldMaritalStatus"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldBloodGroup"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldReligion"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldNationality"
                    layout="@layout/include_edit_field" />

                <TextView
                    style="@style/EditFormSection"
                    android:layout_marginTop="20dp"
                    android:text="Address" />

                <include
                    android:id="@+id/fldAddress"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldCity"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldState"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldPincode"
                    layout="@layout/include_edit_field" />

                <TextView
                    style="@style/EditFormSection"
                    android:layout_marginTop="20dp"
                    android:text="Family Details" />

                <include
                    android:id="@+id/fldFatherName"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldMotherName"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldSpouseName"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldAnniversary"
                    layout="@layout/include_edit_field" />

                <TextView
                    style="@style/EditFormSection"
                    android:layout_marginTop="20dp"
                    android:text="Emergency Contact" />

                <include
                    android:id="@+id/fldEmergencyName"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldEmergencyPhone"
                    layout="@layout/include_edit_field" />
                <include
                    android:id="@+id/fldEmergencyRelation"
                    layout="@layout/include_edit_field" />

                <TextView
                    android:id="@+id/tvEditError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:textColor="?attr/colorError"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceSecondary"
        android:orientation="vertical"
        android:visibility="gone">

        <include layout="@layout/skeleton_detail_item" />

        <include layout="@layout/skeleton_detail_item" />

        <include layout="@layout/skeleton_detail_item" />

    </LinearLayout>
</FrameLayout>
