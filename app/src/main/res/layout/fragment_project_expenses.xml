<?xml version="1.0" encoding="utf-8"?>
<!--
  Project Expenses screen — pixel-aligned with the Figma mockup.

  Stack:
    1. Solid-blue header with back arrow, title, subtitle, project picker
       (white pill + red dot + down-chevron) and calendar (white square
       pill with blue icon). Colourful clipboard-+-calculator illustration
       sits in the top-right corner of the header.
    2. White totals card with the Total Expenses headline, donut chart,
       and a 3-up legend showing category dot + name + bold amount.
    3. Filter chips — single-select, brand-blue when active.
    4. Vertical RecyclerView of expense rows.
    5. Full-width rounded green "Add Expense" button pinned at the bottom.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lt_surface_primary">

    <!-- ─── Blue header ──────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/expenseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B61CA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="110dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="-10dp"
            android:src="@drawable/ic_expense_illustration"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_left"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@android:color/white"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Expenses"
                android:fontFamily="@font/inter_bold"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manage and track all Expenses"
                android:fontFamily="@font/inter_medium"
                android:textColor="#D9D6FE"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnProjectPicker"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_home_soft_pill"
                    android:backgroundTint="#FFFFFF"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvProjectPickerLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Choose a project"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <View
                        android:id="@+id/dotRed"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_home_status_dot"
                        android:backgroundTint="#F04438"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="@null"
                        app:tint="#667085" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnDateFilter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_home_soft_pill"
                    android:backgroundTint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_calendar_days"
                        android:contentDescription="Date filter"
                        app:tint="#0B61CA" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="-20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Expenses"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="RS 0"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="28sp"
                        tools:text="RS 2,40,000" />

                    <TextView
                        android:id="@+id/tvDateRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#98A2B3"
                        android:textSize="12sp"
                        tools:text="January 2024" />
                </LinearLayout>

                <com.manjugroups.m_connect.ui.projects.DonutChartView
                    android:id="@+id/donutChart"
                    android:layout_width="96dp"
                    android:layout_height="96dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <!-- Labour -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_home_status_dot"
                            android:backgroundTint="#2563EB" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Labour"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#101828"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalLabour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        tools:text="Rs 40000" />
                </LinearLayout>

                <!-- Materials -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_home_status_dot"
                            android:backgroundTint="#F97316" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Materials"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#101828"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalMaterials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        tools:text="Rs 40000" />
                </LinearLayout>

                <!-- Equipments -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_home_status_dot"
                            android:backgroundTint="#16A34A" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Equipments"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#101828"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalEquipment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        tools:text="Rs 40000" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ─── Category filter chips ──────────────────────────────────── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/categoryPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:singleSelection="true"
            app:singleLine="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All"
                android:textColor="@color/chip_filter_text"
                app:chipBackgroundColor="@color/chip_filter_bg"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLabour"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Labour"
                android:textColor="@color/chip_filter_text"
                app:chipBackgroundColor="@color/chip_filter_bg"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMaterials"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Materials"
                android:textColor="@color/chip_filter_text"
                app:chipBackgroundColor="@color/chip_filter_bg"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEquipment"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipments"
                android:textColor="@color/chip_filter_text"
                app:chipBackgroundColor="@color/chip_filter_bg"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOther"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other"
                android:textColor="@color/chip_filter_text"
                app:chipBackgroundColor="@color/chip_filter_bg"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ─── Expense list + empty state ─────────────────────────────────
         Wrapped in a FrameLayout with weight=1 so either child (the list
         when there are rows, the empty-state text otherwise) fills the
         remaining vertical space. Without this, when rvExpenses is GONE
         its weight stops applying and the Add Expense button slides up
         next to the empty text instead of staying pinned at the bottom.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="No expenses logged yet."
            android:textColor="#FF71717A"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ─── Add Expense button (full-width green pill) ───────────────
         Uses the same vibrant green (#1BCA0B) as the Submit Date CTA
         on the date filter sheet so the two primary actions on this
         screen share the same colour token.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddExpense"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:fontFamily="@font/inter_bold"
        android:text="Add Expense"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:backgroundTint="#1BCA0B"
        app:cornerRadius="28dp"
        app:elevation="0dp" />

</LinearLayout>
