<?xml version="1.0" encoding="utf-8"?>
<!--
  Project Expenses screen — pixel-aligned with the reference mockup.

  Stack:
    1. Flat-blue header (rounded bottom): back arrow, title, subtitle,
       project picker (white pill + red active-dot + chevron), calendar
       button, and the 3D expense illustration in the top-right corner.
    2. White totals card floating up over the header's lower edge:
       Total Expenses headline + donut chart + a single-row 3-up legend
       (Labour / Materials / Equipments).
    3. Reusable FilterTabsView pill row (All / Labour / … / Others).
    4. Vertical RecyclerView of expense rows + empty state.
    5. Full-width rounded green "Add Expense" button pinned at the bottom.

  NOTE: view IDs are load-bearing — ProjectExpensesFragment binds to
  them directly. Keep them stable when restyling.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- ─── Blue header ──────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/expenseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_expense_header"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="26dp">

        <ImageView
            android:layout_width="138dp"
            android:layout_height="95dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="6dp"
            android:src="@drawable/expense_hero"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_left"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@android:color/white"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Expenses"
                android:fontFamily="@font/inter_bold"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manage and track all Expenses"
                android:fontFamily="@font/inter_medium"
                android:textColor="#D4E2FF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnProjectPicker"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_expense_project_picker"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvProjectPickerLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Select project"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <View
                        android:id="@+id/dotRed"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_home_status_dot"
                        android:backgroundTint="#F04438"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="@null"
                        app:tint="#667085" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnDateFilter"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_home_soft_pill"
                    android:backgroundTint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_calendar_days"
                        android:contentDescription="Date filter"
                        app:tint="@color/category_labour" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ─── Totals card (floats up over the header's rounded edge) ────── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="-14dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Expenses"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#667085"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="RS 0"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="28sp"
                        tools:text="RS 2,40,000" />

                    <TextView
                        android:id="@+id/tvDateRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#98A2B3"
                        android:textSize="12sp"
                        tools:text="January 2024" />
                </LinearLayout>

                <com.manjugroups.m_connect.ui.projects.DonutChartView
                    android:id="@+id/donutChart"
                    android:layout_width="108dp"
                    android:layout_height="108dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Labour -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_home_status_dot"
                            android:backgroundTint="@color/category_labour" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Labour"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#101828"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalLabour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        tools:text="Rs 40000" />
                </LinearLayout>

                <!-- Materials -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_home_status_dot"
                            android:backgroundTint="@color/category_materials" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Materials"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#101828"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalMaterials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        tools:text="Rs 40000" />
                </LinearLayout>

                <!-- Equipments -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_home_status_dot"
                            android:backgroundTint="@color/category_equipment" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Equipments"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#101828"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTotalEquipment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        tools:text="Rs 40000" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ─── Reusable category filter tabs ──────────────────────────────── -->
    <com.manjugroups.m_connect.ui.common.FilterTabsView
        android:id="@+id/categoryTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <!-- ─── Expense list + empty state ─────────────────────────────────
         FrameLayout with weight=1 so either child (list or empty text)
         fills the remaining space and the Add button stays pinned. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/expensesRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExpenses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="No expenses logged yet."
            android:fontFamily="@font/inter_medium"
            android:textColor="#98A2B3"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ─── Add Expense button (full-width green pill) ─────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddExpense"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:fontFamily="@font/inter_bold"
        android:text="Add Expense"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:backgroundTint="#1BCA0B"
        app:cornerRadius="28dp"
        app:elevation="0dp" />

</LinearLayout>
