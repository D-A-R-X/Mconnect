<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- Floating Header Container (Vertical) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Status bar height placeholder -->
        <View
            android:id="@+id/statusBarPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- Actual Header Bar -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_blue_light"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back_blue"
                app:tint="#0B61CA" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/inter_bold"
                android:text="Scan History"
                android:textColor="#1D2939"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:text="Clear"
                android:textColor="#D92D20"
                android:textSize="14sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E4E7EC"
        app:layout_constraintTop_toBottomOf="@id/headerContainer" />

    <!-- History list container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/llEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_qr_history_empty" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="No Scan History"
                    android:textColor="#344054"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Your scanned QR codes and visitor logs will show up here."
                    android:textColor="#667085"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Scrollable list of scanned entries -->
            <LinearLayout
                android:id="@+id/llHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Visitor Verification Glass Modal (History Overview) -->
    <FrameLayout
        android:id="@+id/visitorVerificationContainerHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp"
        android:background="#D9000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="32dp"
            android:background="@drawable/bg_glass_verification_modal"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="12dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/inter_bold"
                android:text="Visitor Log Overview"
                android:textColor="#0F172A"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Overview of the scanned admission record"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:gravity="center" />

            <!-- Scrollable Content -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- PRIMARY VISITOR CARD -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="PRIMARY VISITOR"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_visitor_card_inner"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvPrimaryNameHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:text="Jane Doe" />

                        <TextView
                            android:id="@+id/tvPrimaryCompanyHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Company: Tech Solutions" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="#E2E8F0" />

                        <!-- Details: Phone, Email, Age -->
                        <TextView
                            android:id="@+id/tvPrimaryPhoneHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Phone: +91 98765 43210" />

                        <TextView
                            android:id="@+id/tvPrimaryEmailHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Email: jane.doe@example.com" />

                        <TextView
                            android:id="@+id/tvPrimaryAgeHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Age: 28" />
                    </LinearLayout>

                    <!-- SECONDARY VISITORS CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutSecondaryVisitorsHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="ADDITIONAL VISITORS"
                            android:textColor="#2563EB"
                            android:textSize="11sp"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:id="@+id/containerSecondaryListHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- VISIT DETAILS CARD -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="VISIT DETAILS"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_visitor_card_inner"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvVisitCategoryTypeHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:text="Type: Vendor (Installation)" />

                        <TextView
                            android:id="@+id/tvVisitHostHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Host: Dev Super Admin" />

                        <TextView
                            android:id="@+id/tvVisitTimeWindowHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Time Window: 29 Jun 2026, 11:30 AM" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="#E2E8F0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Meeting Notes:"
                            android:textColor="#1E293B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvVisitNotesHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:text="Hardware firewall setup..." />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnCloseVerificationHistory"
                    android:layout_width="160dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_btn_gradient_green_12dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Close"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
