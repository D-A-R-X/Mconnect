<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scanner frame in center -->
    <View
        android:id="@+id/scanWindow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_scanner_border"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4 mask views around scanWindow to build dark transparent layout with a transparent hole -->
    <!-- Top mask -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scanWindow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom mask -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toBottomOf="@id/scanWindow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left mask -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="@id/scanWindow"
        app:layout_constraintBottom_toBottomOf="@id/scanWindow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/scanWindow" />

    <!-- Right mask -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="@id/scanWindow"
        app:layout_constraintBottom_toBottomOf="@id/scanWindow"
        app:layout_constraintStart_toEndOf="@id/scanWindow"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scanning Laser Line (Red moving line) -->
    <View
        android:id="@+id/laserLine"
        android:layout_width="244dp"
        android:layout_height="3dp"
        android:background="#FF3333"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="@id/scanWindow"
        app:layout_constraintStart_toStartOf="@id/scanWindow"
        app:layout_constraintTop_toTopOf="@id/scanWindow" />

    <!-- Floating Header Container (Vertical) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:elevation="4dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Status bar height placeholder -->
        <View
            android:id="@+id/statusBarPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- Actual Top Bar toolbar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_blue_light"
                android:backgroundTint="#40FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back_blue"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/inter_bold"
                android:text="Front Desk Scanner"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/btnHistory"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_blue_light"
                android:backgroundTint="#40FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_sheet_upload_outline"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scan Prompt Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Align QR code inside the box to scan"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scanWindow" />

    <!-- Visitor Verification Glass Modal -->
    <FrameLayout
        android:id="@+id/visitorVerificationContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp"
        android:background="#D9000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="32dp"
            android:background="@drawable/bg_glass_verification_modal"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="12dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/inter_bold"
                android:text="Visitor Verification"
                android:textColor="#0F172A"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Please verify the visitor details before confirming admission"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:gravity="center" />

            <!-- Scrollable Content -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- PRIMARY VISITOR CARD -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="PRIMARY VISITOR"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_visitor_card_inner"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvPrimaryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:text="Jane Doe" />

                        <TextView
                            android:id="@+id/tvPrimaryCompany"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Company: Tech Solutions" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="#E2E8F0" />

                        <!-- Details: Phone, Email, Age -->
                        <TextView
                            android:id="@+id/tvPrimaryPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Phone: +91 98765 43210" />

                        <TextView
                            android:id="@+id/tvPrimaryEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Email: jane.doe@example.com" />

                        <TextView
                            android:id="@+id/tvPrimaryAge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Age: 28" />
                    </LinearLayout>

                    <!-- SECONDARY VISITORS CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutSecondaryVisitors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="ADDITIONAL VISITORS"
                            android:textColor="#2563EB"
                            android:textSize="11sp"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:id="@+id/containerSecondaryList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- VISIT DETAILS CARD -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="VISIT DETAILS"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_visitor_card_inner"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvVisitCategoryType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:text="Type: Vendor (Installation)" />

                        <TextView
                            android:id="@+id/tvVisitHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Host: Dev Super Admin" />

                        <TextView
                            android:id="@+id/tvVisitTimeWindow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:text="Time Window: 29 Jun 2026, 11:30 AM" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="#E2E8F0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Meeting Notes:"
                            android:textColor="#1E293B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvVisitNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:text="Hardware firewall setup..." />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelVerification"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_secondary_verification"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Rescan"
                    android:textColor="#64748B"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnConfirmAdmission"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_gradient_green_12dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Confirm"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
