<?xml version="1.0" encoding="utf-8"?>
<!--
  KOS-XX: Mobile Task Manager. Mirrors app/task-manager/page.tsx on web.
  Powered by GET /api/dailyTasks/listForTaskManager which returns:
    • own tasks (always)
    • plus the team's pending / in-progress tasks for managers
    • or all tasks for super-admins

  Each row renders the daily-task shape (title + taskName + assignedTo +
  deadline + status + label) and tap-throughs to the task's actionUrl —
  could be a lead detail page (for handoff tasks) or a site-visit detail
  page (for SV tasks).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfacePrimary"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfacePrimary">

        <ImageView
            android:id="@+id/btnTaskManagerBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/colorForegroundPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Task Manager"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="17sp" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorBorder" />

    <!-- Info cards (My Tasks / My Team Tasks / Assigned By Me / Extension
         Requests / Overdue) — fixed above the scrolling list. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/TaskStatCard">
                <TextView style="@style/TaskStatLabel" android:text="My Tasks" />
                <TextView android:id="@+id/tvCardMyCount" style="@style/TaskStatValue" />
            </LinearLayout>

            <LinearLayout style="@style/TaskStatCard" android:layout_marginStart="10dp">
                <TextView style="@style/TaskStatLabel" android:text="My Team Tasks" />
                <TextView android:id="@+id/tvCardTeamCount" style="@style/TaskStatValue" />
            </LinearLayout>

            <LinearLayout style="@style/TaskStatCard" android:layout_marginStart="10dp">
                <TextView style="@style/TaskStatLabel" android:text="Assigned By Me" />
                <TextView android:id="@+id/tvCardAssignedCount" style="@style/TaskStatValue" />
            </LinearLayout>

            <LinearLayout style="@style/TaskStatCard" android:layout_marginStart="10dp">
                <TextView style="@style/TaskStatLabel" android:text="Extension Requests" />
                <TextView android:id="@+id/tvCardExtCount" style="@style/TaskStatValue" />
            </LinearLayout>

            <LinearLayout style="@style/TaskStatCard" android:layout_marginStart="10dp">
                <TextView style="@style/TaskStatLabel" android:text="Overdue" />
                <TextView android:id="@+id/tvCardOverdueCount" style="@style/TaskStatValue"
                    android:textColor="#DC2626" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── Filter row 1: by task STATUS (All / Pending / Overdue / …) ──
         Captioned + divided from the module row below so the two otherwise
         identical pill strips read as two distinct filters, not a repeat. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:text="Status"
        android:textAllCaps="true"
        android:textColor="?attr/colorForegroundMuted"
        android:textSize="11sp" />

    <com.manjugroups.m_connect.ui.common.HorizontalTabLayout
        android:id="@+id/taskStatusTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="?attr/colorBorder" />

    <!-- ── Filter row 2: by MODULE / category (All / HR / Marketing / …) ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:text="Category"
        android:textAllCaps="true"
        android:textColor="?attr/colorForegroundMuted"
        android:textSize="11sp" />

    <com.manjugroups.m_connect.ui.common.HorizontalTabLayout
        android:id="@+id/taskModuleTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:id="@+id/taskManagerSkeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:background="@drawable/bg_leave_skeleton_block" />
        <View
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_leave_skeleton_block" />
        <View
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_leave_skeleton_block" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/taskManagerRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- RecyclerView: recycles task rows so a 500-row list stays smooth. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/taskManagerRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="28dp" />

            <LinearLayout
                android:id="@+id/taskManagerEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingVertical="48dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Inbox zero"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvTaskManagerEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="No tasks match this filter."
                    android:textColor="?attr/colorForegroundMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
