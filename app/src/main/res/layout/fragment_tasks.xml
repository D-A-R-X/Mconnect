<?xml version="1.0" encoding="utf-8"?>
<!--
  My Tasks. Same "panel slides up over a fixed header" scroll effect as the
  Attendance (HR Dashboard) page:
   • The blue header sits OUTSIDE the scroll view, so it stays put.
   • The white panel lives INSIDE the NestedScrollView and overlaps the blue
     by -28dp; its rounded top corners + white bg are applied at runtime.
     clipChildren=false on every ancestor lets the rounded top draw OVER the
     blue header as the whole white panel (search + pills + list) scrolls up.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F8"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Fixed blue header -->
    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:background="#0B61CA"
        android:clipChildren="false">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="96dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img_tasks_header"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/inter_bold"
                android:text="My Tasks"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:text="Manage and track all tasks"
                android:textColor="#D9D6FE"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- White panel overlaps the blue by -28dp and slides up over it on scroll.
         White bg + rounded top corners are applied at runtime in the fragment. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/tasksRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-28dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/tasksWhitePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="120dp">

                <!-- Search Bar (bg_cpv_search_bar + ic_cpv_search, magnifier right) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp">

                    <EditText
                        android:id="@+id/etSearchTasks"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_cpv_search_bar"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Search Tasks"
                        android:imeOptions="actionSearch"
                        android:includeFontPadding="false"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="46dp"
                        android:textColor="#101828"
                        android:textColorHint="#9CA3AF"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cpv_search" />
                </FrameLayout>

                <!-- Filter tabs: shared component, same as Task Manager /
                     Attendance History. -->
                <com.manjugroups.m_connect.ui.common.HorizontalTabLayout
                    android:id="@+id/taskFilterTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <!-- Task list -->
                <LinearLayout
                    android:id="@+id/taskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp" />

                <com.manjugroups.m_connect.ui.common.EmptyStateView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="60dp"
                    android:visibility="gone"
                    app:es_image="@drawable/ic_home_empty_trips"
                    app:es_title="No Tasks Available"
                    app:es_description="It looks like you don't have any tasks scheduled at the moment." />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
