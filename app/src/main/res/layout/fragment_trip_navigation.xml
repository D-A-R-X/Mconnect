<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfacePrimary">

    <!-- Header (matches AttendanceHistory / Leaves style) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnTripBack"
            android:layout_width="@dimen/back_icon_size"
            android:layout_height="@dimen/back_icon_size"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_left"
            android:clickable="true"
            android:focusable="true"
            app:tint="?attr/colorForegroundPrimary" />

        <TextView
            android:id="@+id/tvTripTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="18sp"
            android:text="Trip"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvTripStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_trip_status_pill"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Starting…"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Destination summary card -->
    <LinearLayout
        android:id="@+id/tripInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:padding="16dp"
        android:background="@drawable/bg_stat_card"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_location"
                app:tint="?attr/colorAccentPrimary" />

            <TextView
                android:id="@+id/tvTripDestinationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="15sp"
                android:text="Destination"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTripDestinationAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="28dp"
            android:fontFamily="@font/inter_regular"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="12sp"
            android:text="—"
            android:maxLines="2"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="?attr/colorBorderLight" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="?attr/colorForegroundMuted"
                    android:textSize="11sp"
                    android:text="Distance" />
                <TextView
                    android:id="@+id/tvTripDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="15sp"
                    android:text="—" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?attr/colorBorderLight" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="?attr/colorForegroundMuted"
                    android:textSize="11sp"
                    android:text="Approx. ETA" />
                <TextView
                    android:id="@+id/tvTripEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="15sp"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Map card -->
    <FrameLayout
        android:id="@+id/mapCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_trip_map_card"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/tripInfoCard"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapViewTrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/tripLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80FFFFFF"
            android:visibility="gone">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:background="?attr/colorSurfacePrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="?attr/colorBorderLight" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenInMaps"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_trip_button_outline"
            android:fontFamily="@font/inter_medium"
            android:text="Open in Google Maps"
            android:textAllCaps="false"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="14sp" />

        <com.manjugroups.m_connect.ui.home.SwipeToConfirmButton
            android:id="@+id/swipeArrived"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="10dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
