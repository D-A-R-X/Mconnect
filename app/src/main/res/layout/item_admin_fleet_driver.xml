<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_admin_fleet_card"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:gravity="center_vertical">

    <!-- Left circular profile icon with status dot -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical">

        <!-- Blue profile circle background -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_vehicle_circle_blue">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_custom_user"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Status Dot at bottom right of circle -->
        <View
            android:id="@+id/vStatusDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-2dp"
            android:layout_marginBottom="-2dp"
            android:background="@drawable/bg_status_dot_active" />
    </FrameLayout>

    <!-- Center: Content stacked vertically -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Driver Name -->
        <TextView
            android:ellipsize="end"
            android:maxLines="1"
            android:id="@+id/tvDriverName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:textColor="#111827"
            android:textSize="15sp" />

        <!-- Phone Number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_custom_phone"
                android:tint="#6B7280" />

            <TextView
            android:ellipsize="end"
            android:maxLines="1"
                android:id="@+id/tvDriverPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Spec/Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDriverAddressIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location_pin"
                android:tint="#6B7280" />

            <TextView
                android:id="@+id/tvDriverAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_regular"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right section: Status badge and Chevron arrow -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Status Badge -->
        <TextView
            android:ellipsize="end"
            android:maxLines="1"
            android:id="@+id/tvDriverStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_success"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Active"
            android:textColor="#065F46"
            android:textSize="11sp" />

        <!-- Chevron Arrow -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#D1D5DB" />
    </LinearLayout>

    <!-- Compatibility views (invisible but kept so any other HR/chat screens compiled don't crash if they share/refer) -->
    <TextView
            android:ellipsize="end"
            android:maxLines="1"
        android:id="@+id/tvDriverRating"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
            android:ellipsize="end"
            android:maxLines="1"
        android:id="@+id/tvDriverLicense"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
