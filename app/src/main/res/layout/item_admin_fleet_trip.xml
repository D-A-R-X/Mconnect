<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_admin_fleet_card"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Left: Filled blue circle icon with gradient -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_trip_circle_gradient">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_custom_trip_route"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Right: All content stacked vertically -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Time & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_clock"
                android:tint="#0B61CA" />

            <TextView
                android:id="@+id/tvTripTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:text="2026-06-13 • 13:00"
                android:textColor="#6B7280"
                android:textSize="11sp" />

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvTripStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pending"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Pending"
                android:textColor="#EA580C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 2a: Client name (primary) — falls back to "Unknown" -->
        <TextView
            android:id="@+id/tvClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:text="Client name"
            android:textColor="#111827"
            android:textSize="14sp" />

        <!-- Row 2b: Address (secondary, muted) -->
        <TextView
            android:id="@+id/tvTripAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:breakStrategy="high_quality"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:hyphenationFrequency="none"
            android:lineSpacingExtra="1dp"
            android:maxLines="1"
            android:text="1st Avenue, 83rd St, Ashok Nagar, Chennai, Tamil Nadu 600083"
            android:textColor="#6B7280"
            android:textSize="11.5sp" />

        <!-- Row 3: people count · LMO · Allocate — three equal-width chips, each
             the same height + shape as the Allocate button. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- People count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_trip_tag_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_chat_users"
                    android:tint="#0B61CA" />

                <TextView
                    android:id="@+id/tvAttendeesTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="1"
                    android:text="2"
                    android:textColor="#1E3A8A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- LMO (Lead Management Officer — who created the SV) -->
            <LinearLayout
                android:id="@+id/lmoTagContainer"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_trip_tag_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_auth_user"
                    android:tint="#0B61CA" />

                <TextView
                    android:id="@+id/tvLmoTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#1E3A8A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Allocate — same size/shape as the two chips. Hidden for
                 allocated / expired trips. -->
            <TextView
                android:id="@+id/btnAllocate"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_admin_fleet_btn_allocate"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Allocate ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Assignment tracking: who the trip went to + how far it's got.
             Shown only for allocated (Assigned / Completed) trips. -->
        <LinearLayout
            android:id="@+id/assignmentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="#EEF0F4" />

            <TextView
                android:id="@+id/tvAssignedVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textColor="#344054"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAssignedDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#667085"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAssignedProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_home_trip_status_progress"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#B54708"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Hidden tagsLayout for ViewBinding compatibility -->
    <LinearLayout
        android:id="@+id/tagsLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone" />

</LinearLayout>
