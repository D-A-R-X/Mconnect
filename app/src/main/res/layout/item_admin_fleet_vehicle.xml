<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_admin_fleet_card"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Left: Filled blue circle icon with solid background and car -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_vehicle_circle_blue">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_admin_tab_vehicles"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Center: Content stacked vertically -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Plate Number & Status (Status hidden to match screenshot) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:ellipsize="end"
            android:maxLines="1"
                android:id="@+id/tvVehiclePlate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:text="KA-01-AA-1234"
                android:textColor="#111827"
                android:textSize="15sp" />

            <!-- Hidden for screenshot layout but kept for compile compatibility -->
            <TextView
            android:ellipsize="end"
            android:maxLines="1"
                android:id="@+id/tvVehicleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Row 2: Name/Specs (e.g. Innova / SUV / Diesel) -->
        <TextView
            android:ellipsize="end"
            android:maxLines="1"
            android:id="@+id/tvVehicleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:text="Innova / Sedan / Tempo"
            android:textColor="#4B5563"
            android:textSize="13sp" />

        <!-- Row 3: Driver Name & Phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_custom_user"
                app:tint="#6B7280" />

            <TextView
            android:ellipsize="end"
            android:maxLines="1"
                android:id="@+id/tvDriverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_regular"
                android:text="Arun Raj"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
            android:ellipsize="end"
            android:maxLines="1"
                android:id="@+id/tvDriverDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="|"
                android:textColor="#D1D5DB"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_custom_phone"
                app:tint="#6B7280" />

            <TextView
            android:ellipsize="end"
            android:maxLines="1"
                android:id="@+id/tvDriverPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_regular"
                android:text="9090909090"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right: Chevron right arrow icon -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="#D1D5DB" />

    <!-- Compile-compatibility views hidden from UI -->
    <TextView
            android:ellipsize="end"
            android:maxLines="1"
        android:id="@+id/tvVehicleCapacity"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
            android:ellipsize="end"
            android:maxLines="1"
        android:id="@+id/tvVehicleFuel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
