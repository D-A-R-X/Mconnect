<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_session_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAttDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAttHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/geist_mono_regular"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAttStatus"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:gravity="center"
        android:fontFamily="@font/inter_semibold"
        android:paddingHorizontal="12dp"
        android:textSize="11sp" />
</LinearLayout>
