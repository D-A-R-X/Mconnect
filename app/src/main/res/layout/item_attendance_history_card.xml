<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_attendance_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_tab_calendar_pencil" />

        <TextView
            android:id="@+id/tvHistoryItemDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#101828"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/badgeRemarkSubmitted"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_remark_submitted_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_remark_submitted_check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:text="Remark Submitted"
                android:textColor="#12B76A"
                android:textSize="10sp" />
        </LinearLayout>

        <!--
          Withdraw button — shown only on rows that the calling staffer
          submitted but HR hasn't reviewed yet (status=pending). The
          fragment toggles visibility; default GONE so closed / approved
          rows don't carry the affordance.
        -->
        <ImageView
            android:id="@+id/btnHistoryItemEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_edit_btn_outline"
            android:clickable="true"
            android:contentDescription="Edit attendance"
            android:focusable="true"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit_gradient" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_attendance_history_inner"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="Total Hours"
                android:textColor="#475467"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHistoryItemHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#344054"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="Clock in &amp; Out"
                android:textColor="#475467"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHistoryItemRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#344054"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Late / Fines Banner -->
    <LinearLayout
        android:id="@+id/llFinesBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_fines_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_clock"
            app:tint="#D92D20" />

        <TextView
            android:id="@+id/tvLateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:textColor="#D92D20"
            android:textSize="12sp"
            tools:text="Late by 20mins" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_receipt_red"
            app:tint="#D92D20" />

        <TextView
            android:id="@+id/tvFineAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="#D92D20"
            android:textSize="12sp"
            tools:text="Fine : ₹700" />
    </LinearLayout>

    <!--
      Decision footer — visible only on approved / rejected rows.
      Mirrors the leaves history card's bottom row:
        ✓ Approved at <date>           By <Approver> [avatar]
        ✗ Rejected at <date>           By <Approver> [avatar]
      Fragment-binding toggles visibility based on record.status and
      whether the server enriched approver info onto the row.
    -->
    <LinearLayout
        android:id="@+id/historyItemDecisionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivHistoryItemDecisionIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_leave_status_approved" />

        <TextView
            android:id="@+id/tvHistoryItemDecisionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#169B2F"
            android:textSize="12sp"
            tools:text="Approved at 19 Sept 2024" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:text="By"
            android:textColor="#101828"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/historyItemApproverAvatarFrame"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_leave_avatar_chip"
            android:clipChildren="true">

            <TextView
                android:id="@+id/tvHistoryItemApproverInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#98A2B3"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/ivHistoryItemApproverPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHistoryItemApproverName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:textColor="#101828"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
