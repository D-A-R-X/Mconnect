<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_attendance_history_inner"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/punchEventDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#22C55E" />

        <TextView
            android:id="@+id/tvPunchEventTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#101828"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPunchEventKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_semibold"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPunchEventSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="#1849A9"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Where the punch happened: mobile address or biometric machine name. -->
    <TextView
        android:id="@+id/tvPunchEventAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:drawablePadding="5dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="#667085"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Captured punch photo (mobile clock in/out). -->
    <ImageView
        android:id="@+id/ivPunchEventPhoto"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_attendance_history_inner"
        android:contentDescription="Punch photo — tap to view full screen"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:scaleType="centerCrop"
        android:visibility="gone" />
</LinearLayout>
