<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- White outer border container if selected -->
        <FrameLayout
            android:id="@+id/borderContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp">

            <!-- Rounded image layout -->
            <FrameLayout
                android:id="@+id/imageContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/logo_manju" />
            </FrameLayout>
        </FrameLayout>

        <!-- Video Badge -->
        <LinearLayout
            android:id="@+id/videoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chat_video_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_video_outline"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                tools:text="0:54" />
        </LinearLayout>

        <!-- Selected Checkmark Badge -->
        <FrameLayout
            android:id="@+id/badgeSelected"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-2dp"
            android:layout_marginBottom="-2dp"
            android:elevation="4dp"
            android:background="@drawable/bg_chat_local_media_badge"
            android:visibility="gone">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_white"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
