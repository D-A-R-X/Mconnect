<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Telemetry indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Pulsing/Active green dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_loan_track_active"
                android:backgroundTint="#38A612" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter_semibold"
                android:text="MCONNECT TELEMETRY"
                android:textColor="#38A612"
                android:textSize="9sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Main Context Label -->
        <TextView
            android:id="@+id/tvCardLocationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Current Location"
            android:textColor="#101828"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <!-- Grid of coordinates and details -->
        <LinearLayout
            android:id="@+id/layoutCardDetailsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F9FA"
            android:padding="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:id="@+id/tvCardCoordsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coordinates:"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/inter_medium" />
                <TextView
                    android:id="@+id/tvCardLocationCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12.9716, 77.5946"
                    android:textColor="#101828"
                    android:textSize="11sp"
                    android:fontFamily="@font/geist_mono" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginBottom="4dp">
                <TextView
                    android:id="@+id/tvCardBatteryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery:"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/inter_medium" />
                <TextView
                    android:id="@+id/tvCardLocationBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 84%"
                    android:textColor="#101828"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tvCardSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed:"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/inter_medium" />
                <TextView
                    android:id="@+id/tvCardLocationSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textColor="#101828"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/viewCardDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAECF0"
            android:layout_marginBottom="12dp" />

        <!-- Double buttons layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Navigate button -->
            <LinearLayout
                android:id="@+id/btnCardLocationNavigate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivCardNavigateIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/ic_menu_directions"
                    app:tint="#38A612" />
                <TextView
                    android:id="@+id/tvCardNavigateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Navigate"
                    android:textColor="#38A612"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Line separator -->
            <View
                android:id="@+id/viewCardVerticalDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#EAECF0" />

            <!-- Copy button -->
            <LinearLayout
                android:id="@+id/btnCardLocationCopy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivCardCopyIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="#475467" />
                <TextView
                    android:id="@+id/tvCardCopyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Copy Coords"
                    android:textColor="#475467"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
