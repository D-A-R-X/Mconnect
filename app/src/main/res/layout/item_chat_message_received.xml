<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="48dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/tvSenderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/chat_blue_top"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Sender Name" />

    <LinearLayout
        android:id="@+id/messageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_chat_avatar_circle"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivSenderAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvSenderAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:textColor="?attr/colorAccentPrimary"
                android:textSize="10sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bubbleStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bubbleFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:background="@drawable/bg_chat_bubble_received"
                android:paddingHorizontal="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/replyContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_chat_action_card"
                        android:padding="6dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone">
                        <View
                            android:layout_width="3dp"
                            android:layout_height="match_parent"
                            android:background="#0B61CA" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp">
                            <TextView
                                android:id="@+id/tvReplyName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="#0B61CA"
                                android:fontFamily="@font/inter_semibold" />
                            <TextView
                                android:id="@+id/tvReplyBody"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="#667085" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivReplyPreview"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/attachmentsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/bodyTimeRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMessageBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:lineSpacingMultiplier="1.05"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMessageTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/reactionsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginStart="12dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_chat_action_card"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:elevation="1dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
