<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:id="@+id/bubbleFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bg_chat_bubble_sent"
        android:paddingHorizontal="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/replyContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_chat_action_card"
                android:padding="6dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone">
                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="#0B61CA" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:id="@+id/tvReplyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#0B61CA"
                        android:fontFamily="@font/inter_semibold" />
                    <TextView
                        android:id="@+id/tvReplyBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#667085" />
                </LinearLayout>
                
                <ImageView
                    android:id="@+id/ivReplyPreview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- "Forwarded" label — visible only when this bubble was added to
                 ForwardedMessageStore (set by the local forward flow). Mirrors
                 WhatsApp's small italic indicator above the body. -->
            <LinearLayout
                android:id="@+id/forwardedTagRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivForwardedIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat_forwarded_arrow"
                    app:tint="?attr/colorForegroundInverse" />

                <TextView
                    android:id="@+id/tvForwardedTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:alpha="0.78"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:text="Forwarded"
                    android:textColor="?attr/colorForegroundInverse"
                    android:textSize="11sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attachmentsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/bodyTimeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMessageBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingMultiplier="1.05"
                    android:textColor="?attr/colorForegroundInverse"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMessageTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp" />

                    <ImageView
                        android:id="@+id/ivSeenStatus"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="Sent Status"
                        android:src="@drawable/ic_chat_check_double"
                        app:tint="#80FFFFFF"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/reactionsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_chat_action_card"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:elevation="1dp"
        android:visibility="gone" />
</LinearLayout>
