<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardConversion"
    android:layout_width="140dp"
    android:layout_height="110dp"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F8FAFC">

    <!-- Thin border can be added via background drawable if needed, 
         using cardElevation=0 and a stroke on a child layout, 
         but for now we'll just use a solid background -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:background="@drawable/bg_conversion_kpi_border">

        <ImageView
            android:id="@+id/ivConversionBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_custom_user"
            app:tint="#3B82F6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvConversionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Interest\nRate"
            android:textColor="#374151"
            android:textSize="11sp"
            android:fontFamily="@font/inter_medium"
            android:lineSpacingExtra="2dp"
            app:layout_constraintTop_toTopOf="@id/ivConversionBadge"
            app:layout_constraintStart_toEndOf="@id/ivConversionBadge"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvConversionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="55.0%"
            android:textColor="#1E3A8A"
            android:textSize="20sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ivConversionBadge"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/llConversionTrend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivConversionTrendArrow"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="#10B981" />

            <TextView
                android:id="@+id/tvConversionTrendValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.2%"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Sparkline Placeholder (bottom right) -->
        <ImageView
            android:id="@+id/ivConversionChart"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
