<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardConversion"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:layout_marginVertical="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="@drawable/bg_conversion_kpi_border">

        <!-- 3D Icon at Top Right -->
        <ImageView
            android:id="@+id/ivConversionBadge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginTop="-4dp"
            android:src="@drawable/ic_custom_user"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvConversionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Interest\nRate"
            android:textColor="#374151"
            android:textSize="9.5sp"
            android:fontFamily="@font/inter_medium"
            android:lineSpacingExtra="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivConversionBadge" />

        <!-- Value -->
        <TextView
            android:id="@+id/tvConversionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="55.0%"
            android:textColor="#1E3A8A"
            android:textSize="14sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvConversionTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Trend -->
        <TextView
            android:id="@+id/tvConversionTrendValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.2%"
            android:textColor="#10B981"
            android:textSize="9.5sp"
            android:fontFamily="@font/inter_semibold"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvConversionValue"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Graph Arrow -->
        <ImageView
            android:id="@+id/ivConversionChart"
            android:layout_width="32dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_graph_arrow"
            app:layout_constraintTop_toBottomOf="@id/tvConversionTrendValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
