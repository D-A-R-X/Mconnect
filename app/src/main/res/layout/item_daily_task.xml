<?xml version="1.0" encoding="utf-8"?>
<!--
  Row in the Task Manager list. Matches the web task-manager row shape:
  title (e.g. "Immediate Pickup Site Visit Handoff" or "SV: BlueSpot —
  Kosal"), task-name subtitle, deadline + assignedToName meta, status
  pill, and an optional category label badge. Handoff-source rows show
  Complete / Cancel action buttons at the bottom — others hide that row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowTask"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_completed_section_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="2"
            android:text="Task title"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTaskStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_inactive"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Pending"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:maxLines="2"
        android:textColor="?attr/colorForegroundMuted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Deadline"
                android:textColor="?attr/colorForegroundMuted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvTaskDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_medium"
                android:text="—"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Assigned to"
                android:textColor="?attr/colorForegroundMuted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvTaskAssignedTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:text="—"
                android:textColor="?attr/colorForegroundPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskCategoryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_inactive"
        android:fontFamily="@font/inter_medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="?attr/colorForegroundSecondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Handoff action row — only shown for sourceReferenceType =
         "out_of_station_handoff" tasks. Tap fires updateStatus with
         "completed" (creates SV) or "cancelled" (drops the handoff). -->
    <LinearLayout
        android:id="@+id/rowTaskHandoffActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/btnTaskHandoffCancel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="Cancel"
                android:textColor="?attr/colorError"
                android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnTaskHandoffComplete"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_active"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="Confirm SV"
                android:textColor="?attr/colorForegroundInverse"
                android:textSize="12sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
