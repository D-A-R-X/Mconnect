<?xml version="1.0" encoding="utf-8"?>
<!--
  Single document row inside the Documents Needed sheet. Inflated once per
  document; the fragment sets the document name and flips the badge between
  the "Required" / "If Applicable" styles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_doc_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_inspection_arrow_circle">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_query_document" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDocName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="#101828"
        android:textSize="14sp"
        tools:text="Sale Deed Xerox Copy" />

    <TextView
        android:id="@+id/tvDocBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_query_status_pending"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#0B61CA"
        android:textSize="10sp"
        tools:text="Required" />
</LinearLayout>
