<?xml version="1.0" encoding="utf-8"?>
<!--
  Inspection card (Land Procurement > Inspection).
  Top row: blue-gradient badge + title/phone + colour-coded status pill.
  Hairline divider.
  Bottom row: survey-area + date on the left, location pin + place on the
  next line, and a circular blue arrow button on the right.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardLandLog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <!-- Inner padding: 16dp top + bottom, 8dp left + right, straight from
         the spec sheet's "Padding" measurements (16 vertical / 8 horizontal). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="16dp">

        <!-- Top row: badge + (title, phone) + status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_land_log_badge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLandLogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#101828"
                    android:textSize="15sp"
                    tools:text="LP - 20423743224" />

                <TextView
                    android:id="@+id/tvLandLogPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    tools:text="+91 91979 06124" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLandLogStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_inspection_status_progress"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="#92400E"
                android:textSize="11sp"
                tools:text="In Progress" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F2F4F7" />

        <!-- Bottom row: area/date + location on the left, arrow circle on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_compare" />

                    <TextView
                        android:id="@+id/tvLandLogAreaDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:includeFontPadding="false"
                        android:textColor="#475467"
                        android:textSize="12sp"
                        tools:text="3.20 Acres • 20 May 2026" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_inspection_status_completed"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location_pin" />

                    <TextView
                        android:id="@+id/tvLandLogPlace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:textColor="#065F46"
                        android:textSize="11sp"
                        tools:text="Sithayankottai, Chengalpattu" />
                </LinearLayout>
            </LinearLayout>

            <!-- Open form arrow — shown once the inspector has accepted.
                 Reschedule is no longer a tiny circle next to the chevron;
                 it now lives as a labeled outlined button at the bottom of
                 the card alongside Accept (see the action row below). -->
            <FrameLayout
                android:id="@+id/btnInspectionArrow"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_inspection_arrow_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Open"
                    android:src="@drawable/ic_arrow_right_sm"
                    app:tint="#0B61CA" />
            </FrameLayout>
        </LinearLayout>

        <!-- Action row: Reschedule (outlined, white) + Accept (solid green)
             side-by-side. Both visible while acceptance is pending; the
             Reschedule button alone shows the "Re-scheduled" locked state
             after a date change is requested. Equal weights match the
             reference design pixel-for-pixel. -->
        <LinearLayout
            android:id="@+id/layoutInspectionActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnInspectionReschedule"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_inspection_reschedule_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Reschedule"
                    android:src="@drawable/ic_calendar_edit"
                    app:tint="#16A34A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:text="Reschedule"
                    android:textColor="#16A34A"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnInspectionAccept"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_inspection_accept_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivInspectionAcceptIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_white" />

                <TextView
                    android:id="@+id/tvInspectionAcceptLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:text="Accept"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
