<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_leave_history_card"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Date"
            android:src="@drawable/ic_leave_ticket_blue" />

        <TextView
            android:id="@+id/tvLeaveDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#101828"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/btnDeleteLeave"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_leave_delete_icon"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Delete leave"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_leave_trash_red" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_leave_history_inner_card"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLeaveReasonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="#101828"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvLeaveType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLeaveTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="#101828"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvLeaveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivLeaveStatusIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_leave_status_review" />

            <TextView
                android:id="@+id/tvLeaveReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#344054"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/staffInfoRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="By"
                android:textColor="#101828"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/leaveStaffAvatarFrame"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_leave_avatar_chip"
                android:clipChildren="true">

                <TextView
                    android:id="@+id/tvLeaveStaffInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivLeaveStaffAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLeaveStaffName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:textColor="#101828"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivLeaveStaffVerified"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="3dp"
                android:contentDescription="Verified"
                android:src="@drawable/ic_home_verified_badge" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/leaveActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Team Leaves - Review State Actions -->
        <LinearLayout
            android:id="@+id/layoutTeamReviewActions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnRejectLeave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_leave_action_reject"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="✕ Reject"
                android:textColor="#EF4444"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnApproveLeave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_leave_action_accept"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:text="✓ Accept"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Team Leaves - Approved State Label -->
        <TextView
            android:id="@+id/btnTeamAccepted"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_leave_decision_accepted"
            android:gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="✓ Accepted"
            android:textColor="#1BCA0B"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Team Leaves - Rejected State Label -->
        <TextView
            android:id="@+id/btnTeamRejected"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_leave_decision_rejected"
            android:gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="✕ Rejected"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
