<?xml version="1.0" encoding="utf-8"?>
<!-- One saved pose photo on the Saved photos screen. Width is set by the GridLayout cell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_lens_card"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivLensCap"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@drawable/bg_lens_thumb"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvLensCapEmpty"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="@string/lens_captures_none"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLensCapPose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvLensCapState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLensCapRetake"
        style="@style/Widget.Mconnect.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="@string/lens_retake"
        android:textSize="13sp"
        app:iconPadding="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLensCapDelete"
        style="@style/Widget.Mconnect.Button.Danger.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="40dp"
        android:text="@string/lens_captures_delete"
        android:textSize="13sp"
        app:iconPadding="0dp" />
</LinearLayout>
