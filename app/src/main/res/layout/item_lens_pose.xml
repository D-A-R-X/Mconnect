<?xml version="1.0" encoding="utf-8"?>
<!-- One captured pose on the review screen. Width is set by the GridLayout cell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_lens_card"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivLensPose"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@drawable/bg_lens_thumb"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivLensPoseOk"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_lens_pose_ok"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_lens_check"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLensPoseEmpty"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="@string/lens_pose_missing"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLensPoseLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvLensPoseStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:minLines="2"
        android:textColor="?attr/colorForegroundSecondary"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLensPoseRetake"
        style="@style/Widget.Mconnect.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="@string/lens_retake"
        android:textSize="13sp"
        app:iconPadding="0dp" />
</LinearLayout>
