<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_loan_card"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/loanIconTile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_loan_icon_tile">

            <ImageView
                android:id="@+id/ivLoanIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_loan_home" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLoanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="15sp"
                tools:text="Home Loan" />

            <TextView
                android:id="@+id/tvLoanId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textColor="#667085"
                android:textSize="11sp"
                tools:text="Loan ID: LN00245" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoanBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_loan_status_active"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="• ACTIVE"
            android:textColor="#12B76A"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#F2F4F7" />

    <TextView
        android:id="@+id/tvLoanOutstandingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="0.08"
        android:text="OUTSTANDING BALANCE"
        android:textColor="#667085"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvLoanOutstanding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#101828"
        android:textSize="22sp"
        tools:text="₹6,25,000" />

    <LinearLayout
        android:id="@+id/loanEmiRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Next EMI Amount"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvLoanNextEmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="14sp"
                tools:text="₹12,500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Due Date"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvLoanDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="14sp"
                tools:text="05 May 2024" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
