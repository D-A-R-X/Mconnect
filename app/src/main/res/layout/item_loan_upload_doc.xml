<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the Loan Desk upload sheet. Inflated once per required
  document in the case's documentsChecklist by LoanDeskUploadBottomSheet,
  so the slot count matches what's configured in Post-sales Settings
  for the customer's applicantType (Business / Salaried / Pension)
  instead of being hardcoded to 4.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvDocTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#344054"
            android:textSize="12sp"
            tools:text="PAN Card *" />

        <LinearLayout
            android:id="@+id/btnCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:paddingStart="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_header_camera_outline"
                app:tint="#0B61CA"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Scan"
                android:textColor="#0B61CA"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp">

        <!-- Unuploaded — dashed drop zone -->
        <LinearLayout
            android:id="@+id/layoutUnuploaded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_upload"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="18dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_upload_cloud" />

            <TextView
                android:id="@+id/tvUnuploadedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#344054"
                android:textSize="14sp"
                tools:text="Upload PAN Card" />

            <TextView
                android:id="@+id/tvUnuploadedSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:textColor="#98A2B3"
                android:textSize="11sp"
                tools:text="Max 20 MB · Scan, JPG, PNG or PDF" />
        </LinearLayout>

        <!-- Uploading — pill with spinner + status text. Shown while
             the file is being copied to cache + posted to /api/storage/upload.
             Submit is gated on this state across all slots so the user
             can't dispatch a half-uploaded payload. -->
        <RelativeLayout
            android:id="@+id/layoutUploading"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_loan_input_box"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbUploading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_centerVertical="true"
                android:indeterminateTint="#0B61CA" />

            <TextView
                android:id="@+id/tvUploadingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/pbUploading"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Uploading…"
                android:textColor="#0B61CA"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- Failed — pill with error text + Retry chip. Visible only
             when a previous upload attempt errored out. -->
        <RelativeLayout
            android:id="@+id/layoutFailed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_loan_input_box"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivFailedIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_outcome_close"
                app:tint="#D92D20"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvFailedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/ivFailedIcon"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@+id/btnRetryUpload"
                android:fontFamily="@font/inter_semibold"
                android:text="Upload failed"
                android:textColor="#D92D20"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btnRetryUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Retry"
                android:textColor="#0B61CA"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Uploaded — solid pill with file name + check -->
        <RelativeLayout
            android:id="@+id/layoutUploaded"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/bg_loan_input_box"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivDocIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_loan_document"
                app:tint="#667085"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/uploadedTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/ivDocIcon"
                android:layout_toStartOf="@id/btnDeleteUploaded"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUploadedName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="@font/inter_semibold"
                    android:singleLine="true"
                    android:textColor="?attr/colorForegroundPrimary"
                    android:textSize="13sp"
                    tools:text="pan_card_doc.pdf" />

                <TextView
                    android:id="@+id/tvUploadedHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Tap to preview"
                    android:textColor="?attr/colorAccentPrimary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDeleteUploaded"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Delete uploaded document"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_trash_red" />
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>
