<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_leave_history_card"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Date"
            android:src="@drawable/ic_leave_calendar_small" />

        <TextView
            android:id="@+id/tvPermDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#101828"
            android:textSize="14sp" />

        <!-- Cancel-while-in-review affordance. Visibility is flipped on
             at runtime ONLY for the user's own pending requests on the
             My Permissions view; hidden everywhere else (approved /
             rejected / Team view / approver-mode). -->
        <ImageView
            android:id="@+id/ivPermCancel"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel request"
            android:padding="2dp"
            android:src="@drawable/ic_trash"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_leave_history_inner_card"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Permission Time"
                android:textColor="#667085"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPermTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#344054"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Total Hours"
                android:textColor="#667085"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPermHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#344054"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPermStatusIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_leave_status_review" />

            <TextView
                android:id="@+id/tvPermReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#344054"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/staffInfoRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="By"
                android:textColor="#101828"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPermStaffInitial"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_leave_avatar_chip"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:textColor="#98A2B3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPermStaffName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#101828"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionActionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnApprovePermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Approve"
            android:textColor="?attr/colorForegroundInverse"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRejectPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Reject"
            android:textColor="?attr/colorError"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
