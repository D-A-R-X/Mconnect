<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPermDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPermStatus"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="10dp"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPermTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="?attr/colorForegroundSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvPermStaffName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPermReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="?attr/colorForegroundMuted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/permissionActionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnApprovePermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Approve"
            android:textColor="?attr/colorForegroundInverse"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRejectPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Reject"
            android:textColor="?attr/colorError"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
