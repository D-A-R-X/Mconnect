<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_leave_history_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:elevation="1dp">

    <!-- Circular Avatar/Icon Badge -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_blue_light"
            android:backgroundTint="#F1F5F9" />
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_custom_user"
            app:tint="#2563EB" />
    </FrameLayout>

    <!-- Info details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Name of Visitor -->
        <TextView
            android:id="@+id/tvScanValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Visitor Name"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Visitor Company & Type -->
        <TextView
            android:id="@+id/tvScanDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_medium"
            android:text="Company • Type"
            android:textColor="#475569"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Host Person -->
        <TextView
            android:id="@+id/tvScanHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/inter_regular"
            android:text="Host: Employee Name"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Time and Arrow right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_tag_checked_in"
            android:fontFamily="@font/inter_semibold"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Checked In"
            android:textColor="#15803D"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvScanTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="12:00 PM"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_apps_chevron"
            app:tint="#94A3B8" />
    </LinearLayout>

</LinearLayout>
