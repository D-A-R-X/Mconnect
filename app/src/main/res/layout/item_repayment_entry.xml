<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Timeline rail. layout_height=match_parent stretches to match the
         card's measured height (incl. its bottom margin) so the line flows
         continuously between rows. -->
    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/timelineTop"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:background="#D0D5DD" />

        <FrameLayout
            android:id="@+id/timelineDot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_loan_calendar_day_selected">

            <ImageView
                android:id="@+id/ivTimelineIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_success_check"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <View
            android:id="@+id/timelineBottom"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#D0D5DD" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_loan_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRepaymentDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#101828"
                    android:textSize="14sp"
                    tools:text="05 Jun 2024" />

                <TextView
                    android:id="@+id/tvRepaymentEmi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="#667085"
                    android:textSize="11sp"
                    tools:text="EMI #16" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRepaymentAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#101828"
                    android:textSize="14sp"
                    tools:text="₹12,500" />

                <TextView
                    android:id="@+id/tvRepaymentStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_loan_status_paid"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="PAID"
                    android:textColor="#12B76A"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/repaymentPaymentMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPaidVia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textColor="#667085"
                android:textSize="11sp"
                tools:text="Paid via Bank" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPaidOnTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textColor="#12B76A"
                android:textSize="11sp"
                tools:text="Payment On Time" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
