<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_staff_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_stat_card">
        <TextView
            android:id="@+id/tvStaffInitials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- Staff info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStaffName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStaffRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_regular"
            android:textColor="?attr/colorForegroundSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStaffPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/geist_mono_regular"
            android:textColor="?attr/colorForegroundMuted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvStaffGeoTrackHealth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_error"
            android:fontFamily="@font/inter_semibold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorError"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Status badge -->
    <TextView
        android:id="@+id/tvStaffStatus"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:gravity="center"
        android:fontFamily="@font/inter_semibold"
        android:paddingHorizontal="10dp"
        android:textSize="10sp" />
</LinearLayout>
