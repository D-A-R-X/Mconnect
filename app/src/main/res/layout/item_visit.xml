<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Row 1: Place name + status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVisitPlaceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="Place Name"
            android:textColor="?attr/colorForegroundPrimary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvVisitStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="scheduled"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 2: Address -->
    <TextView
        android:id="@+id/tvVisitAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_medium"
        android:text="Address"
        android:textColor="?attr/colorForegroundMuted"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Row 3: Action button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnVisitAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_punch_in_btn"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Start Trip"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
