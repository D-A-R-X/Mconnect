<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ROW 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="12dp">

        <!-- Staff Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_blue">

            <ImageView
                android:id="@+id/iconStaff"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_blue"
                android:src="@drawable/ic_user_outline"
                android:padding="8dp"
                app:tint="#0B61CA"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleStaff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Total Active Staff"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconStaff" />
                
            <TextView
                android:id="@+id/numStaff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="276"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleStaff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_blue"
                android:text="All Departments"
                android:textColor="#1D4ED8"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numStaff" />

            <ImageView
                android:layout_width="66dp"
                android:layout_height="52dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_overview_3d_staff"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Present Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_green">

            <ImageView
                android:id="@+id/iconPresent"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_green"
                android:src="@drawable/ic_calendar_days"
                android:padding="8dp"
                app:tint="#059669"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titlePresent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Present"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconPresent" />
                
            <TextView
                android:id="@+id/numPresent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="210"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titlePresent" />

            <TextView
                android:id="@+id/trendPresent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_green"
                android:text="↗ 76% of Total"
                android:textColor="#047857"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numPresent" />

            <ImageView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_overview_3d_present"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- ROW 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="12dp">

        <!-- Absent Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_red">

            <ImageView
                android:id="@+id/iconAbsent"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_red"
                android:src="@drawable/ic_user_outline"
                android:padding="8dp"
                app:tint="#DC2626"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleAbsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Absent"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconAbsent" />
                
            <TextView
                android:id="@+id/numAbsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="51"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleAbsent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_red"
                android:text="↘ High Today"
                android:textColor="#B42318"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numAbsent" />

            <ImageView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_overview_3d_absent"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Leave Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_orange">

            <ImageView
                android:id="@+id/iconLeave"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_orange"
                android:src="@drawable/ic_calendar_days"
                android:padding="8dp"
                app:tint="#EA580C"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleLeave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Leave"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconLeave" />
                
            <TextView
                android:id="@+id/numLeave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="15"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleLeave" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_orange"
                android:text="✓ Approved"
                android:textColor="#B54708"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numLeave" />

            <ImageView
                android:layout_width="76dp"
                android:layout_height="70dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_overview_3d_leave"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- ROW 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- Week Off Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_gray">

            <ImageView
                android:id="@+id/iconWeekOff"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overview_icon_gray"
                android:src="@drawable/ic_calendar_days"
                android:padding="6dp"
                app:tint="#64748B"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleWeekOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="Week Off"
                android:textColor="#111827"
                android:textSize="10sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconWeekOff" />
                
            <TextView
                android:id="@+id/numWeekOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleWeekOff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_overview_pill_gray"
                android:text="No Data"
                android:textColor="#475467"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numWeekOff" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="66dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_overview_3d_weekoff"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Permission Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_lightblue">

            <ImageView
                android:id="@+id/iconPermission"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overview_icon_blue"
                android:src="@drawable/ic_task_note"
                android:padding="6dp"
                app:tint="#0B61CA"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titlePermission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="Permission"
                android:textColor="#111827"
                android:textSize="10sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconPermission" />
                
            <TextView
                android:id="@+id/numPermission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titlePermission" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_overview_pill_blue"
                android:text="No Requests"
                android:textColor="#1D4ED8"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numPermission" />

            <ImageView
                android:layout_width="46dp"
                android:layout_height="54dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_overview_3d_permission"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- WFH Approved Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_lightgreen">

            <ImageView
                android:id="@+id/iconWfh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overview_icon_green"
                android:src="@drawable/ic_nav_home"
                android:padding="6dp"
                app:tint="#059669"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleWfh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="WFH Approved"
                android:textColor="#111827"
                android:textSize="10sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconWfh" />
                
            <TextView
                android:id="@+id/numWfh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleWfh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_overview_pill_gray"
                android:text="No Data"
                android:textColor="#475467"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numWfh" />

            <ImageView
                android:layout_width="58dp"
                android:layout_height="72dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_overview_3d_wfh"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</LinearLayout>
