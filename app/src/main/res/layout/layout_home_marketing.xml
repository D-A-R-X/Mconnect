<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ROW 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="12dp">

        <!-- Total Calls Card (Blue) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_blue">

            <ImageView
                android:id="@+id/iconCalls"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_blue"
                android:src="@drawable/ic_phone_outline"
                android:padding="8dp"
                android:tint="#0B61CA"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleCalls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Total Calls"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconCalls" />
                
            <TextView
                android:id="@+id/numCalls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="276"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleCalls" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_blue"
                android:text="↗ 12% vs last week"
                android:textColor="#1D4ED8"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numCalls" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_marketing_3d_calls"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Incoming Card (Green) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_green">

            <ImageView
                android:id="@+id/iconIncoming"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_green"
                android:src="@drawable/ic_outcome_phone"
                android:padding="8dp"
                android:tint="#059669"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleIncoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Incoming"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconIncoming" />
                
            <TextView
                android:id="@+id/numIncoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="210"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleIncoming" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_green"
                android:text="↗ 5% vs last week"
                android:textColor="#047857"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numIncoming" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_marketing_3d_incoming"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- ROW 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="12dp">

        <!-- Outgoing Card (Blue) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_blue">

            <ImageView
                android:id="@+id/iconOutgoing"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_blue"
                android:src="@drawable/ic_phone_outline"
                android:padding="8dp"
                android:tint="#0B61CA"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleOutgoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Outgoing"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconOutgoing" />
                
            <TextView
                android:id="@+id/numOutgoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="51"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleOutgoing" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_blue"
                android:text="↘ 3% vs last week"
                android:textColor="#1D4ED8"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numOutgoing" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_marketing_3d_outgoing"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Hot Card (Red) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_red">

            <ImageView
                android:id="@+id/iconHot"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview_icon_red"
                android:src="@drawable/ic_task_illustration"
                android:padding="8dp"
                android:tint="#DC2626"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleHot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Hot"
                android:textColor="#111827"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconHot" />
                
            <TextView
                android:id="@+id/numHot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="15"
                android:textColor="#111827"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleHot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overview_pill_red"
                android:text="🔥 High Priority"
                android:textColor="#B42318"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numHot" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_marketing_3d_hot"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- ROW 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Warm Card (Orange) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_orange">

            <ImageView
                android:id="@+id/iconWarm"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overview_icon_orange"
                android:src="@drawable/ic_outcome_site_visit"
                android:padding="6dp"
                android:tint="#EA580C"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleWarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="Warm"
                android:textColor="#111827"
                android:textSize="10sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconWarm" />
                
            <TextView
                android:id="@+id/numWarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleWarm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_overview_pill_orange"
                android:text="Trending"
                android:textColor="#B54708"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numWarm" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_marketing_3d_warm"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Cold Card (Gray) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_gray">

            <ImageView
                android:id="@+id/iconCold"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overview_icon_gray"
                android:src="@drawable/ic_outcome_person"
                android:padding="6dp"
                android:tint="#64748B"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleCold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="Cold"
                android:textColor="#111827"
                android:textSize="10sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconCold" />
                
            <TextView
                android:id="@+id/numCold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleCold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_overview_pill_gray"
                android:text="Needs Attention"
                android:textColor="#475467"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numCold" />

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_marketing_3d_cold"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    
    <!-- ROW 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- SV Fixed Card (Lightblue) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_lightblue">

            <ImageView
                android:id="@+id/iconSv"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overview_icon_blue"
                android:src="@drawable/ic_task_note"
                android:padding="6dp"
                android:tint="#0B61CA"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleSv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="SV Fixed"
                android:textColor="#111827"
                android:textSize="10sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconSv" />
                
            <TextView
                android:id="@+id/numSv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleSv" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_overview_pill_blue"
                android:text="Verified"
                android:textColor="#1D4ED8"
                android:textSize="8sp"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/numSv" />

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:scaleType="fitEnd"
                android:src="@drawable/img_marketing_3d_sv"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CP / Bookings Card (Lightgreen) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/bg_overview_card_lightgreen">

            <ImageView
                android:id="@+id/iconCp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overview_icon_green"
                android:src="@drawable/ic_nav_home"
                android:padding="6dp"
                android:tint="#059669"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#94A3B8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleCp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="CP / Bookings"
                android:textColor="#111827"
                android:textSize="10sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iconCp" />
                
            <TextView
                android:id="@+id/numCp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleCp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
