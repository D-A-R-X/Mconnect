<?xml version="1.0" encoding="utf-8"?>
<!-- Onboard2 (Figma 98:8195) — frame 390x844 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <!-- Sales line chart card -->
    <ImageView
        android:id="@+id/imgSalesLine"
        android:layout_width="230dp"
        android:layout_height="245dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="65dp"
        android:src="@drawable/onboard_sales_line"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

    <!-- Sales bar chart card -->
    <ImageView
        android:id="@+id/imgSalesBar"
        android:layout_width="230dp"
        android:layout_height="246dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="165dp"
        android:src="@drawable/onboard_sales_bar"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

</FrameLayout>
