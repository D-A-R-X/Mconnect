<?xml version="1.0" encoding="utf-8"?>
<!-- Booking · Charges Details — Frame 3 in the current reference set. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/OutcomeBodyCard"
    android:id="@+id/bodyBookingCharges"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView style="@style/OutcomeSectionTitle" android:layout_marginTop="2dp" android:text="Financial Details" />
    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="10dp" android:text="Booking Cost *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etChargeBookingCost" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Guideline Value *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_rupee" />
        <EditText android:id="@+id/etChargeGuidelineValue" style="@style/OutcomeFieldEdit" android:hint="Enter Value" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Special Consideration" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
        <EditText android:id="@+id/etChargeSpecialConsideration" style="@style/OutcomeFieldEdit" android:hint="Discount amount" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView android:id="@+id/lblChargeDiscountApprovedBy" style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Discount Approved By *" android:visibility="gone" />
    <LinearLayout android:id="@+id/rowChargeDiscountApprovedBy" style="@style/OutcomeFieldPill" android:visibility="gone">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
        <EditText android:id="@+id/etChargeDiscountApprovedBy" style="@style/OutcomeFieldEdit" android:hint="Enter Details" android:inputType="textCapWords" />
    </LinearLayout>

    <TextView android:id="@+id/lblChargeScReason" style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="SC Reason *" android:visibility="gone" />
    <LinearLayout android:id="@+id/rowChargeScReason" style="@style/OutcomeFieldPill" android:visibility="gone">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
        <EditText android:id="@+id/etChargeScReason" style="@style/OutcomeFieldEdit" android:hint="Enter Details" android:inputType="textCapSentences" />
    </LinearLayout>

    <TextView android:id="@+id/lblChargeScValidity" style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="SC Validity *" android:visibility="gone" />
    <LinearLayout android:id="@+id/rowChargeScValidity" style="@style/OutcomeFieldPill" android:visibility="gone">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <EditText android:id="@+id/etChargeScValidity" style="@style/OutcomeFieldEdit" android:hint="Enter Days" android:inputType="number" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Promotional Offer *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etChargePromoOffers" style="@style/OutcomeFieldEdit" android:hint="Enter Details" android:inputType="textCapSentences" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Terms &amp; Conditions *" />
    <LinearLayout android:id="@+id/rowChargePromoTnc" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_rupee" />
        <TextView android:id="@+id/tvChargePromoTnc" style="@style/OutcomeFieldValue" android:hint="Select timeline..." />
        <ImageView style="@style/OutcomeFieldChevron" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Offer Value *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_rupee" />
        <EditText android:id="@+id/etChargePromoValue" style="@style/OutcomeFieldEdit" android:hint="Enter Value" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Offer Validity Period" android:visibility="gone" />
    <LinearLayout style="@style/OutcomeFieldPill" android:visibility="gone">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <EditText android:id="@+id/etChargeOfferValidity" style="@style/OutcomeFieldEdit" android:hint="Enter Days" android:inputType="number" />
    </LinearLayout>
</LinearLayout>
