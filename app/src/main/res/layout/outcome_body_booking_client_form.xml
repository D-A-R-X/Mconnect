<?xml version="1.0" encoding="utf-8"?>
<!-- Frame 3: full client details form (10 personal fields). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bodyBookingClientForm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Client Phone Number *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_phone" />

        <EditText
            android:id="@+id/tvFormClientPhone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:digits="0123456789"
            android:fontFamily="@font/inter_medium"
            android:hint="Enter Mobile Number"
            android:imeOptions="actionDone"
            android:includeFontPadding="false"
            android:inputType="phone"
            android:maxLength="10"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Title *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/rowFormTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_person" />

        <TextView
            android:id="@+id/tvFormClientTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:hint="Select Title"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_chevron_down" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Client Name *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_person" />

        <EditText
            android:id="@+id/etFormClientName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/inter_medium"
            android:hint="Enter Client Name"
            android:includeFontPadding="false"
            android:inputType="textCapWords"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Client Image — mirrors the web booking form's optional client photo
         (Client Details tab), styled like the web profile-pic uploader:
         dashed action card + helper line, with a compact uploaded pill.
         The storage id rides the create payload and lands on the clients
         master row server-side. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Client Image"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/cardClientImageUpload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_dash_upload"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_header_camera_outline"
            app:tint="#0B61CA" />

        <TextView
            android:id="@+id/tvClientImageAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text="Upload Client Pic"
            android:textColor="#0B61CA"
            android:textSize="13.5sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Optional · Supports: JPG, PNG"
        android:textColor="#98A2B3"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/rowClientImagePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgClientPhoto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_input"
            android:contentDescription="Client photo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_outcome_person" />

        <TextView
            android:id="@+id/tvClientImageName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="client-photo.jpg"
            android:textColor="#101828"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnClientImageAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pagination_size_pill"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="Remove"
            android:textColor="#B42318"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Father/Spouse Name *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_person" />

        <EditText
            android:id="@+id/etFormFatherName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/inter_medium"
            android:hint="Enter Name"
            android:includeFontPadding="false"
            android:inputType="textCapWords"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Date of Birth *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/rowFormDob"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_calendar" />

        <TextView
            android:id="@+id/tvFormDob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:hint="dd/mm/yyyy"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Anniversary Date"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/rowFormAnniversary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_calendar" />

        <TextView
            android:id="@+id/tvFormAnniversary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:hint="dd/mm/yyyy"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Alternate Numbers *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_phone" />

        <EditText
            android:id="@+id/etFormAlternateNumber"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:digits="0123456789"
            android:fontFamily="@font/inter_medium"
            android:hint="Enter Number"
            android:includeFontPadding="false"
            android:inputType="phone"
            android:maxLength="10"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="WhatsApp Number *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_whatsapp" />

        <EditText
            android:id="@+id/etFormWhatsApp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:digits="0123456789"
            android:fontFamily="@font/inter_medium"
            android:hint="Enter Number"
            android:includeFontPadding="false"
            android:inputType="phone"
            android:maxLength="10"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowFormSameAsPersonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivFormSameAsPersonal"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_checkbox_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="Same as personal number"
            android:textColor="#475467"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Email *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_mail" />

        <EditText
            android:id="@+id/etFormEmail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/inter_medium"
            android:hint="Enter Email Id"
            android:includeFontPadding="false"
            android:inputType="textEmailAddress"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:text="Nationality *"
        android:textColor="#475467"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/rowFormNationality"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_flag" />

        <TextView
            android:id="@+id/tvFormNationality"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:hint="Select Nationality"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_chevron_down" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="20dp" android:text="Home Address" />

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="10dp" android:text="Door No *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_pin" />
        <EditText android:id="@+id/etFormHomeDoorNo" style="@style/OutcomeFieldEdit" android:hint="Enter door number" android:inputType="textPostalAddress" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Street Name *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_pin" />
        <EditText android:id="@+id/etFormHomeStreet" style="@style/OutcomeFieldEdit" android:hint="Enter street name" android:inputType="textPostalAddress|textCapWords" />
    </LinearLayout>

    <!-- Pincode -->
    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Pincode *" />

    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_globe" />
        <EditText
            android:id="@+id/etFormPincode"
            style="@style/OutcomeFieldEdit"
            android:hint="Enter Pincode"
            android:inputType="number"
            android:maxLength="6" />
    </LinearLayout>

    <!-- District -->
    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="District *" />

    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_pin" />
        <EditText
            android:id="@+id/etFormDistrict"
            style="@style/OutcomeFieldEdit"
            android:hint="Enter District"
            android:inputType="textCapWords" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Address Line 1 *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_pin" />
        <EditText
            android:id="@+id/etFormHomeAddress"
            style="@style/OutcomeFieldEdit"
            android:hint="Enter address line 1"
            android:inputType="textPostalAddress|textCapSentences" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Address Line 2" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_pin" />
        <EditText android:id="@+id/etFormHomeAddressLine2" style="@style/OutcomeFieldEdit" android:hint="Enter address line 2" android:inputType="textPostalAddress|textCapSentences" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Location on Map" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_pin" />
        <EditText android:id="@+id/etFormLocationMap" style="@style/OutcomeFieldEdit" android:hint="Enter Google Maps link" android:inputType="textUri" />
    </LinearLayout>

    <!-- Kept as hidden backing fields for existing pincode enrichment and
         lead-sync payloads. They are not part of the approved home-address UI. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <EditText android:id="@+id/etFormState" android:layout_width="1dp" android:layout_height="1dp" />
        <EditText android:id="@+id/etFormLocation" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</LinearLayout>
