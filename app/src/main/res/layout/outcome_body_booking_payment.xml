<?xml version="1.0" encoding="utf-8"?>
<!-- Booking · Payment Details — Frames 4 + 5 in the current reference set.
     Top half: registration / GST / document / other charges + advance + mode.
     Bottom half: flexi-payment schedule (allotment + 2nd/3rd/4th installments). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/OutcomeBodyCard"
    android:id="@+id/bodyBookingPayment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/groupBookingChargesAdvance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView style="@style/OutcomeSectionTitle" android:layout_marginTop="2dp" android:text="Charges &amp; Advance" />

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="10dp" android:text="Promotional Offer *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayPromoOffer" style="@style/OutcomeFieldEdit" android:hint="Enter promotional offer" android:inputType="textCapWords" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Offer Value *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_rupee" />
        <EditText android:id="@+id/etPayPromoValue" style="@style/OutcomeFieldEdit" android:hint="0.00" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Terms &amp; Conditions *" />
    <LinearLayout android:id="@+id/rowPayPromoTnc" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
        <TextView android:id="@+id/tvPayPromoTnc" style="@style/OutcomeFieldValue" android:hint="Select timeline..." />
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_chevron_down" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Registration Charges *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayRegCharges" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="GST Amount *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayGstAmount" style="@style/OutcomeFieldEdit" android:hint="Enter Value" android:inputType="numberDecimal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPayGstApplicable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPayGstApplicable"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_checkbox_checked" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="Applicable"
            android:textColor="#475467"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Document Charges *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayDocCharges" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Patta Charges *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayPattaCharges" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Other Charges *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayOtherCharges" style="@style/OutcomeFieldEdit" android:hint="Enter Value" android:inputType="numberDecimal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPayOtherApplicable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPayOtherApplicable"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_checkbox_checked" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="Applicable"
            android:textColor="#475467"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView style="@style/OutcomeSectionTitle" android:text="Customer Funding" />
    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="10dp" android:text="Customer Payment Category *" />
    <LinearLayout android:id="@+id/rowPayPaymentMode" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_info_shield" />
        <TextView android:id="@+id/tvPayPaymentMode" style="@style/OutcomeFieldValue" android:hint="Select category" />
        <ImageView style="@style/OutcomeFieldChevron" />
    </LinearLayout>

    <!-- Loan Amount Required — visible only when "B - Loan Customer"
         is picked above. Mirrors the same conditional field on the
         web Booking · Customer Payment Category form. Both the label
         and the input row toggle visibility together. -->
    <TextView
        android:id="@+id/lblPayLoanAmount"
        style="@style/OutcomeFieldLabel"
        android:layout_marginTop="14dp"
        android:text="Bank Loan Amount *"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/rowPayLoanAmount"
        style="@style/OutcomeFieldPill"
        android:visibility="gone">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
        <EditText
            android:id="@+id/etPayLoanAmount"
            style="@style/OutcomeFieldEdit"
            android:hint="Amount customer wants as loan"
            android:inputType="numberDecimal" />
    </LinearLayout>

    <!-- Client Payable Summary Card (iOS Parity) -->
    <LinearLayout
        android:id="@+id/cardClientPayableSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_summary_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_outcome_doc" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_bold"
                android:text="Client Payable Summary"
                android:textColor="#101828"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="Total land cost"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryLandCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="GST"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryGst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="Registration charges"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryRegCharges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="Document charges"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryDocCharges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="Patta charges"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryPattaCharges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="Other charges"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryOtherCharges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#EAECF0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:text="Total amount payable"
                android:textColor="#101828"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvSummaryTotalPayable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="#101828"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_bold"
            android:text="PAYMENT POSITION"
            android:textColor="#667085"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_regular"
            android:text="Enter the advance below. The client may pay more than the project minimum."
            android:textColor="#667085"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="Minimum advance"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryMinAdvance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="Advance entered"
                android:textColor="#475467"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvSummaryAdvanceEntered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#101828"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:text="Balance after advance"
                android:textColor="#101828"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvSummaryBalanceAfterAdvance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="#101828"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Advance Booking Payment *" />
    <LinearLayout android:id="@+id/rowBookMode" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <TextView android:id="@+id/tvBookMode" style="@style/OutcomeFieldValue" android:hint="Select Mode" />
        <ImageView style="@style/OutcomeFieldChevron" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Advance Amount *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
        <EditText android:id="@+id/etPayAdvanceAmount" style="@style/OutcomeFieldEdit" android:hint="Enter Details" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPayMinimumAdvance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:text="Project minimum: ₹0. Higher advance is allowed."
        android:textColor="#667085"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/groupPayDigitalProof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Transaction ID *" />
        <LinearLayout style="@style/OutcomeFieldPill">
            <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
            <EditText android:id="@+id/etPayTransactionId" style="@style/OutcomeFieldEdit" android:hint="UTR / Ref no" android:inputType="text" />
        </LinearLayout>

        <com.manjugroups.m_connect.ui.common.BookingUploadFieldView
            android:id="@+id/btnPayProofUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:buf_label="Payment Proof"
            app:buf_required="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupPayInstrument"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView android:id="@+id/lblPayInstrumentNo" style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Cheque No *" />
        <LinearLayout style="@style/OutcomeFieldPill">
            <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
            <EditText android:id="@+id/etPayInstrumentNo" style="@style/OutcomeFieldEdit" android:hint="Enter instrument number" android:inputType="text" />
        </LinearLayout>
        <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Bank *" />
        <LinearLayout style="@style/OutcomeFieldPill">
            <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
            <EditText android:id="@+id/etPayBankName" style="@style/OutcomeFieldEdit" android:hint="Enter bank" android:inputType="textCapWords" />
        </LinearLayout>
        <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Branch *" />
        <LinearLayout style="@style/OutcomeFieldPill">
            <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
            <EditText android:id="@+id/etPayBankBranch" style="@style/OutcomeFieldEdit" android:hint="Enter branch" android:inputType="textCapWords" />
        </LinearLayout>
        <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Instrument Date *" />
        <LinearLayout android:id="@+id/rowPayInstrumentDate" style="@style/OutcomeFieldPillClickable">
            <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
            <TextView android:id="@+id/tvPayInstrumentDate" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupBookingPaymentSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Payment Plan — mirrors the web's Balance Payment Schedule select:
         Regular (max 30 days) / Flexi (max 60 days) always, plus
         Special (max 180 days) only when the selected project has
         specialPaymentEnabled. Flexi keeps mapping to freePayment. -->
    <TextView style="@style/OutcomeSectionTitle" android:text="Payment Schedule" />
    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="10dp" android:text="Payment Plan *" />
    <LinearLayout android:id="@+id/rowPayPlan" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPayPlan" style="@style/OutcomeFieldValue" android:hint="Select Plan" />
        <ImageView style="@style/OutcomeFieldChevron" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Allotment Due Amount *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayAllotDue" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Allotment Due Date *" />
    <LinearLayout android:id="@+id/rowPayAllotDate" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPayAllotDate" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="2nd Payment Amount *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPay2Mode" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="text" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="2nd Payment Date *" />
    <LinearLayout android:id="@+id/rowPay2Date" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPay2Date" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="3rd Payment Amount *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPay3Mode" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="text" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="3rd Payment Date *" />
    <LinearLayout android:id="@+id/rowPay3Date" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPay3Date" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="4th Payment Amount *" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPay4Mode" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="text" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="4th Payment Date *" />
    <LinearLayout android:id="@+id/rowPay4Date" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPay4Date" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Preferred Registration Date *" />
    <LinearLayout android:id="@+id/rowPayPrefReg" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPayPrefReg" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
