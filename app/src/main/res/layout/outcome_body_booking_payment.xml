<?xml version="1.0" encoding="utf-8"?>
<!-- Booking · Payment Details — Frames 4 + 5 in the current reference set.
     Top half: registration / GST / document / other charges + advance + mode.
     Bottom half: flexi-payment schedule (allotment + 2nd/3rd/4th installments). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bodyBookingPayment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView style="@style/OutcomeFieldLabel" android:text="Registration Charges" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayRegCharges" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Gst Amount" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayGstAmount" style="@style/OutcomeFieldEdit" android:hint="Enter Value" android:inputType="numberDecimal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPayGstApplicable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPayGstApplicable"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_checkbox_checked" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="If Applicable"
            android:textColor="#475467"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Document Charges" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayDocCharges" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Other Charges" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayOtherCharges" style="@style/OutcomeFieldEdit" android:hint="Enter Value" android:inputType="numberDecimal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPayOtherApplicable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPayOtherApplicable"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_checkbox_checked" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="If Applicable"
            android:textColor="#475467"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Advance Amount" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_doc" />
        <EditText android:id="@+id/etPayAdvanceAmount" style="@style/OutcomeFieldEdit" android:hint="Enter Details" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Payment Mode" />
    <LinearLayout android:id="@+id/rowPayPaymentMode" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_info_shield" />
        <TextView android:id="@+id/tvPayPaymentMode" style="@style/OutcomeFieldValue" android:hint="Select Mode" />
        <ImageView style="@style/OutcomeFieldChevron" />
    </LinearLayout>

    <!-- Flexi Payment (Yes radio) -->
    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="20dp" android:text="Flexi Payment" />
    <LinearLayout
        android:id="@+id/rowPayFlexi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:text="Yes"
            android:textColor="#101828"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivPayFlexi"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_radio_on" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Allotment Due Amount" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPayAllotDue" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="numberDecimal" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Allotment Due Date" />
    <LinearLayout android:id="@+id/rowPayAllotDate" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPayAllotDate" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="2nd Payment Mode" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPay2Mode" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="text" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="2nd Payment Date" />
    <LinearLayout android:id="@+id/rowPay2Date" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPay2Date" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="3rd Payment Mode" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPay3Mode" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="text" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="3rd Payment Date" />
    <LinearLayout android:id="@+id/rowPay3Date" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPay3Date" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="4th Payment Mode" />
    <LinearLayout style="@style/OutcomeFieldPill">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_briefcase" />
        <EditText android:id="@+id/etPay4Mode" style="@style/OutcomeFieldEdit" android:hint="Enter Cost" android:inputType="text" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="4th Payment Date" />
    <LinearLayout android:id="@+id/rowPay4Date" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPay4Date" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>

    <TextView style="@style/OutcomeFieldLabel" android:layout_marginTop="14dp" android:text="Preferred Registration Date" />
    <LinearLayout android:id="@+id/rowPayPrefReg" style="@style/OutcomeFieldPillClickable">
        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />
        <TextView android:id="@+id/tvPayPrefReg" style="@style/OutcomeFieldValue" android:hint="dd/mm/yyyy" />
    </LinearLayout>
</LinearLayout>
