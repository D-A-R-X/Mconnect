<?xml version="1.0" encoding="utf-8"?>
<!--
  Outcome · Postpone — a next-visit date + a single reason box. The
  visit moves to Postponed with the chosen date recorded in the notes
  and the typed reason shipped as the single postponeReasons entry
  (the backend's setOutcome requires a non-empty postponeReasons array
  for outcome="postponed"). Deliberately simpler than Not Interested,
  which is a multi-reason checklist.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/OutcomeBodyCard"
    android:id="@+id/bodyPostpone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/tvPostDateLabel"
        style="@style/OutcomeFieldLabel"
        android:text="Next visit date" />

    <TextView
        android:id="@+id/tvPostDateHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:includeFontPadding="false"
        android:text="When should this visit be rescheduled to."
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/rowPostNextDate"
        style="@style/OutcomeFieldPillClickable"
        android:layout_marginTop="10dp">

        <ImageView style="@style/OutcomeFieldIcon" android:src="@drawable/ic_outcome_calendar" />

        <TextView
            android:id="@+id/tvPostNextDate"
            style="@style/OutcomeFieldValue"
            android:hint="dd/mm/yyyy" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_chevron_right" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPostReasonHelp"
        style="@style/OutcomeFieldLabel"
        android:layout_marginTop="16dp"
        android:text="Reason" />

    <TextView
        android:id="@+id/tvPostReasonSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:includeFontPadding="false"
        android:text="Why is the visit being postponed."
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_outcome_field_pill"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_outcome_doc" />

        <EditText
            android:id="@+id/etPostNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/inter_medium"
            android:gravity="top"
            android:hint="Reason for postponement"
            android:includeFontPadding="false"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:textColor="#101828"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
