<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom dropdown shown when the scope chip is tapped. Replaces the
  default Material PopupMenu (which was a styling mismatch with the
  rest of the leave UI) with a rounded white card per the design.

  Each row is a centered label. The "Team Leaves" row carries a small
  red badge that lights up when the team queue has pending items —
  same dot-style as the chip itself, so the two stay consistent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_scope_popup"
    android:minWidth="180dp"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/menuMyLeaves"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="My Leaves"
        android:textColor="#344054"
        android:textSize="15sp" />

    <FrameLayout
        android:id="@+id/menuTeamLeaves"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMenuTeamLeaves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="Team Leaves"
                android:textColor="#344054"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dotTeamBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_red_dot"
                android:gravity="center"
                android:fontFamily="@font/inter_bold"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/menuAllLeaves"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="All Leaves"
        android:textColor="#344054"
        android:textSize="15sp" />
</LinearLayout>
