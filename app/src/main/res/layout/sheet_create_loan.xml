<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_leave_sheet"
    android:orientation="vertical">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="52dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="#D9D9D9"
        android:backgroundTint="#D9D9D9" />

    <!-- Title and description header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Request Loan"
            android:textColor="#101828"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_regular"
            android:text="Information about Loans"
            android:textColor="#667085"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Nominee 1 Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Nominee 1 *"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btnSelectNominee1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cp_staff"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvNominee1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="Select Nominee"
                    android:textColor="#98A2B3"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#667085"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Nominee 2 Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Nominee 2 *"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btnSelectNominee2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cp_staff"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvNominee2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="Select Nominee"
                    android:textColor="#98A2B3"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#667085"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Nominee Approval Warning Message -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/inter_regular"
                android:text="Both Nominee must approve with a digital signature before the request moves to GM→AVP→HR→Accountant."
                android:textColor="#B1B1B1"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.2" />

            <!-- Loan Amount Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Loan Amount *"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_vuesax_linear_coin"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etLoanAmount"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Enter Amount"
                    android:textColorHint="#98A2B3"
                    android:inputType="numberDecimal"
                    android:textColor="#101828"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Interest Type Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Interest Type"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btnSelectInterestType"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_loan_document"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvInterestType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="Select Type"
                    android:textColor="#98A2B3"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#667085"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Disbursed Date Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Disbursed Date *"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btnSelectDisbursedDate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cp_datetime"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvDisbursedDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="Select Date"
                    android:textColor="#98A2B3"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#667085"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Repayment Start Month Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Repayment Start Month *"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btnSelectRepaymentStartMonth"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cp_datetime"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvRepaymentStartMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="Select Month"
                    android:textColor="#98A2B3"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#667085"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Tenure (Months) Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Tenure (Months) *"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_loan_clock"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etTenure"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Maximum 6"
                    android:textColorHint="#98A2B3"
                    android:inputType="number"
                    android:textColor="#101828"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Original Document To be Submit Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Original Document To be Submit *"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btnSelectOriginalDocument"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_loan_document"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvOriginalDocument"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="Select the document"
                    android:textColor="#98A2B3"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#667085"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Purpose Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Purpose"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_loan_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_loan_document"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etLoanPurpose"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Enter Details"
                    android:textColorHint="#98A2B3"
                    android:inputType="text"
                    android:textColor="#101828"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Notes Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_medium"
                android:text="Notes"
                android:textColor="#344054"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="@drawable/bg_loan_input_box"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cp_notes"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etLoanNotes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Enter Notes"
                    android:textColorHint="#98A2B3"
                    android:inputType="textMultiLine"
                    android:textColor="#101828"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top border and bottom button -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D5DD" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/btnSubmitLoan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_leave_submit_button"
            android:clickable="true"
            android:focusable="true"
            android:enabled="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Submit Now"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
