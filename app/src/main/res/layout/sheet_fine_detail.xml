<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_apply_leave"
    android:maxHeight="640dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_chat_sheet_handle" />

        <TextView
            android:id="@+id/tvFineDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Staff"
            android:textColor="#101828"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvFineDetailMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="#667085"
            android:textSize="13sp" />

        <!-- Fine picture (hidden when there's none) -->
        <ImageView
            android:id="@+id/ivFineDetailPhoto"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_apply_leave_field"
            android:contentDescription="Fine picture"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFineDetailNoPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_apply_leave_field"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:paddingVertical="28dp"
            android:text="No picture attached"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Reason"
            android:textColor="#344054"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFineDetailReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_regular"
            android:text="No reason provided"
            android:textColor="#475467"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
