<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:splitMotionEvents="false">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_chat_sheet_handle" />

    <!-- Title Group (Pinned to top) -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="On Duty Details"
        android:textColor="#101828"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvSheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/inter_medium"
        android:text="Select a category to start on duty flow"
        android:textColor="#667085"
        android:textSize="13sp" />

    <!-- Scrollable content wrapper to support half-screen/full-screen behavior -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:splitMotionEvents="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:splitMotionEvents="false">

            <!-- Step 1 Layout Scroll Content -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:splitMotionEvents="false">

                <!-- Category cards selection container -->
                <LinearLayout
                    android:id="@+id/layoutCategoryCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:splitMotionEvents="false">

                    <LinearLayout
                        android:id="@+id/cardProjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_task_building"
                            app:tint="#0B61CA" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:text="Projects"
                                android:textColor="#101828"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:text="Duty on developer/construction projects"
                                android:textColor="#667085"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardVendors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_profile_office"
                            app:tint="#0B61CA" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:text="Vendors"
                                android:textColor="#101828"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:text="Duty on third-party vendor sites"
                                android:textColor="#667085"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardOthers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_tab_note_pencil"
                            app:tint="#0B61CA" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:text="Others (Remarks)"
                                android:textColor="#101828"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:text="Duty for general meetings or custom tasks"
                                android:textColor="#667085"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Searchable List Picker (Projects/Vendors) -->
                <LinearLayout
                    android:id="@+id/layoutSearchContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etSearchQuery"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_on_duty_search"
                        android:drawableEnd="@drawable/ic_chat_search"
                        android:drawablePadding="10dp"
                        android:drawableTint="#667085"
                        android:hint="Search Projects"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="#101828"
                        android:textColorHint="#98A2B3"
                        android:textSize="14sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPickerList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:overScrollMode="never"
                        tools:listitem="@layout/item_on_duty_list_row" />
                </LinearLayout>

                <!-- Remarks Input -->
                <LinearLayout
                    android:id="@+id/layoutRemarksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etOnDutyRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input"
                        android:gravity="top|start"
                        android:hint="Enter remarks details..."
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="#101828"
                        android:textColorHint="#98A2B3"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 2 Layout Scroll Content -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:splitMotionEvents="false">

                <!-- Heading 1: Own Vehicle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Own Vehicle"
                    android:textColor="#344054"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal"
                    android:splitMotionEvents="false">

                    <!-- Own Vehicle - Two Wheeler Card -->
                    <FrameLayout
                        android:id="@+id/cardOwnTwoWheeler"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOwnTwoWheeler"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Two Wheeler"
                            android:textColor="#101828"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <!-- Own Vehicle - Four Wheeler Card -->
                    <FrameLayout
                        android:id="@+id/cardOwnFourWheeler"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOwnFourWheeler"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Four Wheeler"
                            android:textColor="#101828"
                            android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Heading 2: Office Vehicle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Office Vehicle"
                    android:textColor="#344054"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal"
                    android:splitMotionEvents="false">

                    <!-- Office Vehicle - Two Wheeler Card -->
                    <FrameLayout
                        android:id="@+id/cardOfficeTwoWheeler"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOfficeTwoWheeler"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Two Wheeler"
                            android:textColor="#101828"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <!-- Office Vehicle - Four Wheeler Card -->
                    <FrameLayout
                        android:id="@+id/cardOfficeFourWheeler"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOfficeFourWheeler"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Four Wheeler"
                            android:textColor="#101828"
                            android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Heading 3: Public Vehicle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Public Vehicle"
                    android:textColor="#344054"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal"
                    android:splitMotionEvents="false">

                    <!-- Public Vehicle - Public Transport Card -->
                    <FrameLayout
                        android:id="@+id/cardOfficePublicTransport"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_on_duty_card_normal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOfficePublicTransport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Public Transport"
                            android:textColor="#101828"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <!-- Invisible placeholder card to keep it half width (symmetrical) -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Pinned Bottom Buttons container (stays stuck to bottom) -->
    <FrameLayout
        android:id="@+id/layoutBottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOnDutyNext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_on_duty_btn_disabled"
            android:enabled="false"
            android:fontFamily="@font/inter_semibold"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOnDutySubmit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_on_duty_btn_disabled"
            android:enabled="false"
            android:fontFamily="@font/inter_semibold"
            android:text="Start Now"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
