<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading skeleton shaped like item_team_approval_card / item_attendance_history_card:
  date row + avatar/name, a metrics inner box, and a two-button footer. Every grey
  block is a leaf View so SkeletonUtils pulses it; the white card + inner box stay put.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_attendance_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Top row: calendar + date, avatar + name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_rounded" />

        <View
            android:layout_width="110dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_skeleton_rounded" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_circle" />

        <View
            android:layout_width="64dp"
            android:layout_height="11dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_skeleton_rounded" />
    </LinearLayout>

    <!-- Metrics inner box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_attendance_history_inner"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <View
                android:layout_width="64dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <View
                android:layout_width="88dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_rounded" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <View
                android:layout_width="72dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <View
                android:layout_width="128dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_rounded" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_skeleton_rounded" />

        <View
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_skeleton_rounded" />
    </LinearLayout>
</LinearLayout>
