<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder card shaped like item_my_trip_card, shown while the
     My Trips list loads so the screen reads as "loading" instead of
     "empty". Blocks use bg_skeleton_rounded and pulse via
     SkeletonUtils.startSkeletonPulse on the parent container. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_trip_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Header: avatar + two name lines + status pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_skeleton_rounded" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="150dp"
                android:layout_height="13dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <View
                android:layout_width="110dp"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeleton_rounded" />
        </LinearLayout>

        <View
            android:layout_width="72dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_rounded" />
    </LinearLayout>

    <!-- 2x2 detail grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_skeleton_rounded" />

        <View
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_skeleton_rounded" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_skeleton_rounded" />

        <View
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_skeleton_rounded" />
    </LinearLayout>

    <!-- Action button bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_skeleton_rounded" />
</LinearLayout>
