<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivEmptyImage"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="Empty state image"
        android:scaleType="fitCenter"
        tools:src="@drawable/leave_banner_suitcase" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="?attr/colorForegroundPrimary"
        android:textSize="20sp"
        tools:text="No Leave Submitted!" />

    <TextView
        android:id="@+id/tvEmptyDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:textColor="?attr/colorForegroundMuted"
        android:textSize="13sp"
        tools:text="Ready to catch some fresh air? Click “Submit Leave” and take that well-deserved break!" />
</merge>
