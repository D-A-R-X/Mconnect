<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accent -->
    <attr name="colorAccentPrimary" format="color" />
    <attr name="colorAccentPrimaryHover" format="color" />
    <attr name="colorAccentSecondary" format="color" />

    <!-- Surface -->
    <attr name="colorSurfacePrimary" format="color" />
    <attr name="colorSurfaceSecondary" format="color" />
    <attr name="colorSurfaceTertiary" format="color" />
    <attr name="colorSurfaceInverse" format="color" />

    <!-- Foreground -->
    <attr name="colorForegroundPrimary" format="color" />
    <attr name="colorForegroundSecondary" format="color" />
    <attr name="colorForegroundMuted" format="color" />
    <attr name="colorForegroundInverse" format="color" />

    <!-- Border -->
    <attr name="colorBorder" format="color" />
    <attr name="colorBorderLight" format="color" />

    <!-- Status -->
    <attr name="colorError" format="color" />
    <attr name="colorSuccess" format="color" />
    <attr name="colorWarning" format="color" />
    <attr name="colorInfo" format="color" />

    <!-- Light tints -->
    <attr name="colorAccentLight" format="color" />
    <attr name="colorSuccessLight" format="color" />
    <attr name="colorWarningLight" format="color" />
    <attr name="colorErrorLight" format="color" />
    <attr name="colorInfoLight" format="color" />

    <declare-styleable name="SegmentedControlView">
        <attr name="scv_active_background" format="reference" />
        <attr name="scv_text_color_selected" format="color" />
        <attr name="scv_text_color_unselected" format="color" />
        <attr name="scv_text_size" format="dimension" />
        <attr name="scv_font_family" format="reference" />
    </declare-styleable>

    <declare-styleable name="EmptyStateView">
        <attr name="es_image" format="reference" />
        <attr name="es_title" format="string" />
        <attr name="es_description" format="string" />
    </declare-styleable>

    <declare-styleable name="SummaryHeaderView">
        <attr name="sh_title" format="string" />
        <attr name="sh_subtitle" format="string" />
        <attr name="sh_banner_image" format="reference" />
    </declare-styleable>

    <declare-styleable name="HomeHeaderView">
        <attr name="hh_show_profile_row" format="boolean" />
        <attr name="hh_show_banner_card" format="boolean" />
        <attr name="hh_banner_title" format="string" />
        <attr name="hh_banner_subtitle" format="string" />
        <attr name="hh_banner_button_text" format="string" />
        <attr name="hh_banner_card_background" format="reference" />
        <attr name="hh_banner_illustration" format="reference" />
    </declare-styleable>

    <declare-styleable name="BookingUploadFieldView">
        <attr name="buf_label" format="string" />
        <attr name="buf_hint" format="string" />
        <attr name="buf_required" format="boolean" />
    </declare-styleable>
</resources>
