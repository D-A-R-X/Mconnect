<?xml version="1.0" encoding="utf-8"?>
<!--
  Mconnect button components. Use these instead of per-screen drawables /
  hex tints so every button looks the same (height, corner, font, colours)
  and follows light/dark mode:

    style="@style/Widget.Mconnect.Button"            primary action (accent)
    style="@style/Widget.Mconnect.Button.Secondary"  cancel / secondary (outline)
    style="@style/Widget.Mconnect.Button.Success"    approve / confirm positive
    style="@style/Widget.Mconnect.Button.Danger"     reject / destructive

  Height is @dimen/button_height via android:minHeight; set the layout height to
  wrap_content (or @dimen/button_height).
-->
<resources>

    <style name="Widget.Mconnect.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">?attr/colorAccentPrimary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.Mconnect.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">?attr/colorBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="rippleColor">?attr/colorBorderLight</item>
    </style>

    <style name="Widget.Mconnect.Button.Success">
        <item name="backgroundTint">?attr/colorSuccess</item>
    </style>

    <style name="Widget.Mconnect.Button.Danger">
        <item name="backgroundTint">?attr/colorError</item>
    </style>

</resources>
