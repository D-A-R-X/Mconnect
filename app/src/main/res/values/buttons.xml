<?xml version="1.0" encoding="utf-8"?>
<!--
  Mconnect button components. Use these instead of per-screen drawables /
  hex tints so every button looks the same (height, corner, font, colours)
  and follows light/dark mode:

    style="@style/Widget.Mconnect.Button"            primary action (accent)
    style="@style/Widget.Mconnect.Button.Secondary"  cancel / secondary (outline)
    style="@style/Widget.Mconnect.Button.Success"    approve / confirm positive
    style="@style/Widget.Mconnect.Button.Danger"     reject / destructive
    style="@style/Widget.Mconnect.Button.Danger.Outline"  reject beside a positive action

  Views that can't take a style (a LinearLayout / FrameLayout / TextView used
  as a button, or a background swapped in code) use the matching drawables:
  bg_button_primary, bg_mc_button_secondary, bg_mc_button_success,
  bg_mc_button_danger, bg_mc_button_danger_outline, bg_mc_button_disabled.

  Height is @dimen/button_height via android:minHeight; set the layout height to
  wrap_content (or @dimen/button_height).

  MMS-289 sizes by placement (append to any variant above):
    (none)    52dp, 16sp, 20dp icon - screen / sheet footer CTA, full width
    .Medium   48dp, 14sp, 18dp icon - action inside a card ("Call Client")
    .Compact  36dp, 13sp, 16dp icon - list-row / inline action, wraps
  e.g. style="@style/Widget.Mconnect.Button.Success.Medium".
  Leading icon: app:icon="@drawable/ic_..." (gravity, size, gap and tint come
  from the style). Disabled: just set isEnabled = false - every variant turns
  muted grey with secondary text; never swap drawables in code for it.
-->
<resources>

    <style name="Widget.Mconnect.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/mc_button_primary_bg</item>
        <item name="android:textColor">@color/mc_button_on_filled</item>
        <item name="iconTint">@color/mc_button_on_filled</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">@dimen/button_icon_size</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.Mconnect.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">?attr/colorBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/mc_button_on_outline</item>
        <item name="iconTint">@color/mc_button_on_outline</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">@dimen/button_icon_size</item>
        <item name="rippleColor">?attr/colorBorderLight</item>
    </style>

    <style name="Widget.Mconnect.Button.Success">
        <item name="backgroundTint">@color/mc_button_success_bg</item>
    </style>

    <style name="Widget.Mconnect.Button.Danger">
        <item name="backgroundTint">@color/mc_button_danger_bg</item>
    </style>

    <!-- Reject / remove next to a positive action: red outline, red text. -->
    <style name="Widget.Mconnect.Button.Danger.Outline" parent="Widget.Mconnect.Button.Secondary">
        <item name="strokeColor">@color/mc_button_on_danger_outline</item>
        <item name="android:textColor">@color/mc_button_on_danger_outline</item>
        <item name="iconTint">@color/mc_button_on_danger_outline</item>
        <item name="rippleColor">?attr/colorErrorLight</item>
    </style>

    <!-- MMS-289 Medium size for each variant. -->
    <style name="Widget.Mconnect.Button.Medium">
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Medium</item>
        <item name="iconSize">@dimen/button_icon_size_medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Secondary.Medium">
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Medium</item>
        <item name="iconSize">@dimen/button_icon_size_medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Success.Medium">
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Medium</item>
        <item name="iconSize">@dimen/button_icon_size_medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Danger.Medium">
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Medium</item>
        <item name="iconSize">@dimen/button_icon_size_medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Danger.Outline.Medium">
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Medium</item>
        <item name="iconSize">@dimen/button_icon_size_medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- MMS-289 Compact size for each variant. -->
    <style name="Widget.Mconnect.Button.Compact">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Compact</item>
        <item name="iconSize">@dimen/button_icon_size_compact</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconPadding">6dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Secondary.Compact">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Compact</item>
        <item name="iconSize">@dimen/button_icon_size_compact</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconPadding">6dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Success.Compact">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Compact</item>
        <item name="iconSize">@dimen/button_icon_size_compact</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconPadding">6dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Danger.Compact">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Compact</item>
        <item name="iconSize">@dimen/button_icon_size_compact</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconPadding">6dp</item>
    </style>
    <style name="Widget.Mconnect.Button.Danger.Outline.Compact">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Compact</item>
        <item name="iconSize">@dimen/button_icon_size_compact</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="iconPadding">6dp</item>
    </style>


    <!-- MMS-289: the screen's main "do it" action (Apply / Submit / Create / Next).
         ONE-LINE CHOICE (user decision A): parent = Widget.Mconnect.Button.Success
         (flat green) or Widget.Mconnect.Button (brand blue). Keep drawable
         bg_mc_button_cta pointing the same way for views that can't take a style. -->
    <style name="Widget.Mconnect.Button.Cta" parent="Widget.Mconnect.Button" />
    <style name="Widget.Mconnect.Button.Cta.Medium">
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Medium</item>
        <item name="iconSize">@dimen/button_icon_size_medium</item>
    </style>
    <style name="Widget.Mconnect.Button.Cta.Compact">
        <item name="android:minHeight">@dimen/button_height_compact</item>
        <item name="android:textAppearance">@style/TextAppearance.Mconnect.Button.Compact</item>
        <item name="iconSize">@dimen/button_icon_size_compact</item>
        <item name="iconPadding">6dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
