<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Task Manager info-card (My Tasks / Team / Assigned / Extensions / Overdue) -->
    <style name="TaskStatCard">
        <item name="android:layout_width">124dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_apps_card</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="TaskStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundSecondary</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="TaskStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:text">0</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!--
      Inspection-form helpers: a small "field label" caption and the
      plain (no-icon, no-trailing) version of the field-pill. Keep the
      competitor entry layout from drowning in attribute boilerplate.
    -->
    <style name="InspectionFieldLabel" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="InspectionFieldPlainInput" parent="@android:style/Widget.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_inspection_field</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textColorHint">#9CA3AF</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OtpBox">
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/geist_mono_semibold</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="EditFormSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="OtpBoxAuth">
        <item name="android:background">@drawable/bg_auth_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="BookingFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BookingFieldRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_outcome_field_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BookingFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_outcome_field_pill</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textColorHint">?attr/colorForegroundMuted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BookingSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- White rounded card that visually groups one section's fields
         (Booking Information, Source / Referral, KYC, …). -->
    <style name="BookingSectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_booking_card</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Card wrapper for one outcome-sheet body/section (Client Details,
         Booking, Charges, Payment, Staff, KYC…) so each is a distinct
         white container on the grey sheet backdrop. -->
    <style name="OutcomeBodyCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_booking_card</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- No window enter/exit animation for the CP outcome sheet. The default
         BottomSheetDialog slide-up snapshots the window surface (white page)
         and slides it in — which flashes for a frame behind the centre picker
         before the sheet is hidden. Killing the window animation lets us hide
         the container and fade the form in ourselves, glitch-free. -->
    <style name="SheetNoWindowAnim">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <!-- Centre zoom-in/out window animation for the outcome picker dialog, so
         it pops from the middle instead of the default left/right slide. -->
    <style name="DialogZoomAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_zoom_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_zoom_out</item>
    </style>

    <!-- Section title shown at the top of a BookingSectionCard. -->
    <style name="BookingCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="BookingSubHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorForegroundMuted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="BookingComputed">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_outcome_field_pill</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorAccentPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CalendarDayLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#667085</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="ChatMessageActionsDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="CustomCameraBottomSheetTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomCameraBottomSheetStyle</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="CustomCameraBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- DialogFragment styled as bottom sheet for employee picker -->
    <style name="FullWidthBottomDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="ProfilePhotoCropDialogTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurfaceInverse</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">?attr/colorSurfaceInverse</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceInverse</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="BottomDialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@android:anim/slide_out_right</item>
    </style>

    <!-- ── Daily Log form field styles ── -->
    <style name="DailyLogLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">#667085</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DailyLogSelectField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_search_bar</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DailyLogSelectText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="DailyLogSelectChevron">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:src">@drawable/ic_apps_chevron</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:tint">#667085</item>
    </style>

    <style name="DailyLogInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textColorHint">#98A2B3</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="DailyLogMultiline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">100dp</item>
        <item name="android:gravity">top</item>
        <item name="android:padding">12dp</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textColorHint">#98A2B3</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DailyLogSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="DailyLogSectionTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DailyLogAddChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">#16A34A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:padding">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TravelDeskRateLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TravelDeskRateInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:drawableStart">@drawable/ic_custom_rate</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textColorHint">?attr/colorForegroundMuted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SiteVisitQrDetailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundSecondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SiteVisitQrDetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>

