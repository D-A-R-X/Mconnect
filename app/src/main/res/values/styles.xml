<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Inspection-form helpers: a small "field label" caption and the
      plain (no-icon, no-trailing) version of the field-pill. Keep the
      competitor entry layout from drowning in attribute boilerplate.
    -->
    <style name="InspectionFieldLabel" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="InspectionFieldPlainInput" parent="@android:style/Widget.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_inspection_field</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textColorHint">#9CA3AF</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OtpBox">
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/geist_mono_semibold</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="EditFormSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="OtpBoxAuth">
        <item name="android:background">@drawable/bg_auth_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="BookingFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BookingFieldRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_attendance_history_inner</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BookingFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_attendance_history_inner</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textColorHint">?attr/colorForegroundMuted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CalendarDayLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#667085</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="ChatMessageActionsDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
