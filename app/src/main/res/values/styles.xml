<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OtpBox">
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/geist_mono_semibold</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="EditFormSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="OtpBoxAuth">
        <item name="android:background">@drawable/bg_auth_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">#161B23</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="BookingFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BookingFieldRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_attendance_history_inner</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BookingFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_attendance_history_inner</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textColorHint">?attr/colorForegroundMuted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
