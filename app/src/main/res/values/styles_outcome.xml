<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared layout styles for the Outcome Information sheet form rows.
  Keeping them here makes the per-body XMLs readable; each row is just
  label + pill-with-icon + (optional chevron). All bodies share the same
  visual cadence (14dp top margin between rows, 48dp pill height, 14dp
  inner padding, #94A3B8 hint, #101828 value).
-->
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="OutcomeFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#475467</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Prominent section heading inside an outcome-sheet card (Financial
         Details, Charges & Advance, Customer Funding, KYC…). Bold, uppercase,
         dark foreground text so section names mirror the web form hierarchy. -->
    <style name="OutcomeSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?attr/colorForegroundPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="OutcomeFieldPill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_outcome_field_pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <style name="OutcomeFieldPillClickable" parent="OutcomeFieldPill">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="OutcomeFieldIcon">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="OutcomeFieldEdit">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#101828</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="OutcomeFieldValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:text" />
        <item name="android:textColor">#101828</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="OutcomeFieldChevron">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:src">@drawable/ic_outcome_chevron_down</item>
    </style>
</resources>
