<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Headings -->
    <style name="TextAppearance.Mconnect.HeadingLg" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body -->
    <style name="TextAppearance.Mconnect.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Mconnect.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Labels -->
    <style name="TextAppearance.Mconnect.Label" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Mconnect.LabelSmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Button -->
    <style name="TextAppearance.Mconnect.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Brand -->
    <style name="TextAppearance.Mconnect.BrandLabel" parent="TextAppearance.MaterialComponents.Overline">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <!-- Input text -->
    <style name="TextAppearance.Mconnect.Input" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Mconnect.InputPrefix" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- OTP -->
    <style name="TextAppearance.Mconnect.OtpDigit" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/geist_mono_semibold</item>
        <item name="android:fontFamily">@font/geist_mono_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Mconnect.Timer" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/geist_mono_regular</item>
        <item name="android:fontFamily">@font/geist_mono_regular</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
