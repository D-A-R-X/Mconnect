<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+.
   Everything is included except the first-launch flag: restoring it into a
   fresh install skipped the intro video and onboarding after a reinstall.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mconnect_onboarding.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mconnect_onboarding.xml" />
    </device-transfer>
</data-extraction-rules>
